  "from": 240.2,
  "to": 241.64,
  "sid": 112,
  "location": 2,
  "content": "以确保万无一失",
  "music": 0.0
 },
 {
  "from": 241.64,
  "to": 244.19,
  "sid": 113,
  "location": 2,
  "content": "接下来基于不确定性规避",
  "music": 0.0
 },
 {
  "from": 244.19,
  "to": 246.56,
  "sid": 114,
  "location": 2,
  "content": "个体又会有下面的典型表现",
  "music": 0.0
 },
 {
  "from": 246.56,
  "to": 250.2,
  "sid": 115,
  "location": 2,
  "content": "一回避带有不确定性的或者心意的情境",
  "music": 0.0
 },
 {
  "from": 250.2,
  "to": 253.71,
  "sid": 116,
  "location": 2,
  "content": "比如他们可能会拒绝参与自己不熟悉的活动",
  "music": 0.0
 },
 {
  "from": 253.71,
  "to": 254.76,
  "sid": 117,
  "location": 2,
  "content": "二拖延",
  "music": 0.0
 },
 {
  "from": 254.76,
  "to": 256.2,
  "sid": 118,
  "location": 2,
  "content": "比如面对一个任务",
  "music": 0.0
 },
 {
  "from": 256.2,
  "to": 257.52,
  "sid": 119,
  "location": 2,
  "content": "除非他们计划好了",
  "music": 0.0
 },
 {
  "from": 257.52,
  "to": 258.88,
  "sid": 120,
  "location": 2,
  "content": "完成每一步的方法",
  "music": 0.0
 },
 {
  "from": 258.88,
  "to": 260.89,
  "sid": 121,
  "location": 2,
  "content": "否则就会一直拖延进度",
  "music": 0.0
 },
 {
  "from": 260.89,
  "to": 263.8,
  "sid": 122,
  "location": 2,
  "content": "三避免对事情做出明确的承诺",
  "music": 0.0
 },
 {
  "from": 263.8,
  "to": 267.6,
  "sid": 123,
  "location": 2,
  "content": "比如对社交活动不做出参加与否的明确答复",
  "music": 0.0
 },
 {
  "from": 267.6,
  "to": 268.98,
  "sid": 124,
  "location": 2,
  "content": "或者只答应要去",
  "music": 0.0
 },
 {
  "from": 268.98,
  "to": 271.68,
  "sid": 125,
  "location": 2,
  "content": "但不约定具体的时间或者地点",
  "music": 0.0
 },
 {
  "from": 271.68,
  "to": 274.52,
  "sid": 126,
  "location": 2,
  "content": "下面就是对于上述问题的改善方法",
  "music": 0.0
 },
 {
  "from": 274.52,
  "to": 277.2,
  "sid": 127,
  "location": 2,
  "content": "这部分涉及认知和行为两个层面",
  "music": 0.0
 },
 {
  "from": 277.2,
  "to": 280.59,
  "sid": 128,
  "location": 2,
  "content": "他们有些是基于临床干预方法的生活化版本",
  "music": 0.0
 },
 {
  "from": 280.59,
  "to": 283.96,
  "sid": 129,
  "location": 2,
  "content": "有些则以实验室研究得出的结论为基础",
  "music": 0.0
 },
 {
  "from": 283.96,
  "to": 287.44,
  "sid": 130,
  "location": 2,
  "content": "我自己平时最常用的是行为层面的第一个方法",
  "music": 0.0
 },
 {
  "from": 287.44,
  "to": 289.78,
  "sid": 131,
  "location": 2,
  "content": "外加认知层面中的第三个方法",
  "music": 0.0
 },
 {
  "from": 289.78,
  "to": 292.39,
  "sid": 132,
  "location": 2,
  "content": "但视频中提到的都是很不错的方法",
  "music": 0.0
 },
 {
  "from": 292.39,
  "to": 295.42,
  "sid": 133,
  "location": 2,
  "content": "你们从中选择适合自身情况的就好啦",
  "music": 0.0
 },
 {
  "from": 295.42,
  "to": 297.67,
  "sid": 134,
  "location": 2,
  "content": "首先是认知层面的方法",
  "music": 0.0
 },
 {
  "from": 297.67,
  "to": 301.46,
  "sid": 135,
  "location": 2,
  "content": "这部分主要是训练我们对于想法的觉察和重塑",
  "music": 0.0
 },
 {
  "from": 301.46,
  "to": 303.11,
  "sid": 136,
  "location": 2,
  "content": "摒弃不合理的信念",
  "music": 0.0
 },
 {
  "from": 303.11,
  "to": 306.04,
  "sid": 137,
  "location": 2,
  "content": "建立以解决问题为导向的思维方式",
  "music": 0.0
 },
 {
  "from": 306.04,
  "to": 307.96,
  "sid": 138,
  "location": 2,
  "content": "第一个方法是具体化",
  "music": 0.0
 },
 {
  "from": 307.96,
  "to": 309.64,
  "sid": 139,
  "location": 2,
  "content": "这里你需要主动觉察",
  "music": 0.0
 },
 {
  "from": 309.64,
  "to": 312.92,
  "sid": 140,
  "location": 2,
  "content": "脑海里出现的令自己焦虑的自动化思维",
  "music": 0.0
 },
 {
  "from": 312.92,
  "to": 315.29,
  "sid": 141,
  "location": 2,
  "content": "并将这些自动化思维写下来",
  "music": 0.0
 },
 {
  "from": 315.29,
  "to": 318.08,
  "sid": 142,
  "location": 2,
  "content": "这些自动化思维通常是这样的句式",
  "music": 0.0
 },
 {
  "from": 318.08,
  "to": 319.82,
  "sid": 143,
  "location": 2,
  "content": "如果什么什么怎么办",
  "music": 0.0
 },
 {
  "from": 319.82,
  "to": 321.98,
  "sid": 144,
  "location": 2,
  "content": "或者万一什么什么怎么办",
  "music": 0.0
 },
 {
  "from": 321.98,
  "to": 323.39,
  "sid": 145,
  "location": 2,
  "content": "具体分为三步",
  "music": 0.0
 },
 {
  "from": 323.39,
  "to": 325.73,
  "sid": 146,
  "location": 2,
  "content": "第一步是记录他们的具体内容",
  "music": 0.0
 },
 {
  "from": 325.73,
  "to": 327.26,
  "sid": 147,
  "location": 2,
  "content": "第二步在下面写上",
  "music": 0.0
 },
 {
  "from": 327.26,
  "to": 328.4,
  "sid": 148,
  "location": 2,
  "content": "针对这件事情",
  "music": 0.0
 },
 {
  "from": 328.4,
  "to": 330.78,
  "sid": 149,
  "location": 2,
  "content": "自己最担心发生的情况是什么",
  "music": 0.0
 },
 {
  "from": 330.78,
  "to": 331.92,
  "sid": 150,
  "location": 2,
  "content": "最后在思考",
  "music": 0.0
 },
 {
  "from": 331.92,
  "to": 334.74,
  "sid": 151,
  "location": 2,
  "content": "自己为什么害怕最坏的那种情况发生",
  "music": 0.0
 },
 {
  "from": 334.74,
  "to": 336.7,
  "sid": 152,
  "location": 2,
  "content": "也就是说发生了会怎么样",
  "music": 0.0
 },
 {
  "from": 336.7,
  "to": 338.62,
  "sid": 153,
  "location": 2,
  "content": "自己害怕的究竟是什么",
  "music": 0.0
 },
 {
  "from": 338.62,
  "to": 340.24,
  "sid": 154,
  "location": 2,
  "content": "这个方法可以帮助我们",
  "music": 0.0
 },
 {
  "from": 340.24,
  "to": 343.68,
  "sid": 155,
  "location": 2,
  "content": "把自己担忧的内容和原因非常呈现出来",
  "music": 0.0
 },
 {
  "from": 343.68,
  "to": 346.02,
  "sid": 156,
  "location": 2,
  "content": "这样做的目的是让我们真正理解",
  "music": 0.0
 },
 {
  "from": 346.02,
  "to": 348.12,
  "sid": 157,
  "location": 2,
  "content": "令自己担忧的侵入性思维",
  "music": 0.0
 },
 {
  "from": 348.12,
  "to": 350.04,
  "sid": 158,
  "location": 2,
  "content": "而不是在无意识的情况下",
  "music": 0.0
 },
 {
  "from": 350.04,
  "to": 352.47,
  "sid": 159,
  "location": 2,
  "content": "被不知所起的情绪所桎梏",
  "music": 0.0
 },
 {
  "from": 352.47,
  "to": 355.7,
  "sid": 160,
  "location": 2,
  "content": "而且通常在践行完上面的三步以后",
  "music": 0.0
 },
 {
  "from": 355.7,
  "to": 358.64,
  "sid": 161,
  "location": 2,
  "content": "很多人此时就已经能够比较理性地认识到",
  "music": 0.0
 },
 {
  "from": 358.64,
  "to": 360.74,
  "sid": 162,
  "location": 2,
  "content": "担忧的不合理和非必要了",
  "music": 0.0
 },
 {
  "from": 360.74,
  "to": 363.9,
  "sid": 163,
  "location": 2,
  "content": "因为焦虑的根本原因在于模糊和未知",
  "music": 0.0
 },
 {
  "from": 363.9,
  "to": 366.12,
  "sid": 164,
  "location": 2,
  "content": "所以把它清晰化的过程本身",
  "music": 0.0
 },
 {
  "from": 366.12,
  "to": 368.44,
  "sid": 165,
  "location": 2,
  "content": "可以在一定程度上化解焦虑",
  "music": 0.0
 },
 {
  "from": 368.44,
  "to": 371.08,
  "sid": 166,
  "location": 2,
  "content": "第二个方法是停止无效担忧",
