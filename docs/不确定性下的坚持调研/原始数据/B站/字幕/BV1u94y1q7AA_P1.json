 },
 {
  "from": 117.37,
  "to": 118.84,
  "sid": 58,
  "location": 2,
  "content": "信息信念",
  "music": 0.0
 },
 {
  "from": 118.84,
  "to": 120.32,
  "sid": 59,
  "location": 2,
  "content": "非适应性行为",
  "music": 0.0
 },
 {
  "from": 120.32,
  "to": 122.3,
  "sid": 60,
  "location": 2,
  "content": "低不确定性容忍度的个体",
