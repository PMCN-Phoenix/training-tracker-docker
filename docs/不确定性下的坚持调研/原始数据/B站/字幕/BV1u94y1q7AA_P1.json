 },
 {
  "from": 94.3,
  "to": 95.11,
  "sid": 48,
  "location": 2,
  "content": "这个概念",
  "music": 0.0
 },
 {
  "from": 95.11,
  "to": 96.92,
  "sid": 49,
  "location": 2,
  "content": "通常简称为IU",
  "music": 0.0
 },
 {
  "from": 96.92,
  "to": 98.42,
  "sid": 50,
  "location": 2,
  "content": "对于普通人来说",
  "music": 0.0
 },
 {
  "from": 98.42,
  "to": 101.15,
  "sid": 51,
  "location": 2,
  "content": "不确定性意味着中性可好可坏",
  "music": 0.0
 },
 {
  "from": 101.15,
  "to": 103.16,
  "sid": 52,
  "location": 2,
  "content": "但不确定性容忍度低的人",
  "music": 0.0
 },
 {
  "from": 103.16,
  "to": 106.5,
  "sid": 53,
  "location": 2,
  "content": "认为不确定性等于坏事将会发生",
  "music": 0.0
 },
 {
  "from": 106.5,
  "to": 109.92,
  "sid": 54,
  "location": 2,
  "content": "为了帮助大家更好地理解低不确定性容忍度",
  "music": 0.0
 },
 {
  "from": 109.92,
  "to": 111.76,
  "sid": 55,
  "location": 2,
  "content": "个体的习惯化行为方式",
