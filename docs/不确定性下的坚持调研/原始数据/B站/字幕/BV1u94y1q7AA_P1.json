 },
 {
  "from": 371.08,
  "to": 374.29,
  "sid": 167,
  "location": 2,
  "content": "这个方法只需要大家记住几个核心原则",
  "music": 0.0
 },
 {
  "from": 374.29,
  "to": 377.1,
  "sid": 168,
  "location": 2,
  "content": "一停止担心没有答案的事情",
  "music": 0.0
 },
 {
  "from": 377.1,
  "to": 378.86,
  "sid": 169,
  "location": 2,
  "content": "想要识别它们很简单",
  "music": 0.0
 },
 {
  "from": 378.86,
  "to": 380.15,
  "sid": 170,
  "location": 2,
  "content": "只需要问问自己",
  "music": 0.0
 },
 {
  "from": 380.15,
  "to": 381.86,
  "sid": 171,
  "location": 2,
  "content": "这个问题的答案是什么",
  "music": 0.0
 },
 {
  "from": 381.86,
  "to": 384.58,
  "sid": 172,
  "location": 2,
  "content": "或者我怎么能知道这个问题的答案",
  "music": 0.0
 },
 {
  "from": 384.58,
  "to": 386.02,
  "sid": 173,
  "location": 2,
  "content": "二停止担忧",
  "music": 0.0
 },
 {
  "from": 386.02,
  "to": 389.23,
  "sid": 174,
  "location": 2,
  "content": "无法很快采取行动来推进或解决的事情",
  "music": 0.0
 },
 {
  "from": 389.23,
  "to": 391.93,
  "sid": 175,
  "location": 2,
  "content": "比如担心自己考不上理想的大学",
  "music": 0.0
 },
 {
  "from": 391.93,
  "to": 393.56,
  "sid": 176,
  "location": 2,
  "content": "辜负了老师和家长",
  "music": 0.0
 },
 {
  "from": 393.56,
  "to": 395.27,
  "sid": 177,
  "location": 2,
  "content": "这个担忧就是无效的",
  "music": 0.0
 },
 {
  "from": 395.27,
  "to": 397.76,
  "sid": 178,
  "location": 2,
  "content": "抱着这个想法导致的就是干着急",
  "music": 0.0
 },
 {
  "from": 397.76,
  "to": 400.7,
  "sid": 179,
  "location": 2,
  "content": "所以不如马上坐下来写完今天的作业",
  "music": 0.0
 },
 {
  "from": 400.7,
  "to": 402.74,
  "sid": 180,
  "location": 2,
  "content": "大家要记得有效担忧",
  "music": 0.0
 },
 {
  "from": 402.74,
  "to": 405.76,
  "sid": 181,
  "location": 2,
  "content": "几乎都能立刻转化为可以采取的行动",
  "music": 0.0
 },
 {
  "from": 405.76,
  "to": 408.64,
  "sid": 182,
  "location": 2,
  "content": "另外就是对于那些发生概率极小",
  "music": 0.0
 },
 {
  "from": 408.64,
  "to": 411.64,
  "sid": 183,
  "location": 2,
  "content": "并且有超出自己控制范围的事情的担忧",
  "music": 0.0
 },
 {
  "from": 411.64,
  "to": 413.56,
  "sid": 184,
  "location": 2,
  "content": "也是大家需要停下来的",
  "music": 0.0
 },
 {
  "from": 413.56,
  "to": 417.35,
  "sid": 185,
  "location": 2,
  "content": "最后一个方法是追求满意解而非最优解",
  "music": 0.0
 },
 {
  "from": 417.35,
  "to": 418.34,
  "sid": 186,
  "location": 2,
  "content": "研究发现",
  "music": 0.0
 },
 {
  "from": 418.34,
  "to": 419.99,
  "sid": 187,
  "location": 2,
  "content": "人有两种决策风格",
  "music": 0.0
 },
 {
  "from": 419.99,
  "to": 421.87,
  "sid": 188,
  "location": 2,
  "content": "一种是满意急停搜",
  "music": 0.0
 },
 {
  "from": 421.87,
  "to": 424.3,
  "sid": 189,
  "location": 2,
  "content": "另一种则是穷尽所有选项",
  "music": 0.0
 },
 {
  "from": 424.3,
  "to": 426.19,
  "sid": 190,
  "location": 2,
  "content": "并从中选择最优的",
  "music": 0.0
 },
 {
  "from": 426.19,
  "to": 427.63,
  "sid": 191,
  "location": 2,
  "content": "追求最优解的人",
  "music": 0.0
 },
 {
  "from": 427.63,
  "to": 429.98,
  "sid": 192,
  "location": 2,
  "content": "即使找到了自己觉得还不错的选项",
  "music": 0.0
 },
 {
  "from": 429.98,
  "to": 432.26,
  "sid": 193,
  "location": 2,
  "content": "仍然会把它们放进备用箱里",
  "music": 0.0
 },
 {
  "from": 432.26,
  "to": 435.88,
  "sid": 194,
  "location": 2,
  "content": "等检索所有可能的选项后再做出最终选择",
