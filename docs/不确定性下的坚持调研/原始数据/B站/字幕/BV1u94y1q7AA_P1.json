 },
 {
  "from": 85.2,
  "to": 87.57,
  "sid": 44,
  "location": 2,
  "content": "仍然有长久的担忧与恐惧感",
  "music": 0.0
 },
 {
  "from": 87.57,
  "to": 90.28,
  "sid": 45,
  "location": 2,
  "content": "于是为了更好地处理广泛性焦虑",
