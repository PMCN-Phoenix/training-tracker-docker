 },
 {
  "from": 435.88,
  "to": 437.86,
  "sid": 195,
  "location": 2,
  "content": "然而这个过程耗时巨大",
  "music": 0.0
 },
 {
  "from": 437.86,
  "to": 439.6,
  "sid": 196,
  "location": 2,
  "content": "精力损耗极其严重",
  "music": 0.0
 },
 {
  "from": 439.6,
  "to": 442.15,
  "sid": 197,
  "location": 2,
  "content": "人只会在其中越来越焦虑烦躁",
  "music": 0.0
 },
 {
  "from": 442.15,
  "to": 444.16,
  "sid": 198,
  "location": 2,
  "content": "最后极大可能索性放弃",
  "music": 0.0
 },
 {
  "from": 444.16,
  "to": 445.42,
  "sid": 199,
  "location": 2,
  "content": "不做任何选择",
  "music": 0.0
 },
 {
  "from": 445.42,
  "to": 447.46,
  "sid": 200,
  "location": 2,
  "content": "所以从身边的小事开始",
  "music": 0.0
 },
 {
  "from": 447.46,
  "to": 449.08,
  "sid": 201,
  "location": 2,
  "content": "找到一个还不错的选项",
  "music": 0.0
 },
 {
  "from": 449.08,
  "to": 451.6,
  "sid": 202,
  "location": 2,
  "content": "就果断选择忘掉其他的选项",
  "music": 0.0
 },
 {
  "from": 451.6,
  "to": 454.42,
  "sid": 203,
  "location": 2,
  "content": "大家要充分发挥禀赋效应的威力呀",
  "music": 0.0
 },
 {
  "from": 454.42,
  "to": 456.62,
  "sid": 204,
  "location": 2,
  "content": "接下来是行为层面的方法",
