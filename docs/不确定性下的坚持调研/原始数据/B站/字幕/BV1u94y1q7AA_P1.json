 },
 {
  "from": 461.78,
  "to": 464.54,
  "sid": 207,
  "location": 2,
  "content": "就是通过有意地创造一种不确定状态",
  "music": 0.0
 },
 {
  "from": 464.54,
  "to": 466.91,
  "sid": 208,
  "location": 2,
  "content": "从而帮助一个人通过行为实践",
  "music": 0.0
 },
 {
  "from": 466.91,
  "to": 469.82,
  "sid": 209,
  "location": 2,
  "content": "矫正跟不确定性相关的无效信念",
  "music": 0.0
 },
 {
  "from": 469.82,
  "to": 472.5,
  "sid": 210,
  "location": 2,
  "content": "我用一个具体的例子来说明做法",
