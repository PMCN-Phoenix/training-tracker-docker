 },
 {
  "from": 71.92,
  "to": 73.96,
  "sid": 38,
  "location": 2,
  "content": "治疗有效性也较为有限",
  "music": 0.0
 },
 {
  "from": 73.96,
  "to": 76.96,
  "sid": 39,
  "location": 2,
  "content": "这里的广泛性焦虑障碍可以简单理解为",
  "music": 0.0
 },
 {
  "from": 76.96,
  "to": 79.02,
  "sid": 40,
  "location": 2,
  "content": "一个人对生活中的方方面面",
  "music": 0.0
 },
 {
  "from": 79.02,
  "to": 80.94,
  "sid": 41,
  "location": 2,
  "content": "持久而弥散性的焦虑",
