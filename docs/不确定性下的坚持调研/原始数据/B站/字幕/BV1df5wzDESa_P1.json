[
 {
  "from": 0.3,
  "to": 1.94,
  "sid": 1,
  "location": 2,
  "content": "假如书籍会说话",
  "music": 0.0
 },
 {
  "from": 1.94,
  "to": 3.08,
  "sid": 2,
  "location": 2,
  "content": "今日对话",
  "music": 0.0
 },
 {
  "from": 3.08,
  "to": 4.42,
  "sid": 3,
  "location": 2,
  "content": "终身成长",
  "music": 0.0
 },
 {
  "from": 4.42,
  "to": 5.42,
  "sid": 4,
  "location": 2,
  "content": "终身成长",
  "music": 0.0
 },
 {
  "from": 5.42,
  "to": 7.58,
  "sid": 5,
  "location": 2,
  "content": "老师咱们老说天赋决定上限",
  "music": 0.0
 },
 {
  "from": 7.58,
  "to": 10.6,
  "sid": 6,
  "location": 2,
  "content": "结果您上来就说天赋论是最大的谎言",
  "music": 0.0
 },
 {
  "from": 10.6,
  "to": 11.48,
  "sid": 7,
  "location": 2,
  "content": "我们都被骗了",
  "music": 0.0
 },
 {
  "from": 11.48,
  "to": 12.78,
  "sid": 8,
  "location": 2,
  "content": "那我天天觉得自己不行",
  "music": 0.0
 },
 {
  "from": 12.78,
  "to": 14.06,
  "sid": 9,
  "location": 2,
  "content": "岂不是白白耽误了自己",
  "music": 0.0
 },
 {
  "from": 14.06,
  "to": 15.4,
  "sid": 10,
  "location": 2,
  "content": "这到底是怎么一回事啊",
  "music": 0.0
 },
 {
  "from": 15.4,
  "to": 17.8,
  "sid": 11,
  "location": 2,
  "content": "天赋不是决定人生的起点",
  "music": 0.0
 },
 {
  "from": 17.8,
  "to": 19.6,
  "sid": 12,
  "location": 2,
  "content": "而是思维方式的终点",
  "music": 0.0
 },
 {
  "from": 19.6,
  "to": 20.26,
  "sid": 13,
  "location": 2,
  "content": "啥意思",
  "music": 0.0
 },
 {
  "from": 20.26,
  "to": 21.2,
  "sid": 14,
  "location": 2,
  "content": "我有点没理解",
  "music": 0.0
 },
 {
  "from": 21.2,
  "to": 23.28,
  "sid": 15,
  "location": 2,
  "content": "大多数人把自己局限在了",
  "music": 0.0
 },
 {
  "from": 23.28,
  "to": 25.26,
  "sid": 16,
  "location": 2,
  "content": "我不行的固定型思维里哦",
  "music": 0.0
 },
 {
  "from": 25.26,
  "to": 27.41,
  "sid": 17,
  "location": 2,
  "content": "您是说我们平时觉得自己不行",
  "music": 0.0
 },
 {
  "from": 27.41,
  "to": 29.73,
  "sid": 18,
  "location": 2,
  "content": "其实是被自己的想法给骗了",
  "music": 0.0
 },
 {
  "from": 29.73,
  "to": 31.35,
  "sid": 19,
  "location": 2,
  "content": "没错你不是没天赋",
  "music": 0.0
 },
 {
  "from": 31.35,
  "to": 34.12,
  "sid": 20,
  "location": 2,
  "content": "你只是被固定型思维PUA了太久等等",
  "music": 0.0
 },
 {
  "from": 34.12,
  "to": 36.0,
  "sid": 21,
  "location": 2,
  "content": "这个固定型思维到底什么意思",
  "music": 0.0
 },
 {
  "from": 36.0,
  "to": 38.1,
  "sid": 22,
  "location": 2,
  "content": "跟我们常说的天赋又有什么关系",
  "music": 0.0
 },
 {
  "from": 38.1,
  "to": 41.08,
  "sid": 23,
  "location": 2,
  "content": "固定型思维认为能力是固定的",
  "music": 0.0
 },
 {
  "from": 41.08,
  "to": 43.5,
  "sid": 24,
  "location": 2,
  "content": "就是认为我们的能力是天生的",
  "music": 0.0
 },
 {
  "from": 43.5,
  "to": 44.56,
  "sid": 25,
  "location": 2,
  "content": "改变不了对",
  "music": 0.0
 },
 {
  "from": 44.56,
  "to": 48.22,
  "sid": 26,
  "location": 2,
  "content": "而成长型思维相信能力可以通过努力发展",
  "music": 0.0
 },
 {
  "from": 48.22,
  "to": 49.72,
  "sid": 27,
  "location": 2,
  "content": "你选择哪种思维",
  "music": 0.0
 },
 {
  "from": 49.72,
  "to": 51.98,
  "sid": 28,
  "location": 2,
  "content": "决定了你的人生上限",
  "music": 0.0
 },
 {
  "from": 51.98,
  "to": 53.36,
  "sid": 29,
  "location": 2,
  "content": "天哪这么一说",
  "music": 0.0
 },
 {
  "from": 53.36,
  "to": 54.52,
  "sid": 30,
  "location": 2,
  "content": "我好像经常在想",
  "music": 0.0
 },
 {
  "from": 54.52,
  "to": 55.69,
  "sid": 31,
  "location": 2,
  "content": "我就是这样的人了",
  "music": 0.0
 },
 {
  "from": 55.69,
  "to": 56.27,
  "sid": 32,
  "location": 2,
  "content": "改不了",
  "music": 0.0
 },
 {
  "from": 56.27,
  "to": 58.11,
  "sid": 33,
  "location": 2,
  "content": "或者我就是没赚钱的天赋",
  "music": 0.0
 },
 {
  "from": 58.11,
  "to": 59.57,
  "sid": 34,
  "location": 2,
  "content": "这就是固定型思维",
  "music": 0.0
 },
 {
  "from": 59.57,
  "to": 61.5,
  "sid": 35,
  "location": 2,
  "content": "这种思维会造成什么影响呢",
  "music": 0.0
 },
 {
  "from": 61.5,
  "to": 63.52,
  "sid": 36,
  "location": 2,
  "content": "它会让你见到困难就退缩",
  "music": 0.0
 },
 {
  "from": 63.52,
  "to": 66.66,
  "sid": 37,
  "location": 2,
  "content": "潜意识里已经放弃了成长的可能性",
  "music": 0.0
 },
 {
  "from": 66.66,
  "to": 67.98,
  "sid": 38,
  "location": 2,
  "content": "那您的意思是",
  "music": 0.0
 },
 {
  "from": 67.98,
  "to": 69.86,
  "sid": 39,
  "location": 2,
  "content": "那些我们眼中的天才",
  "music": 0.0
 },
 {
  "from": 69.86,
  "to": 72.06,
  "sid": 40,
  "location": 2,
  "content": "其实不是因为他们天生就厉害",
  "music": 0.0
 },
 {
  "from": 72.06,
  "to": 75.76,
  "sid": 41,
  "location": 2,
  "content": "而是因为天才背后都有成长型思维在支撑",
  "music": 0.0
 },
 {
  "from": 75.76,
  "to": 77.32,
  "sid": 42,
  "location": 2,
  "content": "所以他们不怕失败",
  "music": 0.0
 },
 {
  "from": 77.32,
  "to": 78.84,
  "sid": 43,
  "location": 2,
  "content": "还把挑战当成成长机会",
  "music": 0.0
 },
 {
  "from": 78.84,
  "to": 79.66,
  "sid": 44,
  "location": 2,
  "content": "正是如此",
  "music": 0.0
 },
 {
  "from": 79.66,
  "to": 80.87,
  "sid": 45,
  "location": 2,
  "content": "我有点懵了",
  "music": 0.0
 },
 {
  "from": 80.87,
  "to": 82.89,
  "sid": 46,
  "location": 2,
  "content": "难道我身边那些动不动就说",
  "music": 0.0
 },
 {
  "from": 82.89,
  "to": 84.29,
  "sid": 47,
  "location": 2,
  "content": "我不是这块料的朋友",
  "music": 0.0
 },
 {
  "from": 84.29,
  "to": 85.99,
  "sid": 48,
  "location": 2,
  "content": "都是被自己的想法给坑了",
  "music": 0.0
 },
 {
  "from": 85.99,
  "to": 88.71,
  "sid": 49,
  "location": 2,
  "content": "固定型思维是人生最隐形的天花板",
  "music": 0.0
 },
 {
  "from": 88.71,
  "to": 89.32,
  "sid": 50,
  "location": 2,
  "content": "这么厉害",
  "music": 0.0
 },
 {
  "from": 89.32,
  "to": 90.88,
  "sid": 51,
  "location": 2,
  "content": "具体会怎么限制我们",
  "music": 0.0
 },
 {
  "from": 90.88,
  "to": 92.56,
  "sid": 52,
  "location": 2,
  "content": "他让你主动放弃可能性",
  "music": 0.0
 },
 {
  "from": 92.56,
  "to": 95.28,
  "sid": 53,
  "location": 2,
  "content": "甚至在没尝试前就认定自己会失败",
  "music": 0.0
 },
 {
  "from": 95.28,
  "to": 96.1,
  "sid": 54,
  "location": 2,
  "content": "太可怕了",
  "music": 0.0
 },
 {
  "from": 96.1,
  "to": 99.0,
  "sid": 55,
  "location": 2,
  "content": "那我怎么判断自己是不是这种固定性思维呢",
  "music": 0.0
 },
 {
  "from": 99.0,
  "to": 99.94,
  "sid": 56,
  "location": 2,
  "content": "有什么特征吗",
  "music": 0.0
 },
 {
  "from": 99.94,
  "to": 100.86,
  "sid": 57,
  "location": 2,
  "content": "三个特征",
  "music": 0.0
 },
 {
  "from": 100.86,
  "to": 101.78,
  "sid": 58,
  "location": 2,
  "content": "害怕犯错",
  "music": 0.0
 },
 {
  "from": 101.78,
  "to": 102.22,
  "sid": 59,
  "location": 2,
  "content": "逃避",
  "music": 0.0
 },
 {
  "from": 102.22,
  "to": 103.83,
  "sid": 60,
  "location": 2,
  "content": "努力嫉妒他人成功",
  "music": 0.0
 },
 {
  "from": 103.83,
  "to": 104.81,
  "sid": 61,
  "location": 2,
  "content": "还有别的表现吗",
  "music": 0.0
 },
 {
  "from": 104.81,
  "to": 105.65,
  "sid": 62,
  "location": 2,
  "content": "遇到挑战时",
  "music": 0.0
 },
 {
  "from": 105.65,
  "to": 107.35,
  "sid": 63,
  "location": 2,
  "content": "潜意识认为我做不到",
  "music": 0.0
 },
 {
  "from": 107.35,
  "to": 109.539,
  "sid": 64,
  "location": 2,
  "content": "而非我可以学会糟糕",
  "music": 0.0
 },
 {
  "from": 109.539,
  "to": 110.459,
  "sid": 65,
  "location": 2,
  "content": "我好像全中",
  "music": 0.0
 },
 {
  "from": 110.459,
  "to": 112.199,
  "sid": 66,
  "location": 2,
  "content": "特别是做事总想一步到位",
  "music": 0.0
 },
 {
  "from": 112.199,
  "to": 114.02,
  "sid": 67,
  "location": 2,
  "content": "一旦做错就感觉特没面子",
  "music": 0.0
 },
 {
  "from": 114.02,
  "to": 115.56,
  "sid": 68,
  "location": 2,
  "content": "这也是固定型思维的表现吗",
  "music": 0.0
 },
 {
  "from": 115.56,
  "to": 117.1,
  "sid": 69,
  "location": 2,
  "content": "典型的固定型思维",
  "music": 0.0
 },
 {
  "from": 117.1,
  "to": 119.24,
  "sid": 70,
  "location": 2,
  "content": "为什么这个思维方式会这样影响我们",
  "music": 0.0
 },
 {
  "from": 119.24,
  "to": 121.86,
  "sid": 71,
  "location": 2,
  "content": "因为你把失败视为能力不足的证明",
  "music": 0.0
 },
 {
  "from": 121.86,
  "to": 124.34,
  "sid": 72,
  "location": 2,
  "content": "而非学习过程中的必然环节",
  "music": 0.0
 },
 {
  "from": 124.34,
  "to": 126.539,
  "sid": 73,
  "location": 2,
  "content": "我身边好多人工作中明明做不好",
  "music": 0.0
 },
 {
  "from": 126.539,
  "to": 127.939,
  "sid": 74,
  "location": 2,
  "content": "却死撑着不求助",
  "music": 0.0
 },
 {
  "from": 127.939,
  "to": 129.439,
  "sid": 75,
  "location": 2,
  "content": "是不是也是这个原因",
  "music": 0.0
 },
 {
  "from": 129.439,
  "to": 132.159,
  "sid": 76,
  "location": 2,
  "content": "完美主义常常是固定型思维的表现",
  "music": 0.0
 },
 {
  "from": 132.159,
  "to": 133.78,
  "sid": 77,
  "location": 2,
  "content": "所以他们是怎么想的",
  "music": 0.0
 },
 {
  "from": 133.78,
  "to": 135.3,
  "sid": 78,
  "location": 2,
  "content": "他们害怕暴露无能",
  "music": 0.0
 },
 {
  "from": 135.3,
  "to": 136.36,
  "sid": 79,
  "location": 2,
  "content": "宁愿假装努力",
  "music": 0.0
 },
 {
  "from": 136.36,
  "to": 137.94,
  "sid": 80,
  "location": 2,
  "content": "也不真正寻求进步",
  "music": 0.0
 },
 {
  "from": 137.94,
  "to": 138.71,
  "sid": 81,
  "location": 2,
  "content": "这么说",
  "music": 0.0
 },
 {
  "from": 138.71,
  "to": 140.77,
  "sid": 82,
  "location": 2,
  "content": "固定型思维不仅阻碍我们进步",
  "music": 0.0
 },
 {
  "from": 140.77,
  "to": 142.47,
  "sid": 83,
  "location": 2,
  "content": "还会让我们活得特别累",
  "music": 0.0
 },
 {
  "from": 142.47,
  "to": 144.43,
  "sid": 84,
  "location": 2,
  "content": "那他是怎么偷走我们潜能的",
  "music": 0.0
 },
 {
  "from": 144.43,
  "to": 146.56,
  "sid": 85,
  "location": 2,
  "content": "它让你陷入习得性无助",
  "music": 0.0
 },
 {
  "from": 146.56,
  "to": 147.98,
  "sid": 86,
  "location": 2,
  "content": "习得性无助",
  "music": 0.0
 },
 {
  "from": 147.98,
  "to": 148.88,
  "sid": 87,
  "location": 2,
  "content": "这是什么",
  "music": 0.0
 },
 {
  "from": 148.88,
  "to": 150.16,
  "sid": 88,
  "location": 2,
  "content": "即使有机会改变",
  "music": 0.0
 },
 {
  "from": 150.16,
  "to": 151.64,
  "sid": 89,
  "location": 2,
  "content": "你也会主动放弃",
  "music": 0.0
 },
 {
  "from": 151.64,
  "to": 153.56,
  "sid": 90,
  "location": 2,
  "content": "因为你相信自己就是这样",
  "music": 0.0
 },
 {
  "from": 153.56,
  "to": 155.92,
  "sid": 91,
  "location": 2,
  "content": "天哪有研究数据支持这个观点吗",
  "music": 0.0
 },
 {
  "from": 155.92,
  "to": 157.92,
  "sid": 92,
  "location": 2,
  "content": "我们做过一项长期调查",
  "music": 0.0
 },
 {
  "from": 157.92,
  "to": 159.1,
  "sid": 93,
  "location": 2,
  "content": "数据很直白",
  "music": 0.0
 },
 {
  "from": 159.1,
  "to": 159.86,
  "sid": 94,
  "location": 2,
  "content": "具体说说看",
  "music": 0.0
 },
 {
  "from": 159.86,
  "to": 162.24,
  "sid": 95,
  "location": 2,
  "content": "如果一个25岁的人不改变思维方式",
  "music": 0.0
 },
 {
  "from": 162.24,
  "to": 164.269,
  "sid": 96,
  "location": 2,
  "content": "那么随着年龄增长",
  "music": 0.0
 },
 {
  "from": 164.269,
  "to": 166.569,
  "sid": 97,
  "location": 2,
  "content": "他成功的可能性会慢慢下降",
  "music": 0.0
 },
 {
  "from": 166.569,
  "to": 170.389,
  "sid": 98,
  "location": 2,
  "content": "大约每延迟5年成功概率下降37%",
  "music": 0.0
 },
 {
  "from": 170.389,
  "to": 170.989,
  "sid": 99,
  "location": 2,
  "content": "这么说",
  "music": 0.0
 },
 {
  "from": 170.989,
  "to": 172.749,
  "sid": 100,
  "location": 2,
  "content": "思维方式改变的越早越好",
  "music": 0.0
 },
 {
  "from": 172.749,
  "to": 173.28,
  "sid": 101,
  "location": 2,
  "content": "没错",
  "music": 0.0
 },
 {
  "from": 173.28,
  "to": 175.9,
  "sid": 102,
  "location": 2,
  "content": "越早开始相信自己能通过努力变得更好",
  "music": 0.0
 },
 {
  "from": 175.9,
  "to": 178.06,
  "sid": 103,
  "location": 2,
  "content": "你就能越早释放自己的潜力",
  "music": 0.0
 },
 {
  "from": 178.06,
  "to": 178.96,
  "sid": 104,
  "location": 2,
  "content": "我想起来了",
  "music": 0.0
 },
 {
  "from": 178.96,
  "to": 181.4,
  "sid": 105,
  "location": 2,
  "content": "有些名人也是从失败走向成功的吧",
  "music": 0.0
 },
 {
  "from": 181.4,
  "to": 183.96,
  "sid": 106,
  "location": 2,
  "content": "比如乔丹不是也被高中球队拒绝过吗",
  "music": 0.0
 },
 {
  "from": 183.96,
  "to": 184.36,
  "sid": 107,
  "location": 2,
  "content": "是的",
  "music": 0.0
 },
 {
  "from": 184.36,
  "to": 185.72,
  "sid": 108,
  "location": 2,
  "content": "他被高中球队拒绝后",
  "music": 0.0
 },
 {
  "from": 185.72,
  "to": 187.67,
  "sid": 109,
  "location": 2,
  "content": "每天凌晨四点起床加练",
  "music": 0.0
 },
 {
  "from": 187.67,
  "to": 189.05,
  "sid": 110,
  "location": 2,
  "content": "他对这些失败怎么看",
  "music": 0.0
 },
 {
  "from": 189.05,
  "to": 192.18,
  "sid": 111,
  "location": 2,
  "content": "他说我人生中失败了一次又一次",
  "music": 0.0
 },
 {
  "from": 192.18,
  "to": 193.8,
  "sid": 112,
  "location": 2,
  "content": "这就是我成功的原因",
  "music": 0.0
 },
 {
  "from": 193.8,
  "to": 195.42,
  "sid": 113,
  "location": 2,
  "content": "那中国也有这样的例子吗",
  "music": 0.0
 },
 {
  "from": 195.42,
  "to": 197.04,
  "sid": 114,
  "location": 2,
  "content": "像是王一博之类的",
  "music": 0.0
 },
 {
  "from": 197.04,
  "to": 198.58,
  "sid": 115,
  "location": 2,
  "content": "中国的例子也很多",
