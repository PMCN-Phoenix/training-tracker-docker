 {
  "from": 492.81,
  "to": 493.84,
  "sid": 219,
  "location": 2,
  "content": "怪运气不好",
  "music": 0.0
 },
 {
  "from": 493.84,
  "to": 497.38,
  "sid": 220,
  "location": 2,
  "content": "20年的差距就是在每一个普通的夜晚拉开的",
  "music": 0.0
 },
 {
  "from": 497.38,
  "to": 501.13,
  "sid": 221,
  "location": 2,
  "content": "一个人花20分钟诚实地审视了自己当天的判断",
  "music": 0.0
 },
 {
  "from": 501.13,
  "to": 503.99,
  "sid": 222,
  "location": 2,
  "content": "另一个人刷了20分钟短视频就睡了",
  "music": 0.0
 },
 {
  "from": 503.99,
  "to": 507.49,
  "sid": 223,
  "location": 2,
  "content": "命运分叉的起点往往就是这么安静",
  "music": 0.0
 },
 {
  "from": 509.26,
  "to": 510.48,
  "sid": 224,
  "location": 2,
  "content": "有句老话说",
  "music": 0.0
 },
 {
  "from": 510.48,
  "to": 512.66,
  "sid": 225,
  "location": 2,
  "content": "人不能两次踏进同一条河流",
  "music": 0.0
 },
 {
  "from": 512.66,
  "to": 516.96,
  "sid": 226,
  "location": 2,
  "content": "但现实是多数人一辈子都在同一条河流里反复溺水",
  "music": 0.0
 },
 {
  "from": 516.96,
  "to": 521.38,
  "sid": 227,
  "location": 2,
  "content": "深度复盘给人提供的某种意义上是一种重活一次的能力",
  "music": 0.0
 },
 {
  "from": 521.38,
  "to": 522.86,
  "sid": 228,
  "location": 2,
  "content": "你没有办法回到过去",
  "music": 0.0
 },
 {
  "from": 522.86,
  "to": 524.3,
  "sid": 229,
  "location": 2,
  "content": "改变已经发生的事",
  "music": 0.0
 },
 {
  "from": 524.3,
  "to": 525.64,
  "sid": 230,
  "location": 2,
  "content": "但你可以通过复盘",
  "music": 0.0
 },
 {
  "from": 525.64,
  "to": 528.94,
  "sid": 231,
  "location": 2,
  "content": "把过去发生的每一件事都变成未来的燃料",
  "music": 0.0
 },
 {
  "from": 528.94,
  "to": 531.3,
  "sid": 232,
  "location": 2,
  "content": "每一次失败经过深度拆解后",
  "music": 0.0
 },
 {
  "from": 531.3,
  "to": 533.0,
  "sid": 233,
  "location": 2,
  "content": "就不再是单纯的损失",
  "music": 0.0
 },
 {
  "from": 533.0,
  "to": 535.98,
  "sid": 234,
  "location": 2,
  "content": "它变成了你决策系统里一个新的校准点",
  "music": 0.0
 },
 {
  "from": 535.98,
  "to": 538.52,
  "sid": 235,
  "location": 2,
  "content": "每一次成功经过诚实的复盘后",
  "music": 0.0
 },
 {
  "from": 538.52,
  "to": 540.54,
  "sid": 236,
  "location": 2,
  "content": "你才能分清哪些是真本事",
  "music": 0.0
 },
 {
  "from": 540.54,
  "to": 541.72,
  "sid": 237,
  "location": 2,
  "content": "哪些是撞大运",
  "music": 0.0
 },
 {
  "from": 541.72,
  "to": 543.44,
  "sid": 238,
  "location": 2,
  "content": "下次才知道该复制什么",
  "music": 0.0
 },
 {
  "from": 543.44,
  "to": 544.52,
  "sid": 239,
  "location": 2,
  "content": "该警惕什么",
  "music": 0.0
 },
 {
  "from": 544.52,
  "to": 545.98,
  "sid": 240,
  "location": 2,
  "content": "一个人活了40年",
  "music": 0.0
 },
 {
  "from": 545.98,
  "to": 547.2,
  "sid": 241,
  "location": 2,
  "content": "如果从来不复盘",
  "music": 0.0
 },
 {
  "from": 547.2,
  "to": 549.22,
  "sid": 242,
  "location": 2,
  "content": "他拥有的只是40年的经历",
  "music": 0.0
 },
 {
  "from": 549.22,
  "to": 550.48,
  "sid": 243,
  "location": 2,
  "content": "一个人活了40年",
  "music": 0.0
 },
 {
  "from": 550.48,
  "to": 552.28,
  "sid": 244,
  "location": 2,
  "content": "如果每天都在做深度复盘",
  "music": 0.0
 },
 {
  "from": 552.28,
  "to": 555.18,
  "sid": 245,
  "location": 2,
  "content": "他拥有的是被反复提纯过40年的智慧",
  "music": 0.0
 },
 {
  "from": 555.18,
  "to": 556.49,
  "sid": 246,
  "location": 2,
  "content": "前者是原矿石",
  "music": 0.0
 },
 {
  "from": 556.49,
  "to": 558.09,
  "sid": 247,
  "location": 2,
  "content": "后者是精炼过的金属",
  "music": 0.0
 },
 {
  "from": 558.09,
  "to": 562.39,
  "sid": 248,
  "location": 2,
  "content": "这中间的密度差就是人与人之间最安静也最残酷的分野",
  "music": 0.0
 },
 {
  "from": 562.39,
  "to": 563.89,
  "sid": 249,
  "location": 2,
  "content": "今天的分享就到这里",
  "music": 0.0
 },
 {
  "from": 563.89,
  "to": 564.63,
  "sid": 250,
  "location": 2,
  "content": "我是店长",
  "music": 0.0
 },
 {
  "from": 564.63,
  "to": 566.24,
  "sid": 251,
  "location": 2,
  "content": "我们下期再见",
  "music": 0.0
 }
]