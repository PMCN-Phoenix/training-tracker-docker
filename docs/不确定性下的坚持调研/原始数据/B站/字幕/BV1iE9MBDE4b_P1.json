[
 {
  "from": 0.08,
  "to": 2.12,
  "sid": 1,
  "location": 2,
  "content": "给我三秒钟问你一个问题",
  "music": 0.0
 },
 {
  "from": 2.12,
  "to": 4.18,
  "sid": 2,
  "location": 2,
  "content": "5年前让你最痛的那件事",
  "music": 0.0
 },
 {
  "from": 4.18,
  "to": 7.72,
  "sid": 3,
  "location": 2,
  "content": "你现在还在用当时一样的方式处理同类问题吗",
  "music": 0.0
 },
 {
  "from": 7.72,
  "to": 8.88,
  "sid": 4,
  "location": 2,
  "content": "不用急着回答",
  "music": 0.0
 },
 {
  "from": 8.88,
  "to": 10.98,
  "sid": 5,
  "location": 2,
  "content": "大多数人在心里已经有了答案",
  "music": 0.0
 },
 {
  "from": 10.98,
  "to": 13.15,
  "sid": 6,
  "location": 2,
  "content": "只是不想承认同样的坑",
  "music": 0.0
 },
 {
  "from": 13.15,
  "to": 14.61,
  "sid": 7,
  "location": 2,
  "content": "踩两次叫不幸",
  "music": 0.0
 },
 {
  "from": 14.61,
  "to": 18.66,
  "sid": 8,
  "location": 2,
  "content": "踩三次叫选择踩无数次叫没有复盘过",
  "music": 0.0
 },
 {
  "from": 18.66,
  "to": 20.58,
  "sid": 9,
  "location": 2,
  "content": "复盘这两个字你一定听过",
  "music": 0.0
 },
 {
  "from": 20.58,
  "to": 21.76,
  "sid": 10,
  "location": 2,
  "content": "甚至可能用过",
  "music": 0.0
 },
 {
  "from": 21.76,
  "to": 23.58,
  "sid": 11,
  "location": 2,
  "content": "但我可以非常确定的告诉你",
  "music": 0.0
 },
 {
  "from": 23.58,
  "to": 25.83,
  "sid": 12,
  "location": 2,
  "content": "你大概率从来没有做对过一次",
  "music": 0.0
 },
 {
  "from": 25.83,
  "to": 30.47,
  "sid": 13,
  "location": 2,
  "content": "因为真正的深度复盘是一个需要你主动对抗自己大脑本能的动作",
  "music": 0.0
 },
 {
  "from": 30.47,
  "to": 31.69,
  "sid": 14,
  "location": 2,
  "content": "它会让你不舒服",
  "music": 0.0
 },
 {
  "from": 31.69,
  "to": 32.55,
  "sid": 15,
  "location": 2,
  "content": "会让你难受",
  "music": 0.0
 },
 {
  "from": 32.55,
  "to": 33.71,
  "sid": 16,
  "location": 2,
  "content": "会让你想逃",
  "music": 0.0
 },
 {
  "from": 33.71,
  "to": 34.93,
  "sid": 17,
  "location": 2,
  "content": "而正是因为难",
  "music": 0.0
 },
 {
  "from": 34.93,
  "to": 35.95,
  "sid": 18,
  "location": 2,
  "content": "所以做对的人",
  "music": 0.0
 },
 {
  "from": 35.95,
  "to": 37.45,
  "sid": 19,
  "location": 2,
  "content": "极少做对了的人",
  "music": 0.0
 },
 {
  "from": 37.45,
  "to": 39.63,
  "sid": 20,
  "location": 2,
  "content": "命运走向和其他人截然不同",
  "music": 0.0
 },
 {
  "from": 39.63,
  "to": 40.59,
  "sid": 21,
  "location": 2,
  "content": "什么叫做对",
  "music": 0.0
 },
 {
  "from": 40.59,
  "to": 41.7,
  "sid": 22,
  "location": 2,
  "content": "难在哪一步",
  "music": 0.0
 },
 {
  "from": 41.7,
  "to": 46.06,
  "sid": 23,
  "location": 2,
  "content": "为什么越聪明的人越容易在这件事上自欺欺人",
  "music": 0.0
 },
 {
  "from": 50.22,
  "to": 52.72,
  "sid": 24,
  "location": 2,
  "content": "我们从小被教育说经验很宝贵",
  "music": 0.0
 },
 {
  "from": 52.72,
  "to": 54.4,
  "sid": 25,
  "location": 2,
  "content": "做的多了自然就会了",
  "music": 0.0
 },
 {
  "from": 54.4,
  "to": 56.11,
  "sid": 26,
  "location": 2,
  "content": "吃过亏就能长记性",
  "music": 0.0
 },
 {
  "from": 56.11,
  "to": 58.09,
  "sid": 27,
  "location": 2,
  "content": "但你仔细去观察身边的人",
  "music": 0.0
 },
 {
  "from": 58.09,
  "to": 59.99,
  "sid": 28,
  "location": 2,
  "content": "会发现一个很残酷的事实",
  "music": 0.0
 },
 {
  "from": 59.99,
  "to": 64.39,
  "sid": 29,
  "location": 2,
  "content": "大多数人的所谓经验只是把同一套动作重复了很多遍而已",
  "music": 0.0
 },
 {
  "from": 64.39,
  "to": 66.29,
  "sid": 30,
  "location": 2,
  "content": "一个人开了10年出租车",
  "music": 0.0
 },
 {
  "from": 66.29,
  "to": 69.31,
  "sid": 31,
  "location": 2,
  "content": "不代表他比开了3年的人更懂驾驶策略",
  "music": 0.0
 },
 {
  "from": 69.31,
  "to": 72.52,
  "sid": 32,
  "location": 2,
  "content": "他可能只是用第一年学会的东西又跑了9年",
  "music": 0.0
 },
 {
  "from": 72.52,
  "to": 74.2,
  "sid": 33,
  "location": 2,
  "content": "一个人做了8年销售",
  "music": 0.0
 },
 {
  "from": 74.2,
  "to": 75.84,
  "sid": 34,
  "location": 2,
  "content": "业绩还在中游晃荡",
  "music": 0.0
 },
 {
  "from": 75.84,
  "to": 79.199,
  "sid": 35,
  "location": 2,
  "content": "他的8年经验很可能就是一年经验用了八次",
  "music": 0.0
 },
 {
  "from": 79.199,
  "to": 83.079,
  "sid": 36,
  "location": 2,
  "content": "心理学家安德斯艾利克森在研究专家型人才时",
  "music": 0.0
 },
 {
  "from": 83.079,
  "to": 84.84,
  "sid": 37,
  "location": 2,
  "content": "提出过一个很关键的发现",
  "music": 0.0
 },
 {
  "from": 84.84,
  "to": 86.72,
  "sid": 38,
  "location": 2,
  "content": "单纯的重复不会带来进步",
  "music": 0.0
 },
 {
  "from": 86.72,
  "to": 89.259,
  "sid": 39,
  "location": 2,
  "content": "只有刻意练习才能突破能力瓶颈",
  "music": 0.0
 },
 {
  "from": 89.259,
  "to": 93.97,
  "sid": 40,
  "location": 2,
  "content": "而刻意练习的核心环节就是每一次动作之后的深度复盘",
  "music": 0.0
 },
 {
  "from": 93.97,
  "to": 95.15,
  "sid": 41,
  "location": 2,
  "content": "没有复盘的经历",
  "music": 0.0
 },
 {
  "from": 95.15,
  "to": 96.47,
  "sid": 42,
  "location": 2,
  "content": "只是时间的堆积",
  "music": 0.0
 },
 {
  "from": 96.47,
  "to": 97.93,
  "sid": 43,
  "location": 2,
  "content": "你在里面泡得再久",
  "music": 0.0
 },
 {
  "from": 97.93,
  "to": 100.07,
  "sid": 44,
  "location": 2,
  "content": "认知水位也不会自动上涨",
  "music": 0.0
 },
 {
  "from": 100.07,
  "to": 101.97,
  "sid": 45,
  "location": 2,
  "content": "曾国藩年轻时脾气暴躁",
  "music": 0.0
 },
 {
  "from": 105.259,
  "to": 107.699,
  "sid": 46,
  "location": 2,
  "content": "但他有一个坚持了几十年的习惯",
  "music": 0.0
 },
 {
  "from": 107.699,
  "to": 108.659,
  "sid": 47,
  "location": 2,
  "content": "每天写日记",
  "music": 0.0
 },
 {
  "from": 108.659,
  "to": 109.819,
  "sid": 48,
  "location": 2,
  "content": "不是记流水账",
  "music": 0.0
 },
 {
  "from": 109.819,
  "to": 111.479,
  "sid": 49,
  "location": 2,
  "content": "而是把当天说错的话",
  "music": 0.0
 },
 {
  "from": 111.479,
  "to": 114.19,
  "sid": 50,
  "location": 2,
  "content": "做错的判断暴露出来的性格缺陷",
  "music": 0.0
 },
 {
  "from": 114.19,
  "to": 115.39,
  "sid": 51,
  "location": 2,
  "content": "一条一条拎出来",
  "music": 0.0
 },
 {
  "from": 115.39,
  "to": 116.31,
  "sid": 52,
  "location": 2,
  "content": "反复审视",
  "music": 0.0
 },
 {
  "from": 116.31,
  "to": 119.74,
  "sid": 53,
  "location": 2,
  "content": "他在日记里骂自己的狠劲比任何敌人都毒",
  "music": 0.0
 },
 {
  "from": 119.74,
  "to": 122.35,
  "sid": 54,
  "location": 2,
  "content": "正是这种日复一日的自我拆解",
  "music": 0.0
 },
 {
  "from": 122.35,
  "to": 124.49,
  "sid": 55,
  "location": 2,
  "content": "让他从一个资质平平的笨人",
  "music": 0.0
 },
 {
  "from": 124.49,
  "to": 127.13,
  "sid": 56,
  "location": 2,
  "content": "一步步磨成了晚清最能扛事的人",
  "music": 0.0
 },
 {
  "from": 127.13,
  "to": 128.57,
  "sid": 57,
  "location": 2,
  "content": "经验本身不值钱",
  "music": 0.0
 },
 {
  "from": 128.57,
  "to": 130.519,
  "sid": 58,
  "location": 2,
  "content": "被审视过的经验才值钱",
  "music": 0.0
 },
 {
  "from": 130.519,
  "to": 132.239,
  "sid": 59,
  "location": 2,
  "content": "一个人如果只是经历过",
  "music": 0.0
 },
 {
  "from": 132.239,
  "to": 136.039,
  "sid": 60,
  "location": 2,
  "content": "却从来没有停下来拆解过那段经历里自己的判断链条",
  "music": 0.0
 },
 {
  "from": 136.039,
  "to": 138.05,
  "sid": 61,
  "location": 2,
  "content": "情绪波动和选择逻辑",
  "music": 0.0
 },
 {
  "from": 138.05,
  "to": 140.53,
  "sid": 62,
  "location": 2,
  "content": "那这段经历就像一场没有被消化的饭",
  "music": 0.0
 },
 {
  "from": 140.53,
  "to": 141.29,
  "sid": 63,
  "location": 2,
  "content": "吃下去了",
  "music": 0.0
 },
 {
  "from": 141.29,
  "to": 142.77,
  "sid": 64,
  "location": 2,
  "content": "但营养一点没吸收",
  "music": 0.0
 },
 {
  "from": 142.77,
  "to": 144.83,
  "sid": 65,
  "location": 2,
  "content": "那为什么多数人做不到这一步",
  "music": 0.0
 },
 {
  "from": 144.83,
  "to": 148.19,
  "sid": 66,
  "location": 2,
  "content": "问题出在一个很多人意识不到的地方",
  "music": 0.0
 },
 {
  "from": 149.46,
  "to": 152.04,
  "sid": 67,
  "location": 2,
  "content": "复盘这件事最大的障碍不是没时间",
  "music": 0.0
 },
 {
  "from": 152.04,
  "to": 153.12,
  "sid": 68,
  "location": 2,
  "content": "也不是没方法",
  "music": 0.0
 },
 {
  "from": 153.12,
  "to": 156.09,
  "sid": 69,
  "location": 2,
  "content": "而是你的大脑会拼命阻止你看到真相",
  "music": 0.0
 },
 {
  "from": 156.09,
  "to": 157.41,
  "sid": 70,
  "location": 2,
  "content": "这话听着夸张",
  "music": 0.0
 },
 {
  "from": 157.41,
  "to": 158.91,
  "sid": 71,
  "location": 2,
  "content": "但从脑科学角度看",
  "music": 0.0
 },
 {
  "from": 158.91,
  "to": 159.91,
  "sid": 72,
  "location": 2,
  "content": "完全成立",
  "music": 0.0
 },
 {
  "from": 159.91,
  "to": 163.23,
  "sid": 73,
  "location": 2,
  "content": "人类大脑有一套极其强大的自我保护机制",
  "music": 0.0
 },
 {
  "from": 163.23,
  "to": 165.87,
  "sid": 74,
  "location": 2,
  "content": "心理学上叫认知失调修复机制",
  "music": 0.0
 },
 {
  "from": 165.87,
  "to": 168.6,
  "sid": 75,
  "location": 2,
  "content": "简单说就是当你做了一个错误决定",
  "music": 0.0
 },
 {
  "from": 168.6,
  "to": 169.04,
  "sid": 76,
  "location": 2,
  "content": "事后",
  "music": 0.0
 },
 {
  "from": 169.04,
  "to": 170.76,
  "sid": 77,
  "location": 2,
  "content": "大脑不会老老实实告诉你",
  "music": 0.0
 },
 {
  "from": 170.76,
  "to": 171.54,
  "sid": 78,
  "location": 2,
  "content": "你搞砸了",
  "music": 0.0
 },
 {
  "from": 171.54,
  "to": 173.38,
  "sid": 79,
  "location": 2,
  "content": "它会自动帮你编一套故事",
  "music": 0.0
 },
 {
  "from": 173.38,
  "to": 175.16,
  "sid": 80,
  "location": 2,
  "content": "让你觉得其实也没那么差",
  "music": 0.0
 },
 {
  "from": 175.16,
  "to": 176.93,
  "sid": 81,
  "location": 2,
  "content": "或者这不是我的问题",
  "music": 0.0
 },
 {
  "from": 176.93,
  "to": 179.51,
  "sid": 82,
  "location": 2,
  "content": "比如你冲动买了一只暴跌的股票",
  "music": 0.0
 },
 {
  "from": 179.51,
  "to": 182.65,
  "sid": 83,
  "location": 2,
  "content": "事后你很少会承认我当时判断完全错了",
  "music": 0.0
 },
 {
  "from": 182.65,
  "to": 184.27,
  "sid": 84,
  "location": 2,
  "content": "大脑更倾向于告诉你",
  "music": 0.0
 },
 {
  "from": 184.27,
  "to": 184.95,
  "sid": 85,
  "location": 2,
  "content": "大盘不好",
  "music": 0.0
 },
 {
  "from": 184.95,
  "to": 185.55,
  "sid": 86,
  "location": 2,
  "content": "谁都亏",
  "music": 0.0
 },
 {
  "from": 185.55,
  "to": 187.44,
  "sid": 87,
  "location": 2,
  "content": "或者长期来看还是会涨的",
  "music": 0.0
 },
 {
  "from": 187.44,
  "to": 189.93,
  "sid": 88,
  "location": 2,
  "content": "再比如一段失败的合作关系",
  "music": 0.0
 },
 {
  "from": 189.93,
  "to": 190.85,
  "sid": 89,
  "location": 2,
  "content": "复盘的时候",
  "music": 0.0
 },
 {
  "from": 190.85,
  "to": 193.53,
  "sid": 90,
  "location": 2,
  "content": "你的第一反应几乎一定是对方不靠谱",
  "music": 0.0
 },
 {
  "from": 193.53,
  "to": 197.149,
  "sid": 91,
  "location": 2,
  "content": "而不是我在选人这件事上出了什么系统性偏差",
  "music": 0.0
 },
 {
  "from": 197.149,
  "to": 200.689,
  "sid": 92,
  "location": 2,
  "content": "哈佛商学院教授弗朗西斯卡吉诺做过一组实验",
  "music": 0.0
 },
 {
  "from": 200.689,
  "to": 203.429,
  "sid": 93,
  "location": 2,
  "content": "让参与者回顾自己过去的决策失误",
  "music": 0.0
 },
 {
  "from": 203.429,
  "to": 208.52,
  "sid": 94,
  "location": 2,
  "content": "结果发现超过70%的人会在回忆时不自觉地美化自己的角色",
  "music": 0.0
 },
 {
  "from": 208.52,
  "to": 209.92,
  "sid": 95,
  "location": 2,
  "content": "弱化自己的责任",
  "music": 0.0
 },
 {
  "from": 209.92,
  "to": 211.78,
  "sid": 96,
  "location": 2,
  "content": "夸大外部因素的影响",
  "music": 0.0
 },
 {
  "from": 211.78,
  "to": 213.9,
  "sid": 97,
  "location": 2,
  "content": "也就是说你觉得自己在复盘",
  "music": 0.0
 },
 {
  "from": 213.9,
  "to": 217.269,
  "sid": 98,
  "location": 2,
  "content": "实际上只是在做一场精心包装过的自我安慰",
  "music": 0.0
 },
 {
  "from": 217.269,
  "to": 219.369,
  "sid": 99,
  "location": 2,
  "content": "这就是复盘真正难的地方",
  "music": 0.0
 },
 {
  "from": 219.369,
  "to": 221.109,
  "sid": 100,
  "location": 2,
  "content": "他要求你主动撕开大脑",
  "music": 0.0
 },
 {
  "from": 221.109,
  "to": 222.209,
  "sid": 101,
  "location": 2,
  "content": "编好的保护膜",
  "music": 0.0
 },
 {
  "from": 222.209,
  "to": 224.31,
  "sid": 102,
  "location": 2,
  "content": "直视那个让你不舒服的自己",
  "music": 0.0
 },
 {
  "from": 224.31,
  "to": 226.93,
  "sid": 103,
  "location": 2,
  "content": "这个过程会产生强烈的心理抗拒",
  "music": 0.0
 },
 {
  "from": 226.93,
  "to": 230.14,
  "sid": 104,
  "location": 2,
  "content": "因为承认错误会触发大脑的威胁警报系统",
  "music": 0.0
 },
 {
  "from": 230.14,
  "to": 234.41,
  "sid": 105,
  "location": 2,
  "content": "杏仁核会释放跟面对物理危险时几乎一样的应急信号",
  "music": 0.0
 },
 {
  "from": 234.41,
  "to": 236.15,
  "sid": 106,
  "location": 2,
  "content": "承认我判断失误了",
  "music": 0.0
 },
 {
  "from": 236.15,
  "to": 237.77,
  "sid": 107,
  "location": 2,
  "content": "这件事对大脑来说",
  "music": 0.0
 },
 {
  "from": 237.77,
  "to": 241.44,
  "sid": 108,
  "location": 2,
  "content": "和前面有一头老虎触发的紧张感属于同一类反应",
  "music": 0.0
 },
 {
  "from": 241.44,
  "to": 244.82,
  "sid": 109,
  "location": 2,
  "content": "所以绝大多数人面对失败时的本能反应是逃避",
  "music": 0.0
 },
 {
  "from": 244.82,
  "to": 246.85,
