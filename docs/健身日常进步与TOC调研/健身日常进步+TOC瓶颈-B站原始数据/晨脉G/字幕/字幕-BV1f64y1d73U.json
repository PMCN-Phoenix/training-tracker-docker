[
 {
  "from": 3.38,
  "to": 3.86,
  "sid": 1,
  "location": 2,
  "content": "大家好",
  "music": 0.0
 },
 {
  "from": 3.86,
  "to": 6.26,
  "sid": 2,
  "location": 2,
  "content": "我是胃肠外科朱医生啊",
  "music": 0.0
 },
 {
  "from": 6.26,
  "to": 8.8,
  "sid": 3,
  "location": 2,
  "content": "今天给大家科普一下什么叫反关脉",
  "music": 0.0
 },
 {
  "from": 10.04,
  "to": 14.9,
  "sid": 4,
  "location": 2,
  "content": "临床上呢我们一般扎血气是从桡动脉开始炸",
  "music": 0.0
 },
 {
  "from": 16.36,
  "to": 18.22,
  "sid": 5,
  "location": 2,
  "content": "我第一次接触反关脉呢",
  "music": 0.0
 },
 {
  "from": 18.22,
  "to": 21.76,
  "sid": 6,
  "location": 2,
  "content": "是在19年给一个病人扎血气的时候呃",
  "music": 0.0
 },
 {
  "from": 21.76,
  "to": 23.52,
  "sid": 7,
  "location": 2,
  "content": "他那个脉搏那就摸不到",
  "music": 0.0
 },
 {
  "from": 23.939,
  "to": 27.509,
  "sid": 8,
  "location": 2,
  "content": "我刚开始的时候也不知道什么叫反关脉",
  "music": 0.0
 },
 {
  "from": 27.509,
  "to": 32.05,
  "sid": 9,
  "location": 2,
  "content": "那个时候摸了半天也没有摸到",
  "music": 0.0
 },
 {
  "from": 32.05,
  "to": 34.24,
  "sid": 10,
  "location": 2,
  "content": "后来那个病人提醒我说",
  "music": 0.0
 },
 {
  "from": 34.24,
  "to": 35.38,
  "sid": 11,
  "location": 2,
  "content": "嗯朱大夫",
  "music": 0.0
 },
 {
  "from": 35.38,
  "to": 36.82,
  "sid": 12,
  "location": 2,
  "content": "我是反关脉",
  "music": 0.0
 },
 {
  "from": 37.1,
  "to": 40.76,
  "sid": 13,
  "location": 2,
  "content": "因为反关脉这个概念呢它是中医的一个概念",
  "music": 0.0
 },
 {
  "from": 40.76,
  "to": 45.98,
  "sid": 14,
  "location": 2,
  "content": "好像我们上学学西医都没有遇到过这个概念啊",
  "music": 0.0
 },
 {
  "from": 45.98,
  "to": 47.06,
  "sid": 15,
  "location": 2,
  "content": "他说反关脉呢",
  "music": 0.0
 },
 {
  "from": 47.06,
  "to": 51.68,
  "sid": 16,
  "location": 2,
  "content": "我的一般是在这个手腕的外侧能摸到",
  "music": 0.0
 },
 {
  "from": 51.76,
  "to": 53.26,
  "sid": 17,
  "location": 2,
  "content": "后来我就摸了一下",
  "music": 0.0
 },
 {
  "from": 53.26,
  "to": 55.27,
  "sid": 18,
  "location": 2,
  "content": "就确实在手腕的外侧",
  "music": 0.0
 },
 {
  "from": 55.27,
  "to": 55.84,
  "sid": 19,
  "location": 2,
  "content": "从哪儿呢",
  "music": 0.0
 },
 {
  "from": 55.84,
  "to": 58.51,
  "sid": 20,
  "location": 2,
  "content": "我就知道这个反关脉到底是怎么回事了",
  "music": 0.0
 },
 {
  "from": 58.51,
  "to": 60.55,
  "sid": 21,
  "location": 2,
  "content": "一般来说大家都知道我摸摸脉搏",
  "music": 0.0
 },
 {
  "from": 60.55,
  "to": 62.65,
  "sid": 22,
  "location": 2,
  "content": "他是在这个呃",
  "music": 0.0
 },
 {
  "from": 62.65,
  "to": 66.82,
  "sid": 23,
  "location": 2,
  "content": "在这个在我们这个手臂的这个偏外侧这个地方",
  "music": 0.0
 },
 {
  "from": 67.06,
  "to": 69.52,
  "sid": 24,
  "location": 2,
  "content": "大家可以摸一下嗯",
  "music": 0.0
 },
 {
  "from": 69.52,
  "to": 70.86,
  "sid": 25,
  "location": 2,
  "content": "他就在这个沟里",
  "music": 0.0
 },
 {
  "from": 71.74,
  "to": 73.74,
  "sid": 26,
  "location": 2,
  "content": "但是那个病人那个反关脉呢",
  "music": 0.0
 },
 {
  "from": 73.74,
  "to": 75.3,
  "sid": 27,
  "location": 2,
  "content": "他就是在这个沟的外侧",
  "music": 0.0
 },
 {
  "from": 75.3,
  "to": 77.1,
  "sid": 28,
  "location": 2,
  "content": "就是靠近这个地方啊",
  "music": 0.0
 },
 {
  "from": 77.1,
  "to": 78.32,
  "sid": 29,
  "location": 2,
  "content": "就是靠近这个地方",
  "music": 0.0
 },
 {
  "from": 78.34,
  "to": 79.66,
  "sid": 30,
  "location": 2,
  "content": "我们正常来说",
  "music": 0.0
 },
 {
  "from": 79.66,
  "to": 82.72,
  "sid": 31,
  "location": 2,
  "content": "我们正常来说是应该是在这个地方摸摸它呢",
  "music": 0.0
 },
 {
  "from": 82.72,
  "to": 83.77,
  "sid": 32,
  "location": 2,
  "content": "是在这个地方",
  "music": 0.0
 },
 {
  "from": 83.77,
  "to": 85.16,
  "sid": 33,
  "location": 2,
  "content": "还要靠外",
  "music": 0.0
 },
 {
  "from": 86.54,
  "to": 87.64,
  "sid": 34,
  "location": 2,
  "content": "这个反关脉呢",
  "music": 0.0
 },
 {
  "from": 87.64,
  "to": 92.14,
  "sid": 35,
  "location": 2,
  "content": "一般来说就是你只要摸到识别它是个反关脉",
  "music": 0.0
 },
 {
  "from": 92.14,
  "to": 95.84,
  "sid": 36,
  "location": 2,
  "content": "那就血气其实比在正常的位置还要好扎",
  "music": 0.0
 },
 {
  "from": 96.1,
  "to": 100.12,
  "sid": 37,
  "location": 2,
  "content": "他那个劳动脉跑到这个跑到这个外侧",
  "music": 0.0
 },
 {
  "from": 100.12,
  "to": 103.5,
  "sid": 38,
  "location": 2,
  "content": "就在鼓面皮下非常好扎",
  "music": 0.0
 },
 {
  "from": 103.7,
  "to": 106.32,
  "sid": 39,
  "location": 2,
  "content": "但是就怕你自己识别不到",
  "music": 0.0
 },
 {
  "from": 106.92,
  "to": 108.47,
  "sid": 40,
  "location": 2,
  "content": "摸了半天没摸到",
  "music": 0.0
 },
 {
  "from": 108.47,
  "to": 110.6,
  "sid": 41,
  "location": 2,
  "content": "在它正常的位置没有摸到",
  "music": 0.0
 },
 {
  "from": 111.8,
  "to": 116.8,
  "sid": 42,
  "location": 2,
  "content": "就以为这个病人的血气劳动脉很微弱",
  "music": 0.0
 },
 {
  "from": 118.0,
  "to": 120.63,
  "sid": 43,
  "location": 2,
  "content": "所以就没有扎成功",
  "music": 0.0
 },
 {
  "from": 120.63,
  "to": 122.94,
  "sid": 44,
  "location": 2,
  "content": "就在其他地方去扎血气",
  "music": 0.0
 },
 {
  "from": 123.22,
  "to": 125.2,
  "sid": 45,
  "location": 2,
  "content": "所以这种情况是很常见的",
  "music": 0.0
 },
 {
  "from": 125.2,
  "to": 128.66,
  "sid": 46,
  "location": 2,
  "content": "今天我又抓到了一粒",
  "music": 0.0
 },
 {
  "from": 128.759,
  "to": 131.339,
  "sid": 47,
  "location": 2,
  "content": "这个病人呢是从内蒙来的",
  "music": 0.0
 },
 {
  "from": 131.339,
  "to": 135.13,
  "sid": 48,
  "location": 2,
  "content": "是一个很高高壮壮的一个男性病人",
  "music": 0.0
 },
 {
  "from": 135.13,
  "to": 135.73,
  "sid": 49,
  "location": 2,
  "content": "呃",
  "music": 0.0
 },
 {
  "from": 135.73,
  "to": 138.49,
  "sid": 50,
  "location": 2,
  "content": "也是术前要扎一个血气",
  "music": 0.0
 },
 {
  "from": 138.49,
  "to": 140.36,
  "sid": 51,
  "location": 2,
  "content": "我去给他扎的时候呢",
  "music": 0.0
 },
 {
  "from": 140.36,
  "to": 142.5,
  "sid": 52,
  "location": 2,
  "content": "也是摸了半天都没摸到",
  "music": 0.0
 },
 {
  "from": 143.439,
  "to": 146.069,
  "sid": 53,
  "location": 2,
  "content": "但是看了这个病人呢也不会呃",
  "music": 0.0
 },
 {
  "from": 146.069,
  "to": 148.04,
  "sid": 54,
  "location": 2,
  "content": "嗯很壮实",
  "music": 0.0
 },
 {
  "from": 148.299,
  "to": 151.66,
  "sid": 55,
  "location": 2,
  "content": "也不是属于那种很危重的病人",
  "music": 0.0
 },
 {
  "from": 152.459,
  "to": 154.429,
  "sid": 56,
  "location": 2,
  "content": "病人就说我的脉搏",
  "music": 0.0
 },
 {
  "from": 154.429,
  "to": 157.6,
  "sid": 57,
  "location": 2,
  "content": "从我出生到现在一直都非常的弱",
  "music": 0.0
 },
 {
  "from": 158.04,
  "to": 159.75,
  "sid": 58,
  "location": 2,
  "content": "我就有点好奇",
  "music": 0.0
 },
 {
  "from": 159.75,
  "to": 161.82,
  "sid": 59,
  "location": 2,
  "content": "然后就一直在那摸",
  "music": 0.0
 },
 {
  "from": 161.82,
  "to": 164.52,
  "sid": 60,
  "location": 2,
  "content": "确实摸不到非常微弱",
  "music": 0.0
 },
 {
  "from": 164.52,
  "to": 168.899,
  "sid": 61,
  "location": 2,
  "content": "结果结果呢我就在想是不是反关脉啊",
  "music": 0.0
 },
 {
  "from": 168.899,
  "to": 171.779,
  "sid": 62,
  "location": 2,
  "content": "这个手稍微往他的这个手臂的外侧",
  "music": 0.0
 },
 {
  "from": 171.779,
  "to": 174.18,
  "sid": 63,
  "location": 2,
  "content": "手腕的外侧划了一下",
  "music": 0.0
 },
 {
  "from": 174.18,
  "to": 175.5,
  "sid": 64,
  "location": 2,
  "content": "结果就摸到了",
  "music": 0.0
 },
 {
  "from": 175.5,
  "to": 177.99,
  "sid": 65,
  "location": 2,
  "content": "是一个非常典型的反关脉",
  "music": 0.0
 },
 {
  "from": 177.99,
  "to": 181.54,
  "sid": 66,
  "location": 2,
  "content": "跟我19年扎的那个是一样的感觉",
  "music": 0.0
 },
 {
  "from": 182.2,
  "to": 183.96,
  "sid": 67,
  "location": 2,
  "content": "所以你识别出来以后",
  "music": 0.0
 },
 {
  "from": 183.96,
  "to": 185.1,
  "sid": 68,
  "location": 2,
  "content": "那就很好找了",
  "music": 0.0
 },
 {
  "from": 185.1,
  "to": 187.53,
  "sid": 69,
  "location": 2,
  "content": "他就在非常的标签",
  "music": 0.0
 },
 {
  "from": 187.53,
  "to": 188.73,
  "sid": 70,
  "location": 2,
  "content": "就在皮下",
  "music": 0.0
 },
 {
  "from": 188.73,
  "to": 191.08,
  "sid": 71,
  "location": 2,
  "content": "就跟我们平时扎静脉差不多",
  "music": 0.0
 },
 {
  "from": 191.16,
  "to": 195.279,
  "sid": 72,
  "location": 2,
  "content": "所以就非常号召在这里面给大家科普一下",
  "music": 0.0
 },
 {
  "from": 195.279,
  "to": 196.419,
  "sid": 73,
  "location": 2,
  "content": "这个反关脉呢",
  "music": 0.0
 },
 {
  "from": 196.419,
  "to": 199.77,
  "sid": 74,
  "location": 2,
  "content": "呃有这样的卖的人很少",
  "music": 0.0
 },
 {
  "from": 199.77,
  "to": 202.44,
  "sid": 75,
  "location": 2,
  "content": "反关脉本身是一种劳动脉的一种变异",
  "music": 0.0
 },
 {
  "from": 202.44,
  "to": 205.39,
  "sid": 76,
  "location": 2,
  "content": "他没有在我们所谓的大多数人出现的",
  "music": 0.0
 },
 {
  "from": 205.39,
  "to": 206.65,
  "sid": 77,
  "location": 2,
  "content": "那个位置呃",
  "music": 0.0
 },
 {
  "from": 206.65,
  "to": 208.26,
  "sid": 78,
  "location": 2,
  "content": "而是更靠外一些",
  "music": 0.0
 },
 {
  "from": 209.24,
  "to": 212.68,
  "sid": 79,
  "location": 2,
  "content": "所以今天呢给大家科普一下",
  "music": 0.0
 },
 {
  "from": 212.68,
  "to": 217.209,
  "sid": 80,
  "location": 2,
  "content": "如果呃有医学同道在临床上扎血气",
  "music": 0.0
 },
 {
  "from": 217.209,
  "to": 219.38,
  "sid": 81,
  "location": 2,
  "content": "扎桡动脉的血气啊",
  "music": 0.0
 },
 {
  "from": 219.38,
  "to": 220.52,
  "sid": 82,
  "location": 2,
  "content": "没有啊",
  "music": 0.0
 },
 {
  "from": 220.52,
  "to": 222.68,
  "sid": 83,
  "location": 2,
  "content": "在桡动脉正常的位置没有摸到的话",
  "music": 0.0
 },
 {
  "from": 222.68,
  "to": 225.549,
  "sid": 84,
  "location": 2,
  "content": "而且这个病人一般的情况嗯",
  "music": 0.0
 },
 {
  "from": 225.549,
  "to": 227.379,
  "sid": 85,
  "location": 2,
  "content": "还好当时说危重病",
  "music": 0.0
 },
 {
  "from": 227.379,
  "to": 228.459,
  "sid": 86,
  "location": 2,
  "content": "危重病人啊",
  "music": 0.0
 },
 {
  "from": 228.459,
  "to": 231.59,
  "sid": 87,
  "location": 2,
  "content": "循环比较弱的病人啊除外啊",
  "music": 0.0
 },
 {
  "from": 231.59,
  "to": 233.51,
  "sid": 88,
  "location": 2,
  "content": "如果说这个病人一般情况还行",
  "music": 0.0
 },
 {
  "from": 233.51,
  "to": 236.559,
  "sid": 89,
  "location": 2,
  "content": "是一个病情非常稳定的病人啊",
  "music": 0.0
 },
 {
  "from": 236.559,
  "to": 237.639,
  "sid": 90,
  "location": 2,
  "content": "生命体征也很好",
  "music": 0.0
 },
 {
  "from": 237.639,
  "to": 241.36,
  "sid": 91,
  "location": 2,
  "content": "但是呢摸着这个桡动脉就摸不到呃",
  "music": 0.0
 },
 {
  "from": 241.36,
  "to": 244.3,
  "sid": 92,
  "location": 2,
  "content": "这个时候大家一定要想一下是不是反关脉",
  "music": 0.0
 },
 {
  "from": 244.959,
  "to": 247.78,
  "sid": 93,
  "location": 2,
  "content": "我刚才那怕给大家说不清楚",
  "music": 0.0
 },
 {
  "from": 248.38,
  "to": 249.75,
  "sid": 94,
  "location": 2,
  "content": "就拿我这个手",
  "music": 0.0
 },
 {
  "from": 249.75,
  "to": 250.8,
  "sid": 95,
  "location": 2,
  "content": "我刚才画了一下",
  "music": 0.0
 },
 {
  "from": 250.8,
  "to": 252.45,
  "sid": 96,
  "location": 2,
  "content": "就拿我这个手来说吧",
  "music": 0.0
 },
 {
  "from": 252.45,
  "to": 253.96,
  "sid": 97,
  "location": 2,
  "content": "就这样的啊",
  "music": 0.0
 },
 {
  "from": 254.86,
  "to": 256.8,
  "sid": 98,
  "location": 2,
  "content": "这个位置可能好一点啊",
  "music": 0.0
 },
 {
  "from": 257.94,
  "to": 259.14,
  "sid": 99,
  "location": 2,
  "content": "啊我这个左手呢",
  "music": 0.0
 },
 {
  "from": 259.14,
  "to": 259.62,
  "sid": 100,
  "location": 2,
  "content": "正常来说",
  "music": 0.0
 },
 {
  "from": 259.62,
  "to": 263.32,
  "sid": 101,
  "location": 2,
  "content": "我这个脉搏应该是在这个地方摸这个桡动脉",
  "music": 0.0
 },
 {
  "from": 263.32,
  "to": 264.9,
  "sid": 102,
  "location": 2,
  "content": "其实我摸的就是桡动脉",
  "music": 0.0
 },
 {
  "from": 266.9,
  "to": 269.14,
  "sid": 103,
  "location": 2,
  "content": "正常人都走到这个位置啊",
  "music": 0.0
 },
 {
  "from": 269.14,
  "to": 270.46,
  "sid": 104,
  "location": 2,
  "content": "你看我这个手啊",
  "music": 0.0
 },
 {
  "from": 270.46,
  "to": 274.539,
  "sid": 105,
  "location": 2,
  "content": "用我们的食指和中指并排往这一大",
  "music": 0.0
 },
 {
  "from": 276.339,
  "to": 278.46,
  "sid": 106,
  "location": 2,
  "content": "其实是很明显的啊",
  "music": 0.0
 },
 {
  "from": 279.12,
  "to": 282.08,
  "sid": 107,
  "location": 2,
  "content": "但是呢你看我在这画了啊",
  "music": 0.0
 },
 {
  "from": 282.08,
  "to": 283.34,
  "sid": 108,
  "location": 2,
  "content": "就是这个大家可以看",
  "music": 0.0
 },
 {
  "from": 283.34,
  "to": 285.5,
  "sid": 109,
  "location": 2,
  "content": "就这个啊是在这个位置",
  "music": 0.0
 },
 {
  "from": 285.5,
  "to": 288.26,
  "sid": 110,
  "location": 2,
  "content": "但那个反关脉他就是在这里",
  "music": 0.0
 },
 {
  "from": 288.26,
  "to": 289.28,
  "sid": 111,
  "location": 2,
  "content": "他就是这样的",
  "music": 0.0
 },
 {
  "from": 289.8,
  "to": 291.32,
  "sid": 112,
  "location": 2,
  "content": "正常来说呢",
  "music": 0.0
 },
 {
  "from": 293.74,
  "to": 296.4,
