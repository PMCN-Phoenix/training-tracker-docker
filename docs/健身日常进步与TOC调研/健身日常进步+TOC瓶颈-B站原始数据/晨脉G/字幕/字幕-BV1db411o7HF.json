 },
 {
  "from": 3.52,
  "to": 4.899,
  "sid": 2,
  "location": 2,
  "content": "操作前准备",
  "music": 0.0
 },
 {
  "from": 8.3,
  "to": 11.92,
  "sid": 3,
  "location": 2,
  "content": "护士准备着装整齐洗手",
  "music": 0.0
 },
 {
  "from": 11.92,
  "to": 14.239,
  "sid": 4,
  "location": 2,
  "content": "备齐用物用物",
  "music": 0.0
 },
 {
  "from": 14.239,
  "to": 15.859,
  "sid": 5,
  "location": 2,
  "content": "准备治疗盘",
  "music": 0.0
 },
 {
  "from": 15.859,
  "to": 17.539,
  "sid": 6,
  "location": 2,
  "content": "内备有秒针的表",
  "music": 0.0
 },
 {
  "from": 17.539,
  "to": 20.359,
  "sid": 7,
  "location": 2,
  "content": "记录本和笔体温单",
  "music": 0.0
 },
 {
  "from": 20.359,
  "to": 22.86,
  "sid": 8,
  "location": 2,
  "content": "必要时被听诊器",
  "music": 0.0
 },
 {
  "from": 24.519,
  "to": 25.96,
  "sid": 9,
  "location": 2,
  "content": "操作步骤",
  "music": 0.0
 },
 {
  "from": 28.52,
  "to": 31.38,
  "sid": 10,
  "location": 2,
  "content": "致患者床旁安置体位",
  "music": 0.0
 },
 {
  "from": 31.38,
  "to": 34.83,
  "sid": 11,
  "location": 2,
  "content": "协助患者取坐位或卧位",
  "music": 0.0
 },
 {
  "from": 34.83,
  "to": 37.11,
  "sid": 12,
  "location": 2,
  "content": "手臂放于舒适位置",
  "music": 0.0
 },
 {
  "from": 37.11,
  "to": 38.559,
  "sid": 13,
  "location": 2,
  "content": "腕部伸展",
  "music": 0.0
 },
 {
  "from": 39.82,
  "to": 43.35,
  "sid": 14,
  "location": 2,
  "content": "根据病情选择测量部位和方法",
  "music": 0.0
 },
 {
  "from": 43.35,
  "to": 44.55,
  "sid": 15,
  "location": 2,
  "content": "测量脉搏",
  "music": 0.0
 },
 {
  "from": 44.55,
  "to": 48.54,
  "sid": 16,
  "location": 2,
  "content": "护士以是指中指和环指指端",
  "music": 0.0
 },
 {
  "from": 48.54,
  "to": 52.72,
  "sid": 17,
  "location": 2,
  "content": "按在桡动脉处或其他浅表大动脉处",
  "music": 0.0
 },
 {
  "from": 52.72,
  "to": 53.98,
  "sid": 18,
  "location": 2,
  "content": "压力大小",
  "music": 0.0
 },
 {
  "from": 53.98,
  "to": 57.43,
  "sid": 19,
  "location": 2,
  "content": "以能清楚触及脉搏搏动为宜",
  "music": 0.0
 },
 {
  "from": 57.43,
  "to": 59.81,
  "sid": 20,
  "location": 2,
  "content": "测量时间为30秒",
  "music": 0.0
 },
 {
  "from": 59.81,
  "to": 64.16,
  "sid": 21,
  "location": 2,
  "content": "将所测数值乘以二即为每分钟脉率",
  "music": 0.0
 },
 {
  "from": 64.16,
  "to": 67.46,
  "sid": 22,
  "location": 2,
  "content": "并应注意脉搏的节律及强弱",
  "music": 0.0
 },
 {
  "from": 67.46,
  "to": 70.95,
  "sid": 23,
  "location": 2,
  "content": "异常脉搏危重患者应测一分钟",
  "music": 0.0
 },
 {
  "from": 70.95,
  "to": 72.03,
  "sid": 24,
  "location": 2,
  "content": "脉搏细弱",
  "music": 0.0
 },
 {
  "from": 72.03,
  "to": 73.38,
  "sid": 25,
  "location": 2,
  "content": "难以触诊时",
  "music": 0.0
 },
 {
  "from": 73.38,
  "to": 76.41,
  "sid": 26,
  "location": 2,
  "content": "可用听诊器听诊心尖搏动",
  "music": 0.0
 },
 {
  "from": 76.41,
  "to": 78.6,
  "sid": 27,
  "location": 2,
  "content": "一分钟代替诊脉",
  "music": 0.0
 },
 {
  "from": 79.98,
  "to": 84.65,
  "sid": 28,
  "location": 2,
  "content": "脉搏短促的患者应由两名护士同时测量",
  "music": 0.0
 },
 {
  "from": 84.65,
  "to": 86.21,
  "sid": 29,
  "location": 2,
  "content": "一人听心率",
  "music": 0.0
 },
 {
  "from": 86.21,
  "to": 88.0,
  "sid": 30,
  "location": 2,
  "content": "另一人测脉率",
  "music": 0.0
 },
 {
  "from": 88.12,
  "to": 92.02,
  "sid": 31,
  "location": 2,
  "content": "由听新律者发出启停口令",
  "music": 0.0
 },
 {
  "from": 92.02,
  "to": 95.52,
  "sid": 32,
  "location": 2,
  "content": "二人同时开始计数一分钟",
  "music": 0.0
 },
 {
  "from": 96.48,
  "to": 97.8,
  "sid": 33,
  "location": 2,
  "content": "重要提示",
  "music": 0.0
 },
 {
  "from": 97.8,
  "to": 101.43,
  "sid": 34,
  "location": 2,
  "content": "注意不同病情脉搏的测量方法的选择",
  "music": 0.0
 },
 {
  "from": 101.43,
  "to": 103.2,
  "sid": 35,
  "location": 2,
  "content": "勿用拇指诊脉",
  "music": 0.0
 },
 {
  "from": 103.2,
  "to": 106.35,
  "sid": 36,
  "location": 2,
  "content": "因拇指小动脉的搏动较强",
  "music": 0.0
 },
 {
  "from": 106.35,
  "to": 108.93,
  "sid": 37,
  "location": 2,
  "content": "易与患者的脉搏相混淆",
  "music": 0.0
 },
 {
  "from": 108.93,
  "to": 113.759,
  "sid": 38,
  "location": 2,
  "content": "为偏瘫患者测量脉搏应选择健侧肢体",
  "music": 0.0
 },
 {
  "from": 114.42,
  "to": 116.99,
  "sid": 39,
  "location": 2,
  "content": "检查结果与病情不符时",
  "music": 0.0
 },
 {
  "from": 116.99,
  "to": 118.85,
  "sid": 40,
  "location": 2,
  "content": "应再检查一次",
  "music": 0.0
 },
 {
  "from": 118.85,
  "to": 119.96,
  "sid": 41,
  "location": 2,
  "content": "若有异常",
  "music": 0.0
 },
 {
  "from": 119.96,
  "to": 121.4,
  "sid": 42,
  "location": 2,
  "content": "立即通知医师",
  "music": 0.0
 },
 {
  "from": 121.4,
  "to": 123.34,
  "sid": 43,
  "location": 2,
  "content": "并与适当处理",
  "music": 0.0
 },
 {
  "from": 127.4,
  "to": 131.0,
  "sid": 44,
  "location": 2,
  "content": "协助患者取舒适卧位洗手",
  "music": 0.0
 },
 {
  "from": 133.58,
  "to": 136.0,
  "sid": 45,
  "location": 2,
  "content": "整理床单位及用物",
  "music": 0.0
 },
 {
  "from": 136.0,
  "to": 137.92,
  "sid": 46,
  "location": 2,
  "content": "放回保留物品",
  "music": 0.0
 },
 {
  "from": 143.3,
  "to": 146.56,
  "sid": 47,
  "location": 2,
  "content": "将测量结果绘制在体温单上",
  "music": 0.0
 },
 {
  "from": 156.279,
  "to": 157.84,
  "sid": 48,
  "location": 2,
  "content": "健康教育",
  "music": 0.0
 },
 {
  "from": 160.999,
  "to": 166.1,
  "sid": 49,
  "location": 2,
  "content": "一向患者解释避免影响脉搏测量的因素",
  "music": 0.0
 },
 {
  "from": 166.1,
  "to": 168.95,
  "sid": 50,
  "location": 2,
  "content": "测量脉搏前如有剧烈运动",
  "music": 0.0
 },
 {
  "from": 168.95,
  "to": 171.77,
  "sid": 51,
  "location": 2,
  "content": "紧张恐惧哭闹等",
  "music": 0.0
 },
 {
  "from": 171.77,
  "to": 175.5,
  "sid": 52,
  "location": 2,
  "content": "应休息20~30分钟后再测",
  "music": 0.0
 },
 {
  "from": 175.899,
  "to": 180.46,
  "sid": 53,
  "location": 2,
  "content": "二向患者讲解测量脉搏的注意事项",
  "music": 0.0
 }
]