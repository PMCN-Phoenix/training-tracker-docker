{
 "title": "什么是里程碑，如何编制项目里程碑计划？",
 "owner": "项目管理进度猫",
 "body": [
  {
   "from": 0.0,
   "to": 2.26,
   "sid": 1,
   "location": 2,
   "content": "里程碑是项目进程中的重要标记点",
   "music": 0.0
  },
  {
   "from": 2.26,
   "to": 3.98,
   "sid": 2,
   "location": 2,
   "content": "标志着项目在特定时间",
   "music": 0.0
  },
  {
   "from": 3.98,
   "to": 6.24,
   "sid": 3,
   "location": 2,
   "content": "达到了某个具有标志性意义的阶段",
   "music": 0.0
  },
  {
   "from": 6.24,
   "to": 8.12,
   "sid": 4,
   "location": 2,
   "content": "或完成了特定的关键成果",
   "music": 0.0
  },
  {
   "from": 8.12,
   "to": 9.6,
   "sid": 5,
   "location": 2,
   "content": "里程碑的三个特点",
   "music": 0.0
  },
  {
   "from": 9.6,
   "to": 10.32,
   "sid": 6,
   "location": 2,
   "content": "标志性",
   "music": 0.0
  },
  {
   "from": 10.32,
   "to": 13.6,
   "sid": 7,
   "location": 2,
   "content": "代表项目中的重大事件或关键成果的达成",
   "music": 0.0
  },
  {
   "from": 13.6,
   "to": 16.56,
   "sid": 8,
   "location": 2,
   "content": "清晰地展示项目的进展和阶段性成就",
   "music": 0.0
  },
  {
   "from": 16.56,
   "to": 20.2,
   "sid": 9,
   "location": 2,
   "content": "阶段性将项目的生命周期划分为不同的阶段",
   "music": 0.0
  },
  {
   "from": 20.2,
   "to": 22.4,
   "sid": 10,
   "location": 2,
   "content": "有助于项目团队和相关利益者",
   "music": 0.0
  },
  {
   "from": 22.4,
   "to": 25.0,
   "sid": 11,
   "location": 2,
   "content": "更好地理解项目的节奏和逻辑顺序",
   "music": 0.0
  },
  {
   "from": 25.0,
   "to": 26.0,
   "sid": 12,
   "location": 2,
   "content": "可衡量性",
   "music": 0.0
  },
  {
   "from": 26.0,
   "to": 29.36,
   "sid": 13,
   "location": 2,
   "content": "每个里程碑都有明确的完成标准或交付成果",
   "music": 0.0
  },
  {
   "from": 29.36,
   "to": 32.46,
   "sid": 14,
   "location": 2,
   "content": "能够通过客观的指标或检查点进行验证",
   "music": 0.0
  },
  {
   "from": 32.46,
   "to": 35.36,
   "sid": 15,
   "location": 2,
   "content": "以下是编写项目里程碑计划的步骤和要点",
   "music": 0.0
  },
  {
   "from": 35.36,
   "to": 37.46,
   "sid": 16,
   "location": 2,
   "content": "第一明确项目目标与范围",
   "music": 0.0
  },
  {
   "from": 37.46,
   "to": 39.08,
   "sid": 17,
   "location": 2,
   "content": "在设定里程碑之前",
   "music": 0.0
  },
  {
   "from": 39.08,
   "to": 41.72,
   "sid": 18,
   "location": 2,
   "content": "必须对项目的总体目标和涵盖范围",
   "music": 0.0
  },
  {
   "from": 41.72,
   "to": 42.86,
   "sid": 19,
   "location": 2,
   "content": "有清晰的理解",
   "music": 0.0
  },
  {
   "from": 42.86,
   "to": 45.42,
   "sid": 20,
   "location": 2,
   "content": "这包括确定项目的主要交付成果",
   "music": 0.0
  },
  {
   "from": 45.42,
   "to": 46.66,
   "sid": 21,
   "location": 2,
   "content": "预期的业务效益",
   "music": 0.0
  },
  {
   "from": 46.66,
   "to": 49.94,
   "sid": 22,
   "location": 2,
   "content": "以及项目涉及的关键业务领域或功能模块等",
   "music": 0.0
  },
  {
   "from": 49.94,
   "to": 52.75,
   "sid": 23,
   "location": 2,
   "content": "二分解项目工作机构WBS",
   "music": 0.0
  },
  {
   "from": 52.75,
   "to": 55.83,
   "sid": 24,
   "location": 2,
   "content": "将项目按照可管理的工作单元进行分解",
   "music": 0.0
  },
  {
   "from": 55.83,
   "to": 57.43,
   "sid": 25,
   "location": 2,
   "content": "形成工作分解结构",
   "music": 0.0
  },
  {
   "from": 57.43,
   "to": 59.71,
   "sid": 26,
   "location": 2,
   "content": "更有助于全面梳理项目任务",
   "music": 0.0
  },
  {
   "from": 59.71,
   "to": 62.32,
   "sid": 27,
   "location": 2,
   "content": "识别出关键的工作阶段和任务群组",
