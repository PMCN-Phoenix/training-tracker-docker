  },
  {
   "from": 135.94,
   "to": 139.5,
   "sid": 64,
   "location": 2,
   "content": "并在里程碑达成时组织相关的验收和交接工作",
   "music": 0.0
  },
  {
   "from": 139.5,
   "to": 141.4,
   "sid": 65,
   "location": 2,
   "content": "六里程碑评审与监控",
   "music": 0.0
  },
  {
   "from": 141.4,
   "to": 142.94,
   "sid": 66,
   "location": 2,
   "content": "建立里程碑评审机制",
