  },
  {
   "from": 66.64,
   "to": 67.84,
   "sid": 30,
   "location": 2,
   "content": "确定任务时间",
   "music": 0.0
  },
  {
   "from": 67.84,
   "to": 69.78,
   "sid": 31,
   "location": 2,
   "content": "例如对于软件开发项目",
   "music": 0.0
  },
  {
   "from": 69.78,
   "to": 72.16,
   "sid": 32,
   "location": 2,
   "content": "可以分解为需求分析设计",
   "music": 0.0
  },
  {
   "from": 72.16,
   "to": 73.24,
   "sid": 33,
   "location": 2,
   "content": "编码测试",
   "music": 0.0
  },
  {
   "from": 73.24,
   "to": 74.58,
   "sid": 34,
   "location": 2,
   "content": "上线部署等阶段",
   "music": 0.0
  },
  {
   "from": 74.58,
   "to": 76.68,
   "sid": 35,
   "location": 2,
   "content": "三确定关键里程碑事件",
   "music": 0.0
  },
  {
   "from": 76.68,
   "to": 79.19,
   "sid": 36,
   "location": 2,
   "content": "基于项目的WBS和业务流程",
   "music": 0.0
  },
  {
   "from": 79.19,
   "to": 81.17,
   "sid": 37,
   "location": 2,
   "content": "高选出具有标志性意义",
   "music": 0.0
  },
  {
   "from": 81.17,
   "to": 84.51,
   "sid": 38,
   "location": 2,
   "content": "能够代表项目重要进展阶段完成的关键事件",
   "music": 0.0
  },
  {
   "from": 84.51,
   "to": 85.37,
   "sid": 39,
   "location": 2,
   "content": "作为里程碑",
   "music": 0.0
  },
  {
   "from": 85.37,
   "to": 88.4,
   "sid": 40,
   "location": 2,
   "content": "那些事件通常是项目成果的重要交付点",
   "music": 0.0
  },
  {
   "from": 88.4,
   "to": 90.58,
   "sid": 41,
   "location": 2,
   "content": "阶段评审点或者关键决策点",
   "music": 0.0
  },
  {
   "from": 90.58,
   "to": 93.04,
   "sid": 42,
   "location": 2,
   "content": "例如项目启动里程碑标志",
