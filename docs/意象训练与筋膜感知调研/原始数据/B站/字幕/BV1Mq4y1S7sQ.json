{
 "title": "神经运动学入门（第一期）| α运动神经元 γ运动神经元 & 运动单位 & 肌纤维结构 & 高尔基腱体",
 "owner": "明朗的脑袋_Fiona",
 "duration": 547,
 "body": [
  {
   "from": 0.12,
   "to": 2.2,
   "sid": 1,
   "location": 2,
   "content": "倒水这一个看似简单的动作",
   "music": 0.0
  },
  {
   "from": 2.2,
   "to": 5.02,
   "sid": 2,
   "location": 2,
   "content": "其实包含了非常精妙的大脑调控机制",
   "music": 0.0
  },
  {
   "from": 5.02,
   "to": 7.96,
   "sid": 3,
   "location": 2,
   "content": "每时每刻杯子的重量都在发生改变",
   "music": 0.0
  },
  {
   "from": 7.96,
   "to": 9.379,
   "sid": 4,
   "location": 2,
   "content": "而为了保持稳定",
   "music": 0.0
  },
  {
   "from": 9.379,
   "to": 11.539,
   "sid": 5,
   "location": 2,
   "content": "我们的肌肉需要不断的接收反馈",
   "music": 0.0
  },
  {
   "from": 11.539,
   "to": 13.039,
   "sid": 6,
   "location": 2,
   "content": "并调整发力大小",
   "music": 0.0
  },
  {
   "from": 13.039,
   "to": 15.48,
   "sid": 7,
   "location": 2,
   "content": "我们的大脑是如何做到这一切的呢",
   "music": 0.0
  },
  {
   "from": 15.48,
   "to": 16.02,
   "sid": 8,
   "location": 2,
   "content": "哈喽大家好",
   "music": 0.0
  },
  {
   "from": 16.02,
   "to": 17.04,
   "sid": 9,
   "location": 2,
   "content": "我是明朗",
   "music": 0.0
  },
  {
   "from": 17.04,
   "to": 19.18,
   "sid": 10,
   "location": 2,
   "content": "我们来聊聊动神经系统",
   "music": 0.0
  },
  {
   "from": 19.18,
   "to": 21.74,
   "sid": 11,
   "location": 2,
   "content": "运动神经元通常可以分成两类",
   "music": 0.0
  },
  {
   "from": 21.74,
   "to": 24.44,
   "sid": 12,
   "location": 2,
   "content": "上运动神经元和下运动神经元",
   "music": 0.0
  },
  {
   "from": 24.44,
   "to": 27.68,
   "sid": 13,
   "location": 2,
   "content": "这里的上下可以通俗理解成人站立的时候",
   "music": 0.0
  },
  {
   "from": 27.68,
   "to": 28.57,
   "sid": 14,
   "location": 2,
   "content": "上下方位",
   "music": 0.0
  },
  {
   "from": 28.57,
   "to": 32.05,
   "sid": 15,
   "location": 2,
   "content": "上运动神经元的细胞体在脑袋或者运动皮质",
   "music": 0.0
  },
  {
   "from": 32.05,
   "to": 34.65,
   "sid": 16,
   "location": 2,
   "content": "它们的轴突可以直接延伸到脊髓",
   "music": 0.0
  },
  {
   "from": 34.65,
   "to": 36.96,
   "sid": 17,
   "location": 2,
   "content": "与下运动神经元突触接触",
   "music": 0.0
  },
  {
   "from": 36.96,
   "to": 40.26,
   "sid": 18,
   "location": 2,
   "content": "下运动神经元细胞体就在脊髓灰质中",
   "music": 0.0
  },
  {
   "from": 40.26,
   "to": 42.78,
   "sid": 19,
   "location": 2,
   "content": "如果看运动系统整体结构的话",
   "music": 0.0
  },
  {
   "from": 42.78,
   "to": 46.89,
   "sid": 20,
   "location": 2,
   "content": "运动皮质和脑干的上运动神经元发起运动指令",
   "music": 0.0
  },
  {
   "from": 46.89,
   "to": 48.3,
   "sid": 21,
   "location": 2,
   "content": "比方说高抬腿",
   "music": 0.0
  },
  {
   "from": 48.3,
   "to": 51.84,
   "sid": 22,
   "location": 2,
   "content": "同时机顶盒和小脑也会起到精准调控",
   "music": 0.0
  },
  {
   "from": 51.84,
   "to": 54.14,
   "sid": 23,
   "location": 2,
   "content": "反馈运动控制的作用",
   "music": 0.0
  },
  {
   "from": 54.14,
   "to": 57.94,
   "sid": 24,
   "location": 2,
   "content": "这些指令自上而下传导脊髓的下运动神经元",
   "music": 0.0
  },
  {
   "from": 57.94,
   "to": 60.28,
   "sid": 25,
   "location": 2,
   "content": "和一些脊髓局部的通路",
   "music": 0.0
  },
  {
   "from": 60.28,
   "to": 63.82,
   "sid": 26,
   "location": 2,
   "content": "最终下神经元将这些指令传递给肌肉",
   "music": 0.0
  },
  {
   "from": 63.82,
   "to": 64.819,
   "sid": 27,
   "location": 2,
   "content": "食指移动",
   "music": 0.0
  },
  {
   "from": 64.819,
   "to": 67.309,
   "sid": 28,
   "location": 2,
   "content": "同时感觉信息也会经由通路",
   "music": 0.0
  },
  {
   "from": 67.309,
   "to": 69.679,
   "sid": 29,
   "location": 2,
   "content": "从脊髓向上传导回大脑",
   "music": 0.0
  },
  {
   "from": 69.679,
   "to": 71.42,
   "sid": 30,
   "location": 2,
   "content": "来帮助我们调整指令",
   "music": 0.0
  },
  {
   "from": 71.42,
   "to": 74.12,
   "sid": 31,
   "location": 2,
   "content": "比方说踩在地毯上和平地上跑步",
   "music": 0.0
  },
  {
   "from": 74.12,
   "to": 75.47,
   "sid": 32,
   "location": 2,
   "content": "受到的反馈力不同",
   "music": 0.0
  },
  {
   "from": 75.47,
   "to": 78.62,
   "sid": 33,
   "location": 2,
   "content": "我们也会相应的调整肌肉控制",
   "music": 0.0
  },
  {
   "from": 78.62,
   "to": 80.51,
   "sid": 34,
   "location": 2,
   "content": "这期视频我们主要聊聊",
   "music": 0.0
  },
  {
   "from": 80.51,
   "to": 83.22,
   "sid": 35,
   "location": 2,
   "content": "和肌肉直接接触的下运动神经元",
   "music": 0.0
  },
  {
   "from": 83.22,
   "to": 85.08,
   "sid": 36,
   "location": 2,
   "content": "在之前的大脑解剖系列里",
   "music": 0.0
  },
  {
   "from": 85.08,
   "to": 89.04,
   "sid": 37,
   "location": 2,
   "content": "我们讲过脊髓中灰色的小蝴蝶部分就是灰质",
   "music": 0.0
  },
  {
   "from": 89.04,
   "to": 90.57,
   "sid": 38,
   "location": 2,
   "content": "而下端的副角",
   "music": 0.0
  },
  {
   "from": 90.57,
   "to": 93.48,
   "sid": 39,
   "location": 2,
   "content": "则汇集着我们下运动神经元的细胞体",
   "music": 0.0
  },
  {
   "from": 93.48,
   "to": 95.58,
   "sid": 40,
   "location": 2,
   "content": "从投射图上我们可以看到",
   "music": 0.0
  },
  {
   "from": 95.58,
   "to": 98.04,
   "sid": 41,
   "location": 2,
   "content": "不同脊髓区域的神经元数量不同",
   "music": 0.0
  },
  {
   "from": 98.04,
   "to": 100.52,
   "sid": 42,
   "location": 2,
   "content": "越密集就代表越精细的控制",
   "music": 0.0
  },
  {
   "from": 100.52,
   "to": 102.92,
   "sid": 43,
   "location": 2,
   "content": "绘制的腹侧角的下运动神经元",
   "music": 0.0
  },
  {
   "from": 102.92,
   "to": 104.38,
   "sid": 44,
   "location": 2,
   "content": "又可以细分成两种",
   "music": 0.0
  },
  {
   "from": 104.38,
   "to": 107.32,
   "sid": 45,
   "location": 2,
   "content": "alpha运动神经元和伽马运动神经元",
   "music": 0.0
  },
  {
   "from": 107.32,
   "to": 109.78,
   "sid": 46,
   "location": 2,
   "content": "alpha连接梭外肌纤维",
   "music": 0.0
  },
  {
   "from": 109.78,
   "to": 114.24,
   "sid": 47,
   "location": 2,
   "content": "而伽马连接激素或者也叫缩内肌纤维急缩",
   "music": 0.0
  },
  {
   "from": 114.24,
   "to": 115.5,
   "sid": 48,
   "location": 2,
   "content": "顾名思义就是这样的",
   "music": 0.0
  },
  {
   "from": 115.5,
   "to": 116.97,
   "sid": 49,
   "location": 2,
   "content": "像梭形的结构",
   "music": 0.0
  },
  {
   "from": 116.97,
   "to": 120.42,
   "sid": 50,
   "location": 2,
   "content": "主要起到传递感觉信息和运动反馈的作用",
   "music": 0.0
  },
  {
   "from": 120.42,
   "to": 123.12,
   "sid": 51,
   "location": 2,
   "content": "一般中间有8~10条的肌缩纤维",
   "music": 0.0
  },
  {
   "from": 123.12,
   "to": 125.789,
   "sid": 52,
   "location": 2,
   "content": "然后被层层外肌缩纤维包裹",
   "music": 0.0
  },
  {
   "from": 125.789,
   "to": 128.459,
   "sid": 53,
   "location": 2,
   "content": "蓝色的部分我们看到的是感觉神经元",
   "music": 0.0
  },
  {
   "from": 128.459,
   "to": 131.339,
   "sid": 54,
   "location": 2,
   "content": "而直接接触内肌缩纤维的红色神经元",
   "music": 0.0
  },
  {
   "from": 131.339,
   "to": 132.98,
   "sid": 55,
   "location": 2,
   "content": "就是伽马运动神经元",
   "music": 0.0
  },
  {
   "from": 132.98,
   "to": 135.38,
   "sid": 56,
   "location": 2,
   "content": "在详细讲运动神经元控制之前",
   "music": 0.0
  },
  {
   "from": 135.38,
   "to": 137.78,
   "sid": 57,
   "location": 2,
   "content": "我们先来仔细看看肌肉结构",
   "music": 0.0
  },
  {
   "from": 137.78,
   "to": 139.76,
   "sid": 58,
   "location": 2,
   "content": "大家应该吃过鸡丝凉面吧",
   "music": 0.0
  },
  {
   "from": 139.76,
   "to": 141.65,
   "sid": 59,
   "location": 2,
   "content": "或者很柴很柴的鸡胸肉",
   "music": 0.0
  },
  {
   "from": 141.65,
   "to": 145.84,
   "sid": 60,
   "location": 2,
   "content": "一条条塞牙的就是鸡数大块的肌肉由肌肉组成",
   "music": 0.0
  },
  {
   "from": 145.84,
   "to": 147.94,
   "sid": 61,
   "location": 2,
   "content": "每个基数有很多肌肉纤维",
   "music": 0.0
  },
  {
   "from": 147.94,
   "to": 151.45,
   "sid": 62,
   "location": 2,
   "content": "而每一根肌肉纤维也有很多肌原纤维组成",
   "music": 0.0
  },
  {
   "from": 151.45,
   "to": 155.4,
   "sid": 63,
   "location": 2,
   "content": "一根肌纤维只接受一个alpha运动神经元的指令",
   "music": 0.0
  },
  {
   "from": 155.4,
   "to": 157.47,
   "sid": 64,
   "location": 2,
   "content": "但是因为人体的肌纤维数量",
   "music": 0.0
  },
  {
   "from": 157.47,
   "to": 160.08,
   "sid": 65,
   "location": 2,
   "content": "远比脊髓的alpha运动神经元数量多",
   "music": 0.0
  },
  {
   "from": 160.08,
   "to": 163.98,
   "sid": 66,
   "location": 2,
   "content": "所以一个alpha运动神经元可以连接多个肌肉纤维",
   "music": 0.0
  },
  {
   "from": 163.98,
   "to": 166.77,
   "sid": 67,
   "location": 2,
   "content": "如果每个颜色代表一个alpha运动神经元的话",
   "music": 0.0
  },
  {
   "from": 166.77,
   "to": 168.42,
   "sid": 68,
   "location": 2,
   "content": "可以看到一块肌肉里",
   "music": 0.0
  },
  {
   "from": 168.42,
   "to": 171.3,
   "sid": 69,
   "location": 2,
   "content": "分布至多个受他控制的纤维",
   "music": 0.0
  },
  {
   "from": 171.3,
   "to": 175.26,
   "sid": 70,
   "location": 2,
   "content": "我们常把一个alpha神经元和受他控制的肌肉纤维",
   "music": 0.0
  },
  {
   "from": 175.26,
   "to": 177.37,
   "sid": 71,
   "location": 2,
   "content": "们成为一个motor unit",
   "music": 0.0
  },
  {
   "from": 177.37,
   "to": 178.45,
   "sid": 72,
   "location": 2,
   "content": "运动单位",
   "music": 0.0
  },
  {
   "from": 178.45,
   "to": 181.15,
   "sid": 73,
   "location": 2,
   "content": "不同的身体部位的运动单位比例不同",
   "music": 0.0
  },
  {
   "from": 181.15,
   "to": 185.16,
   "sid": 74,
   "location": 2,
   "content": "比方说小腿下侧的比目鱼肌对人体站立行走",
   "music": 0.0
  },
  {
   "from": 185.16,
   "to": 187.14,
   "sid": 75,
   "location": 2,
   "content": "保持体态起到了很重要的作用",
   "music": 0.0
  },
  {
   "from": 187.14,
   "to": 190.82,
   "sid": 76,
   "location": 2,
   "content": "平均一个运动神经元对接180条肌肉纤维",
   "music": 0.0
  },
  {
   "from": 190.82,
   "to": 194.09,
   "sid": 77,
   "location": 2,
   "content": "小腿上侧的腓肠肌需要承载大量的力",
   "music": 0.0
  },
  {
   "from": 194.09,
   "to": 195.78,
   "sid": 78,
   "location": 2,
   "content": "运动单位是一比2000",
   "music": 0.0
  },
  {
   "from": 195.78,
   "to": 199.44,
   "sid": 79,
   "location": 2,
   "content": "而眼眶的眼外肌运动单位需要精准的控制",
   "music": 0.0
  },
  {
   "from": 199.44,
   "to": 200.88,
   "sid": 80,
   "location": 2,
   "content": "然而是一比三",
   "music": 0.0
  },
  {
   "from": 200.88,
   "to": 202.89,
   "sid": 81,
   "location": 2,
   "content": "初中生物课大家应该学过",
   "music": 0.0
  },
  {
   "from": 202.89,
   "to": 205.08,
   "sid": 82,
   "location": 2,
   "content": "我们的身体里有不同类型的肌肉",
   "music": 0.0
  },
  {
   "from": 205.08,
   "to": 207.27,
   "sid": 83,
   "location": 2,
   "content": "通俗来说就是红肉和白肉",
   "music": 0.0
  },
  {
   "from": 207.27,
   "to": 210.04,
   "sid": 84,
   "location": 2,
   "content": "红肌纤维也叫做慢缩肌纤维",
   "music": 0.0
  },
  {
   "from": 210.04,
   "to": 211.21,
   "sid": 85,
   "location": 2,
   "content": "之所以是红色",
   "music": 0.0
  },
  {
   "from": 211.21,
   "to": 212.92,
   "sid": 86,
   "location": 2,
   "content": "是因为有很多血红蛋白",
   "music": 0.0
  },
  {
   "from": 212.92,
   "to": 215.04,
   "sid": 87,
   "location": 2,
   "content": "很多线粒体来产生能量",
   "music": 0.0
  },
  {
   "from": 215.04,
   "to": 216.33,
   "sid": 88,
   "location": 2,
   "content": "然而他们收缩的慢",
   "music": 0.0
  },
  {
   "from": 216.33,
   "to": 217.53,
   "sid": 89,
   "location": 2,
   "content": "但是累的也慢",
   "music": 0.0
  },
  {
   "from": 217.53,
   "to": 219.66,
   "sid": 90,
   "location": 2,
   "content": "可以说是长跑耐力型肌肉",
   "music": 0.0
  },
  {
   "from": 219.66,
   "to": 222.6,
   "sid": 91,
   "location": 2,
   "content": "而白肌纤维也叫快缩肌纤维",
   "music": 0.0
  },
  {
   "from": 222.6,
   "to": 223.56,
   "sid": 92,
   "location": 2,
   "content": "千里体少",
   "music": 0.0
  },
  {
   "from": 223.56,
   "to": 224.4,
   "sid": 93,
   "location": 2,
   "content": "收缩得快",
   "music": 0.0
  },
  {
   "from": 224.4,
   "to": 225.33,
   "sid": 94,
   "location": 2,
   "content": "累得也快",
   "music": 0.0
  },
  {
   "from": 225.33,
   "to": 227.67,
   "sid": 95,
   "location": 2,
   "content": "也就是冲刺型爆发肌肉",
   "music": 0.0
  },
  {
   "from": 227.67,
   "to": 229.44,
   "sid": 96,
   "location": 2,
   "content": "不知道大家在看奥运会的时候",
   "music": 0.0
  },
  {
   "from": 229.44,
   "to": 230.22,
   "sid": 97,
   "location": 2,
   "content": "有没有发现",
   "music": 0.0
  },
  {
   "from": 230.22,
   "to": 231.96,
   "sid": 98,
   "location": 2,
   "content": "马拉松运动员和短跑运动员",
   "music": 0.0
  },
  {
   "from": 231.96,
   "to": 234.09,
   "sid": 99,
   "location": 2,
   "content": "身材比例看起来不太一样",
   "music": 0.0
  },
  {
   "from": 234.09,
   "to": 235.56,
   "sid": 100,
   "location": 2,
   "content": "前者往往更瘦弱",
   "music": 0.0
  },
  {
   "from": 235.56,
   "to": 237.03,
   "sid": 101,
   "location": 2,
   "content": "而后者肌肉更多",
   "music": 0.0
  },
  {
   "from": 237.03,
   "to": 239.05,
   "sid": 102,
   "location": 2,
   "content": "的确很多实验发现",
   "music": 0.0
  },
  {
   "from": 239.05,
   "to": 242.35,
   "sid": 103,
   "location": 2,
   "content": "马拉松运动员的体内红肌纤维占大多数",
   "music": 0.0
  },
  {
   "from": 242.35,
   "to": 246.11,
   "sid": 104,
   "location": 2,
   "content": "而短跑运动员的肌肉白肌纤维占大多数",
   "music": 0.0
  },
  {
   "from": 246.11,
   "to": 248.06,
   "sid": 105,
