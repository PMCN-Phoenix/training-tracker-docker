  },
  {
    "from": 102.67,
    "to": 104.24,
    "sid": 64,
    "location": 2,
    "content": "高频率强刺激的反馈",
    "music": 0.0
  },
  {
    "from": 104.24,
    "to": 104.96,
    "sid": 65,
    "location": 2,
    "content": "久而久之",
