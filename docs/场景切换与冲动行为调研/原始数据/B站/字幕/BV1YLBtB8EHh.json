  },
  {
    "from": 130.06,
    "to": 131.55,
    "sid": 80,
    "location": 2,
    "content": "能但你要记住",
    "music": 0.0
  },
  {
    "from": 131.55,
    "to": 133.61,
    "sid": 81,
    "location": 2,
    "content": "真正的自由不是随心所欲",
    "music": 0.0
  },
  {
    "from": 133.61,
    "to": 137.1,
    "sid": 82,
    "location": 2,
    "content": "而是有能力对那些廉价的快感说不可拒绝",
