  },
  {
    "from": 108.98,
    "to": 110.5,
    "sid": 69,
    "location": 2,
    "content": "因为你只是在被动的接收",
    "music": 0.0
  },
  {
    "from": 110.5,
    "to": 111.96,
    "sid": 70,
    "location": 2,
    "content": "而不是在主动的创造",
    "music": 0.0
  },
  {
    "from": 111.96,
    "to": 113.42,
    "sid": 71,
    "location": 2,
    "content": "所以我变笨了",
    "music": 0.0
  },
  {
    "from": 113.42,
    "to": 116.56,
    "sid": 72,
    "location": 2,
    "content": "我变成了一个只会划屏幕的笨羊羊吗",
    "music": 0.0
  },
  {
    "from": 116.56,
    "to": 117.4,
    "sid": 73,
    "location": 2,
    "content": "甚至更糟",
