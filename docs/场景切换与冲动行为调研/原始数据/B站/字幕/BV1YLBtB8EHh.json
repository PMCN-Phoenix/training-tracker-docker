  },
  {
    "from": 69.8,
    "to": 71.92,
    "sid": 46,
    "location": 2,
    "content": "你就会像疯了一样一直拉下去",
    "music": 0.0
  },
  {
    "from": 71.92,
    "to": 74.52,
    "sid": 47,
    "location": 2,
    "content": "手机里的算法就是那个最懂你的赌局",
    "music": 0.0
  },
  {
    "from": 74.52,
    "to": 75.56,
    "sid": 48,
    "location": 2,
    "content": "太阴险了",
    "music": 0.0
  },
  {
    "from": 75.56,
    "to": 77.72,
    "sid": 49,
    "location": 2,
    "content": "那我不滑了行不行晚了",
    "music": 0.0
  },
  {
    "from": 77.72,
    "to": 79.78,
    "sid": 50,
    "location": 2,
    "content": "你的多巴胺阈值已经被拉爆了",
