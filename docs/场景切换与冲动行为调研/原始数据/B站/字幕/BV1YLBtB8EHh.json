[
  {
    "from": 0.04,
    "to": 2.32,
    "sid": 1,
    "location": 2,
    "content": "熊大快把我的手砍了",
    "music": 0.0
  },
  {
    "from": 2.32,
    "to": 3.38,
    "sid": 2,
    "location": 2,
    "content": "他中邪了",
    "music": 0.0
  },
  {
    "from": 3.38,
    "to": 4.77,
    "sid": 3,
    "location": 2,
    "content": "他不听使唤了",
    "music": 0.0
  },
  {
    "from": 4.77,
    "to": 6.83,
    "sid": 4,
    "location": 2,
    "content": "我看他是中了一种叫短视频的毒",
    "music": 0.0
  },
  {
    "from": 6.83,
    "to": 7.49,
    "sid": 5,
    "location": 2,
    "content": "叫你吃饭",
    "music": 0.0
  },
  {
    "from": 7.49,
    "to": 8.11,
    "sid": 6,
    "location": 2,
    "content": "教了三遍",
    "music": 0.0
  },
  {
    "from": 8.11,
    "to": 9.39,
    "sid": 7,
    "location": 2,
    "content": "你动都不动啊",
    "music": 0.0
  },
  {
    "from": 9.39,
    "to": 10.23,
    "sid": 8,
    "location": 2,
    "content": "天黑了",
    "music": 0.0
  },
  {
    "from": 10.23,
    "to": 12.81,
    "sid": 9,
    "location": 2,
    "content": "我发誓我刚才只是想看一眼闹钟",
    "music": 0.0
  },
  {
    "from": 12.81,
    "to": 15.17,
    "sid": 10,
    "location": 2,
    "content": "结果手自己就开始划划一下",
    "music": 0.0
  },
  {
    "from": 15.17,
    "to": 16.05,
    "sid": 11,
    "location": 2,
    "content": "嘿好笑",
    "music": 0.0
  },
  {
    "from": 16.05,
    "to": 16.93,
    "sid": 12,
    "location": 2,
    "content": "再划一下",
    "music": 0.0
  },
  {
    "from": 16.93,
    "to": 18.39,
    "sid": 13,
    "location": 2,
    "content": "嘿这个也好玩",
    "music": 0.0
  },
  {
    "from": 18.39,
    "to": 20.43,
    "sid": 14,
    "location": 2,
    "content": "你这一划三个小时就没了",
    "music": 0.0
  },
  {
    "from": 20.43,
    "to": 21.77,
    "sid": 15,
    "location": 2,
    "content": "你以为你在刷手机",
    "music": 0.1964285538903065
  },
  {
    "from": 21.77,
    "to": 22.95,
    "sid": 16,
    "location": 2,
    "content": "其实是手机在刷",
    "music": 0.0
  },
  {
    "from": 22.95,
    "to": 23.75,
    "sid": 17,
    "location": 2,
    "content": "你不对",
    "music": 0.0
  },
  {
    "from": 23.75,
    "to": 26.13,
    "sid": 18,
    "location": 2,
    "content": "手机里是不是住着吸魂兽",
    "music": 0.0
  },
  {
    "from": 26.13,
    "to": 28.03,
    "sid": 19,
    "location": 2,
    "content": "他把我的时间都吸干了",
    "music": 0.0
  },
  {
    "from": 28.03,
    "to": 28.89,
    "sid": 20,
    "location": 2,
    "content": "没什么怪兽",
    "music": 0.0
  },
  {
    "from": 28.89,
    "to": 30.91,
    "sid": 21,
    "location": 2,
    "content": "只有一群全世界最聪明的天才",
    "music": 0.0
  },
  {
    "from": 30.91,
    "to": 32.33,
    "sid": 22,
    "location": 2,
    "content": "利用你脑子里的多巴胺",
    "music": 0.03816793601771267
  },
  {
    "from": 32.33,
    "to": 34.13,
    "sid": 23,
    "location": 2,
    "content": "给你修了一座关不住你的牢房",
    "music": 0.35672512533771145
  },
  {
    "from": 34.13,
    "to": 34.91,
    "sid": 24,
    "location": 2,
    "content": "多巴胺",
    "music": 0.0
  },
  {
    "from": 34.91,
    "to": 37.21,
    "sid": 25,
    "location": 2,
    "content": "那不是让我开心的好东西吗",
    "music": 0.0
  },
  {
    "from": 37.21,
    "to": 39.01,
    "sid": 26,
    "location": 2,
    "content": "它是我快乐的源泉啊",
    "music": 0.0
  },
  {
    "from": 39.01,
    "to": 40.45,
    "sid": 27,
    "location": 2,
    "content": "这是一个巨大的误区",
    "music": 0.0
  },
  {
    "from": 40.45,
    "to": 41.89,
    "sid": 28,
    "location": 2,
    "content": "多巴胺不代表快乐",
    "music": 0.0
  },
  {
    "from": 41.89,
    "to": 43.81,
    "sid": 29,
    "location": 2,
    "content": "它只代表渴望渴望",
    "music": 0.0
  },
  {
    "from": 43.81,
    "to": 45.89,
    "sid": 30,
    "location": 2,
    "content": "难道不是因为我刷的爽",
    "music": 0.0
  },
  {
    "from": 45.89,
    "to": 47.28,
    "sid": 31,
    "location": 2,
    "content": "它才分泌的吗",
    "music": 0.0
  },
  {
    "from": 47.28,
    "to": 48.26,
    "sid": 32,
    "location": 2,
    "content": "恰恰相反",
    "music": 0.0
  },
  {
    "from": 48.26,
    "to": 50.34,
    "sid": 33,
    "location": 2,
    "content": "它是在你划一下之前分泌的",
    "music": 0.0
  },
  {
    "from": 50.34,
    "to": 51.86,
    "sid": 34,
    "location": 2,
    "content": "它像一根无形的鞭子",
    "music": 0.49999996621621606
  },
  {
    "from": 51.86,
    "to": 53.46,
    "sid": 35,
    "location": 2,
    "content": "在你大脑里疯狂抽打",
    "music": 0.0
  },
  {
    "from": 53.46,
    "to": 54.56,
    "sid": 36,
    "location": 2,
    "content": "逼着你去寻找",
    "music": 0.0
  },
  {
    "from": 54.56,
    "to": 55.24,
    "sid": 37,
    "location": 2,
    "content": "去探索",
    "music": 0.0
  },
  {
    "from": 55.24,
    "to": 57.72,
    "sid": 38,
    "location": 2,
    "content": "去期待下一条视频会不会更好笑",
    "music": 0.0
  },
  {
    "from": 57.72,
    "to": 60.07,
    "sid": 39,
    "location": 2,
    "content": "你是说我不是在享受",
    "music": 0.0
  },
  {
    "from": 60.07,
    "to": 61.27,
    "sid": 40,
    "location": 2,
    "content": "我是在上瘾",
    "music": 0.0
  },
  {
    "from": 61.27,
    "to": 64.35,
    "sid": 41,
    "location": 2,
    "content": "没错这在心理学上叫间歇性强化奖励",
    "music": 0.0
  },
  {
    "from": 64.35,
    "to": 65.35,
    "sid": 42,
    "location": 2,
    "content": "就像老虎机",
    "music": 0.0
  },
  {
    "from": 65.35,
    "to": 66.87,
    "sid": 43,
    "location": 2,
    "content": "如果你每拉一下都中奖",
    "music": 0.0
  },
  {
    "from": 66.87,
    "to": 67.98,
    "sid": 44,
    "location": 2,
    "content": "你很快就会腻",
    "music": 0.0
  },
  {
    "from": 67.98,
    "to": 69.8,
    "sid": 45,
    "location": 2,
    "content": "但如果你不知道哪一下会中奖",
