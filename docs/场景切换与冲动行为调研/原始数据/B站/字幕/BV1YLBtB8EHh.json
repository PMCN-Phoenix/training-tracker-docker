  },
  {
    "from": 104.96,
    "to": 106.1,
    "sid": 66,
    "location": 2,
    "content": "你不仅失去了耐心",
    "music": 0.0
  },
  {
    "from": 106.1,
    "to": 107.66,
    "sid": 67,
    "location": 2,
    "content": "还失去了深度思考的能力",
