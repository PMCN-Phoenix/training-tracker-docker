  },
  {
    "from": 36.72,
    "to": 37.78,
    "sid": 20,
    "location": 2,
    "content": "先等等",
    "music": 0.0
  },
  {
    "from": 37.78,
    "to": 39.6,
    "sid": 21,
    "location": 2,
    "content": "你得先搞明白一件事",
