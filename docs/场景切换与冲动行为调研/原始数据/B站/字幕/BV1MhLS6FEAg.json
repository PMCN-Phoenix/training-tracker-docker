[
  {
    "from": 0.08,
    "to": 1.8,
    "sid": 1,
    "location": 2,
    "content": "再刷最后一个视频我就睡",
    "music": 0.0
  },
  {
    "from": 1.8,
    "to": 3.6,
    "sid": 2,
    "location": 2,
    "content": "再奖励最后一次我就停",
    "music": 0.0
  },
  {
    "from": 3.6,
    "to": 5.31,
    "sid": 3,
    "location": 2,
    "content": "再说最后一更我就借",
    "music": 0.0
  },
  {
    "from": 5.31,
    "to": 7.09,
    "sid": 4,
    "location": 2,
    "content": "再吃最后一口我就解",
    "music": 0.0
  },
  {
    "from": 7.09,
    "to": 11.31,
    "sid": 5,
    "location": 2,
    "content": "于是乎你在酒瘾烟瘾性瘾毒饮食饮游戏瘾",
    "music": 0.0
  },
  {
    "from": 11.31,
    "to": 13.69,
    "sid": 6,
    "location": 2,
    "content": "手机瘾手艺饮中兜兜转转",
    "music": 0.0
  },
  {
    "from": 13.69,
    "to": 16.82,
    "sid": 7,
    "location": 2,
    "content": "在各种想借与破解之中来来回回",
    "music": 0.0
  },
  {
    "from": 16.82,
    "to": 18.98,
    "sid": 8,
    "location": 2,
    "content": "哪怕理智告诉你应该拒绝",
    "music": 0.0
  },
  {
    "from": 18.98,
    "to": 22.11,
    "sid": 9,
    "location": 2,
    "content": "但身体似乎已经不知道如何说不了",
    "music": 0.0
  },
  {
    "from": 22.11,
    "to": 24.45,
    "sid": 10,
    "location": 2,
    "content": "很多人把上瘾归为意志的薄弱",
    "music": 0.0
  },
  {
    "from": 24.45,
    "to": 26.65,
    "sid": 11,
    "location": 2,
    "content": "但真相远没有如此简单",
    "music": 0.0
  },
  {
    "from": 26.65,
    "to": 27.49,
    "sid": 12,
    "location": 2,
    "content": "本期内容",
    "music": 0.0
  },
  {
    "from": 27.49,
    "to": 30.75,
    "sid": 13,
    "location": 2,
    "content": "我们邀请了港中大精神科博士后程协作为主审",
    "music": 0.0
  },
  {
    "from": 30.75,
    "to": 33.05,
    "sid": 14,
    "location": 2,
    "content": "带你了解究竟什么是影",
    "music": 0.0
  },
  {
    "from": 33.05,
    "to": 34.07,
    "sid": 15,
    "location": 2,
    "content": "又是什么东西",
    "music": 0.0
  },
  {
    "from": 34.07,
    "to": 38.09,
    "sid": 16,
    "location": 2,
    "content": "让我们上映生活中有哪些精心设计的成瘾陷阱",
    "music": 0.0
  },
  {
    "from": 38.09,
    "to": 40.11,
    "sid": 17,
    "location": 2,
    "content": "我们又该如何运用科学的方式",
    "music": 0.0
  },
  {
    "from": 40.11,
    "to": 41.73,
    "sid": 18,
    "location": 2,
    "content": "夺回大脑的控制权",
    "music": 0.0
  },
  {
    "from": 41.73,
    "to": 43.67,
    "sid": 19,
    "location": 2,
    "content": "重新掌控自己的生活",
    "music": 0.0
  },
  {
    "from": 43.67,
    "to": 46.65,
    "sid": 20,
    "location": 2,
    "content": "一切的一切都要从那个被误解的快乐分子",
    "music": 0.0
  },
  {
    "from": 46.65,
    "to": 49.09,
    "sid": 21,
    "location": 2,
    "content": "多巴胺开始讲起",
    "music": 0.0
  },
  {
    "from": 52.1,
    "to": 54.34,
    "sid": 22,
    "location": 2,
    "content": "生活中你有没有过这样的经历",
    "music": 0.0
  },
  {
    "from": 54.34,
    "to": 55.72,
    "sid": 23,
    "location": 2,
    "content": "三块钱的冰镇可乐",
    "music": 0.0
  },
  {
    "from": 55.72,
    "to": 57.1,
    "sid": 24,
    "location": 2,
    "content": "第一口就值两块五",
    "music": 0.0
  },
  {
    "from": 57.1,
    "to": 58.93,
    "sid": 25,
    "location": 2,
    "content": "剩下的便乏善可陈",
    "music": 0.0
  },
  {
    "from": 58.93,
    "to": 60.69,
    "sid": 26,
    "location": 2,
    "content": "上班上学时期待着过年",
    "music": 0.0
  },
  {
    "from": 60.69,
    "to": 61.79,
    "sid": 27,
    "location": 2,
    "content": "等到真过年了",
    "music": 0.0
  },
  {
    "from": 61.79,
    "to": 62.97,
    "sid": 28,
    "location": 2,
    "content": "好像也就那样",
    "music": 0.0
  },
  {
    "from": 62.97,
    "to": 64.959,
    "sid": 29,
    "location": 2,
    "content": "甚至一年比一年失望",
    "music": 0.0
  },
  {
    "from": 64.959,
    "to": 67.279,
    "sid": 30,
    "location": 2,
    "content": "爱情最美好的时候莫如初见",
    "music": 0.0
  },
  {
    "from": 67.279,
    "to": 68.319,
    "sid": 31,
    "location": 2,
    "content": "等双方熟悉了",
    "music": 0.0
  },
  {
    "from": 68.319,
    "to": 69.519,
    "sid": 32,
    "location": 2,
    "content": "彼此没了惊喜",
    "music": 0.0
  },
  {
    "from": 69.519,
    "to": 72.269,
    "sid": 33,
    "location": 2,
    "content": "又往往容易变却故人心魔",
    "music": 0.0
  },
  {
    "from": 72.269,
    "to": 73.909,
    "sid": 34,
    "location": 2,
    "content": "为何对这些充满期待",
    "music": 0.0
  },
  {
    "from": 73.909,
    "to": 76.569,
    "sid": 35,
    "location": 2,
    "content": "又为何总在得到之后意兴阑珊",
    "music": 0.0
  },
  {
    "from": 76.569,
    "to": 79.49,
    "sid": 36,
    "location": 2,
    "content": "这背后观念的推手便是多巴胺",
    "music": 0.0
  },
  {
    "from": 79.49,
    "to": 82.29,
    "sid": 37,
    "location": 2,
    "content": "如果你在网上搜索多巴胺大量的文章",
    "music": 0.0
  },
  {
    "from": 82.29,
    "to": 83.47,
    "sid": 38,
    "location": 2,
    "content": "会告诉你同一件事",
    "music": 0.0
  },
  {
    "from": 83.47,
    "to": 86.21,
    "sid": 39,
    "location": 2,
    "content": "这是大脑的快乐分子分泌的越多",
    "music": 0.0
  },
  {
    "from": 86.21,
    "to": 87.33,
    "sid": 40,
    "location": 2,
    "content": "你就越快乐",
    "music": 0.0
  },
  {
    "from": 87.33,
    "to": 89.93,
    "sid": 41,
    "location": 2,
    "content": "但事实真的是这样吗",
    "music": 0.0
  },
  {
    "from": 90.13,
    "to": 91.57,
    "sid": 42,
    "location": 2,
    "content": "20世纪90年代",
    "music": 0.0
  },
  {
    "from": 91.57,
    "to": 94.73,
    "sid": 43,
    "location": 2,
    "content": "瑞士弗里堡大学的神经学家沃尔弗朗姆舒尔茨",
    "music": 0.0
  },
  {
    "from": 94.73,
    "to": 97.15,
    "sid": 44,
    "location": 2,
    "content": "在猴子身上进行了一系列的实验",
    "music": 0.0
  },
  {
    "from": 97.15,
    "to": 99.69,
    "sid": 45,
    "location": 2,
    "content": "它们在毫无征兆的情况下给猴子果汁",
    "music": 0.0
  },
  {
    "from": 99.69,
    "to": 101.57,
    "sid": 46,
    "location": 2,
    "content": "猴子在喝到意料之外的果汁后",
    "music": 0.0
  },
  {
    "from": 101.57,
    "to": 103.76,
    "sid": 47,
    "location": 2,
    "content": "多半神经元活动显著增强",
    "music": 0.0
  },
  {
    "from": 103.76,
    "to": 107.08,
    "sid": 48,
    "location": 2,
    "content": "乍一看多半似乎就是负责奖励的快乐分子",
    "music": 0.0
  },
  {
    "from": 107.08,
    "to": 109.68,
    "sid": 49,
    "location": 2,
    "content": "然而在研究人员改变发放策略后",
    "music": 0.0
  },
  {
    "from": 109.68,
    "to": 112.06,
    "sid": 50,
    "location": 2,
    "content": "却发现事实并没有如此简单",
    "music": 0.0
  },
  {
    "from": 112.06,
    "to": 114.48,
    "sid": 51,
    "location": 2,
    "content": "他们在给猴子果汁前先亮起了一盏灯",
    "music": 0.0
  },
  {
    "from": 114.48,
    "to": 115.64,
    "sid": 52,
    "location": 2,
    "content": "并且重复多次",
    "music": 0.0
  },
  {
    "from": 115.64,
    "to": 117.34,
    "sid": 53,
    "location": 2,
    "content": "让猴子确信灯亮了",
    "music": 0.0
  },
  {
    "from": 117.34,
    "to": 118.55,
    "sid": 54,
    "location": 2,
    "content": "马上就有果汁喝",
    "music": 0.0
  },
  {
    "from": 118.55,
    "to": 120.95,
    "sid": 55,
    "location": 2,
    "content": "接下来神奇的事情发生了",
    "music": 0.0
  },
  {
    "from": 120.95,
    "to": 124.039,
    "sid": 56,
    "location": 2,
    "content": "多巴胺神经元活动增强的时间提前了",
    "music": 0.0
  },
  {
    "from": 124.039,
    "to": 126.259,
    "sid": 57,
    "location": 2,
    "content": "猴子不是在喝到果汁的时候兴奋",
    "music": 0.0
  },
  {
    "from": 126.259,
    "to": 128.72,
    "sid": 58,
    "location": 2,
    "content": "而是在灯亮的瞬间就高度兴奋",
    "music": 0.0
  },
  {
    "from": 128.72,
    "to": 130.36,
    "sid": 59,
    "location": 2,
    "content": "等真正喝到果汁的时候",
    "music": 0.0
  },
  {
    "from": 130.36,
    "to": 132.24,
    "sid": 60,
    "location": 2,
    "content": "多巴胺反而没有额外增多",
    "music": 0.0
  },
  {
    "from": 132.24,
    "to": 134.42,
    "sid": 61,
    "location": 2,
    "content": "因为这已经在他的意料之中",
    "music": 0.0
  },
  {
    "from": 134.42,
    "to": 135.46,
    "sid": 62,
    "location": 2,
    "content": "更有趣的是",
    "music": 0.0
  },
  {
    "from": 135.46,
    "to": 136.7,
    "sid": 63,
    "location": 2,
    "content": "实验的第三阶段",
    "music": 0.0
  },
  {
    "from": 136.7,
    "to": 137.74,
    "sid": 64,
    "location": 2,
    "content": "如果灯亮了",
    "music": 0.0
  },
  {
    "from": 137.74,
    "to": 138.82,
    "sid": 65,
    "location": 2,
    "content": "但该给果汁的时候",
    "music": 0.0
  },
  {
    "from": 138.82,
    "to": 142.079,
    "sid": 66,
    "location": 2,
    "content": "没给猴子的多巴胺神经元活动甚至会下降",
    "music": 0.0
  },
  {
    "from": 142.079,
    "to": 144.999,
    "sid": 67,
    "location": 2,
    "content": "舒尔茨据此提出了一个改写教科书的结论",
    "music": 0.0
  },
  {
    "from": 144.999,
    "to": 146.51,
    "sid": 68,
    "location": 2,
    "content": "奖赏预测误差",
    "music": 0.0
  },
  {
    "from": 146.51,
    "to": 147.29,
    "sid": 69,
    "location": 2,
    "content": "他认为",
    "music": 0.0
  },
  {
    "from": 147.29,
    "to": 148.65,
    "sid": 70,
    "location": 2,
    "content": "多巴胺在奖赏系统中",
    "music": 0.0
  },
  {
    "from": 148.65,
    "to": 150.87,
    "sid": 71,
    "location": 2,
    "content": "主要负责编码的并非快乐本身",
    "music": 0.0
  },
  {
    "from": 150.87,
    "to": 153.1,
    "sid": 72,
    "location": 2,
    "content": "而是预期与现实之间的落差",
    "music": 0.0
  },
  {
    "from": 153.1,
    "to": 154.46,
    "sid": 73,
    "location": 2,
    "content": "当得到大于预期",
    "music": 0.0
  },
  {
    "from": 154.46,
    "to": 156.02,
    "sid": 74,
    "location": 2,
    "content": "多巴胺就会大幅上升",
    "music": 0.0
  },
  {
    "from": 156.02,
    "to": 158.5,
    "sid": 75,
    "location": 2,
    "content": "促使我们记住并重复该行为",
    "music": 0.0
  },
  {
    "from": 158.5,
    "to": 160.34,
    "sid": 76,
    "location": 2,
    "content": "如果得到的等于预期",
    "music": 0.0
  },
  {
    "from": 160.34,
    "to": 161.74,
    "sid": 77,
    "location": 2,
    "content": "多巴胺则表现平稳",
    "music": 0.0
  },
  {
    "from": 161.74,
    "to": 162.86,
    "sid": 78,
    "location": 2,
    "content": "不再感到兴奋",
    "music": 0.0
  },
  {
    "from": 162.86,
    "to": 164.5,
    "sid": 79,
    "location": 2,
    "content": "当得到的小于预期",
    "music": 0.0
  },
  {
    "from": 164.5,
    "to": 165.68,
    "sid": 80,
    "location": 2,
    "content": "多巴胺就会下降",
    "music": 0.0
  },
  {
    "from": 165.68,
    "to": 167.26,
    "sid": 81,
    "location": 2,
    "content": "促使我们调整策略",
    "music": 0.0
  },
  {
    "from": 167.26,
    "to": 169.14,
    "sid": 82,
    "location": 2,
    "content": "减少该行为的选择倾向",
    "music": 0.0
  },
  {
    "from": 169.14,
    "to": 171.38,
    "sid": 83,
    "location": 2,
    "content": "多巴胺驱动着我们去寻找食物",
    "music": 0.0
  },
  {
    "from": 171.38,
    "to": 172.44,
    "sid": 84,
    "location": 2,
    "content": "去探索未知",
    "music": 0.0
  },
  {
    "from": 172.44,
    "to": 173.12,
    "sid": 85,
    "location": 2,
    "content": "去追求",
    "music": 0.0
  },
  {
    "from": 173.12,
    "to": 173.9,
    "sid": 86,
    "location": 2,
    "content": "去渴望",
    "music": 0.0
  },
  {
    "from": 173.9,
    "to": 177.2,
    "sid": 87,
    "location": 2,
    "content": "但似乎并没有教给我们如何感受幸福",
    "music": 0.0
  },
  {
    "from": 177.2,
    "to": 179.0,
    "sid": 88,
    "location": 2,
    "content": "怪不得叔本华才会说",
    "music": 0.0
  },
  {
    "from": 179.0,
    "to": 182.08,
    "sid": 89,
    "location": 2,
    "content": "人生就像钟摆在痛苦和无聊间摇摆",
    "music": 0.0
  },
  {
    "from": 182.08,
    "to": 184.06,
    "sid": 90,
    "location": 2,
    "content": "欲望得不到满足是痛苦",
    "music": 0.0
  },
  {
    "from": 184.06,
    "to": 185.98,
    "sid": 91,
    "location": 2,
    "content": "欲望得到满足后是无聊",
    "music": 0.0
  },
  {
    "from": 185.98,
    "to": 187.58,
    "sid": 92,
    "location": 2,
    "content": "因为你无论得到什么",
    "music": 0.0
  },
  {
    "from": 187.58,
    "to": 188.8,
    "sid": 93,
    "location": 2,
    "content": "在短暂的信奉后",
    "music": 0.0
  },
  {
    "from": 188.8,
    "to": 191.41,
    "sid": 94,
    "location": 2,
    "content": "一切就会逐渐变得理所当然",
    "music": 0.0
  },
  {
    "from": 191.41,
    "to": 192.59,
    "sid": 95,
    "location": 2,
    "content": "已经拥有的东西",
    "music": 0.0
  },
  {
    "from": 192.59,
    "to": 195.39,
    "sid": 96,
    "location": 2,
    "content": "会慢慢成为下次计算奖励误差的预期期限",
    "music": 0.0
  },
  {
    "from": 195.39,
    "to": 197.09,
    "sid": 97,
    "location": 2,
    "content": "预期之上才算奖励",
    "music": 0.0
  },
  {
    "from": 197.09,
    "to": 199.1,
    "sid": 98,
    "location": 2,
    "content": "预期以下就变成了失落",
    "music": 0.0
  },
  {
    "from": 199.1,
    "to": 201.08,
    "sid": 99,
    "location": 2,
    "content": "所以纳兰容若才会说",
    "music": 0.0
  },
  {
    "from": 201.08,
    "to": 202.72,
    "sid": 100,
    "location": 2,
    "content": "人生若只如初见",
    "music": 0.0
  },
  {
    "from": 202.72,
    "to": 204.48,
    "sid": 101,
    "location": 2,
    "content": "何事秋风悲画扇",
    "music": 0.0
  },
  {
    "from": 204.48,
    "to": 205.94,
    "sid": 102,
    "location": 2,
    "content": "等闲变却故人心",
    "music": 0.0
  },
  {
    "from": 205.94,
    "to": 207.89,
    "sid": 103,
    "location": 2,
    "content": "却道故人心易变",
    "music": 0.0
  },
  {
    "from": 207.89,
    "to": 209.31,
    "sid": 104,
    "location": 2,
    "content": "乍见之欢易得",
    "music": 0.0
  },
  {
    "from": 209.31,
    "to": 211.15,
    "sid": 105,
    "location": 2,
    "content": "久处不厌难求",
    "music": 0.0
  },
  {
    "from": 211.15,
    "to": 213.33,
    "sid": 106,
    "location": 2,
    "content": "怪不得张爱玲才会说",
    "music": 0.0
  },
  {
    "from": 213.33,
    "to": 215.89,
    "sid": 107,
    "location": 2,
    "content": "也许每个男人都有过这样两个女子",
    "music": 0.0
  },
  {
    "from": 215.89,
    "to": 216.91,
    "sid": 108,
    "location": 2,
    "content": "娶了红玫瑰",
    "music": 0.0
  },
