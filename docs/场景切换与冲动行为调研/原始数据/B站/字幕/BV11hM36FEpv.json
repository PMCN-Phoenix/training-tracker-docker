[
  {
    "from": 5.04,
    "to": 7.34,
    "sid": 1,
    "location": 2,
    "content": "你会和自己打架吗",
    "music": 0.0
  },
  {
    "from": 7.34,
    "to": 8.76,
    "sid": 2,
    "location": 2,
    "content": "我会啊",
    "music": 0.0
  },
  {
    "from": 8.76,
    "to": 11.49,
    "sid": 3,
    "location": 2,
    "content": "左右互搏反刍",
    "music": 0.0
  },
  {
    "from": 11.49,
    "to": 14.659,
    "sid": 4,
    "location": 2,
    "content": "以前的我呀没什么事的时候",
    "music": 0.0
  },
  {
    "from": 14.659,
    "to": 16.619,
    "sid": 5,
    "location": 2,
    "content": "就会去想三天前",
    "music": 0.0
  },
  {
    "from": 16.619,
    "to": 21.13,
    "sid": 6,
    "location": 2,
    "content": "一周前甚至是一个月之前的某个情景啊",
    "music": 0.0
  },
  {
    "from": 21.13,
    "to": 23.119,
    "sid": 7,
    "location": 2,
    "content": "反复的评判",
    "music": 0.0
  },
  {
    "from": 23.119,
    "to": 27.259,
    "sid": 8,
    "location": 2,
    "content": "比如说啊当时我那句话说的好不好啊",
    "music": 0.0
  },
  {
    "from": 27.259,
    "to": 28.639,
    "sid": 9,
    "location": 2,
    "content": "我换个语气",
    "music": 0.0
  },
  {
    "from": 28.639,
    "to": 31.52,
    "sid": 10,
    "location": 2,
    "content": "换一句话会不会更好啊",
    "music": 0.0
  },
  {
    "from": 31.52,
    "to": 33.68,
    "sid": 11,
    "location": 2,
    "content": "反反复复的琢磨",
    "music": 0.0
  },
  {
    "from": 33.68,
    "to": 37.44,
    "sid": 12,
    "location": 2,
    "content": "有的时候啊睡觉之前都要想个半个小时",
    "music": 0.0
  },
  {
    "from": 37.44,
    "to": 39.74,
    "sid": 13,
    "location": 2,
    "content": "一个小时甚至更久",
    "music": 0.0
  },
  {
    "from": 39.74,
    "to": 41.74,
    "sid": 14,
    "location": 2,
    "content": "影响到我的睡眠啊",
    "music": 0.0
  },
  {
    "from": 41.74,
    "to": 43.46,
    "sid": 15,
    "location": 2,
    "content": "让自己睡不着",
    "music": 0.0
  },
  {
    "from": 43.46,
    "to": 47.16,
    "sid": 16,
    "location": 2,
    "content": "我自己也知道说这种不断的回味",
    "music": 0.0
  },
  {
    "from": 47.16,
    "to": 48.4,
    "sid": 17,
    "location": 2,
    "content": "不断的反刍",
    "music": 0.0
  },
  {
    "from": 48.4,
    "to": 49.86,
    "sid": 18,
    "location": 2,
    "content": "它并没有什么意义",
    "music": 0.0
  },
  {
    "from": 49.86,
    "to": 51.26,
    "sid": 19,
    "location": 2,
    "content": "没有任何作用",
    "music": 0.0
  },
  {
    "from": 51.26,
    "to": 53.52,
    "sid": 20,
    "location": 2,
    "content": "但是呢就是停不下来",
    "music": 0.0
  },
  {
    "from": 53.52,
    "to": 55.86,
    "sid": 21,
    "location": 2,
    "content": "你有类似的情景吗",
    "music": 0.0
  },
  {
    "from": 55.86,
    "to": 60.41,
    "sid": 22,
    "location": 2,
    "content": "哈哈其实啊你脑子里面有一套物理回路",
    "music": 0.0
  },
  {
    "from": 60.41,
    "to": 62.73,
    "sid": 23,
    "location": 2,
    "content": "在你什么都不做的时候",
    "music": 0.0
  },
  {
    "from": 62.73,
    "to": 64.66,
    "sid": 24,
    "location": 2,
    "content": "它就会自动点火",
    "music": 0.0
  },
  {
    "from": 64.66,
    "to": 67.84,
    "sid": 25,
    "location": 2,
    "content": "专门啊把你给拽回过去",
    "music": 0.0
  },
  {
    "from": 67.84,
    "to": 70.63,
    "sid": 26,
    "location": 2,
    "content": "它叫做默认模式网络",
    "music": 0.0
  },
  {
    "from": 70.63,
    "to": 73.23,
    "sid": 27,
    "location": 2,
    "content": "你越是躺着什么都不做的时候",
    "music": 0.0
  },
  {
    "from": 73.23,
    "to": 75.15,
    "sid": 28,
    "location": 2,
    "content": "哎他呀越是活跃",
    "music": 0.0
  },
  {
    "from": 75.15,
    "to": 79.26,
    "sid": 29,
    "location": 2,
    "content": "把你三天前说错的某一句话翻出来",
    "music": 0.0
  },
  {
    "from": 79.26,
    "to": 80.74,
    "sid": 30,
    "location": 2,
    "content": "反复的回放",
    "music": 0.0
  },
  {
    "from": 80.74,
    "to": 82.48,
    "sid": 31,
    "location": 2,
    "content": "所谓的反刍啊",
    "music": 0.0
  },
  {
    "from": 82.48,
    "to": 85.77,
    "sid": 32,
    "location": 2,
    "content": "就是这套电路的自动运行",
    "music": 0.0
  },
  {
    "from": 85.77,
    "to": 87.79,
    "sid": 33,
    "location": 2,
    "content": "那硬件就是这样",
    "music": 0.0
  },
  {
    "from": 87.79,
    "to": 89.85,
    "sid": 34,
    "location": 2,
    "content": "你的大脑在空闲的时候",
    "music": 0.0
  },
  {
    "from": 89.85,
    "to": 92.41,
    "sid": 35,
    "location": 2,
    "content": "它会自动开启审判模式",
    "music": 0.0
  },
  {
    "from": 92.41,
    "to": 94.2,
    "sid": 36,
    "location": 2,
    "content": "而我后来啊",
    "music": 0.0
  },
  {
    "from": 94.2,
    "to": 97.9,
    "sid": 37,
    "location": 2,
    "content": "是怎么从这台审判机器里面脱身的呢",
    "music": 0.0
  },
  {
    "from": 97.9,
    "to": 101.63,
    "sid": 38,
    "location": 2,
    "content": "啊答案藏在一个更深的发现里面",
    "music": 0.0
  },
  {
    "from": 101.63,
    "to": 105.02,
    "sid": 39,
    "location": 2,
    "content": "我体内不止一个人",
    "music": 0.0
  },
  {
    "from": 105.02,
    "to": 108.98,
    "sid": 40,
    "location": 2,
    "content": "这个机制让我们持续不断的回味过去",
    "music": 0.0
  },
  {
    "from": 108.98,
    "to": 111.38,
    "sid": 41,
    "location": 2,
    "content": "甚至陷入一种不停的自我审判",
    "music": 0.0
  },
  {
    "from": 111.38,
    "to": 114.26,
    "sid": 42,
    "location": 2,
    "content": "就好像本来好好过着日子",
    "music": 0.0
  },
  {
    "from": 114.26,
    "to": 117.86,
    "sid": 43,
    "location": 2,
    "content": "但是身体里面却多出来了一个审判官",
    "music": 0.0
  },
  {
    "from": 118.86,
    "to": 122.43,
    "sid": 44,
    "location": 2,
    "content": "那么如果再进一步挖掘的话",
    "music": 0.0
  },
  {
    "from": 122.43,
    "to": 128.16,
    "sid": 45,
    "location": 2,
    "content": "我们身体里面的角色可不只有审判官一个",
    "music": 0.0
  },
  {
    "from": 128.16,
    "to": 132.8,
    "sid": 46,
    "location": 2,
    "content": "我们身体里面呀冲突时时刻刻都在上演啊",
    "music": 0.0
  },
  {
    "from": 132.8,
    "to": 133.52,
    "sid": 47,
    "location": 2,
    "content": "举个例子",
    "music": 0.0
  },
  {
    "from": 133.52,
    "to": 136.11,
    "sid": 48,
    "location": 2,
    "content": "你今天去超市买酸奶",
    "music": 0.0
  },
  {
    "from": 136.11,
    "to": 137.39,
    "sid": 49,
    "location": 2,
    "content": "两个口味之间",
    "music": 0.0
  },
  {
    "from": 137.39,
    "to": 138.53,
    "sid": 50,
    "location": 2,
    "content": "你去选啊",
    "music": 0.0
  },
  {
    "from": 138.53,
    "to": 141.55,
    "sid": 51,
    "location": 2,
    "content": "比如说啊假设是你最喜欢的两个口味",
    "music": 0.0
  },
  {
    "from": 141.55,
    "to": 142.87,
    "sid": 52,
    "location": 2,
    "content": "草莓和巧克力",
    "music": 0.0
  },
  {
    "from": 142.87,
    "to": 145.7,
    "sid": 53,
    "location": 2,
    "content": "你不知道今天到底买哪个回家",
    "music": 0.0
  },
  {
    "from": 145.7,
    "to": 149.02,
    "sid": 54,
    "location": 2,
    "content": "你会感觉两边都有一个声音",
    "music": 0.0
  },
  {
    "from": 149.02,
    "to": 151.579,
    "sid": 55,
    "location": 2,
    "content": "或者说都有一种力量",
    "music": 0.0
  },
  {
    "from": 151.579,
    "to": 155.319,
    "sid": 56,
    "location": 2,
    "content": "它就像是你在货架前犹豫的那三秒钟",
    "music": 0.0
  },
  {
    "from": 155.319,
    "to": 156.199,
    "sid": 57,
    "location": 2,
    "content": "但是啊",
    "music": 0.0
  },
  {
    "from": 156.199,
    "to": 160.37,
    "sid": 58,
    "location": 2,
    "content": "你大脑里面可正在发生一场物理层面的内战",
    "music": 0.0
  },
  {
    "from": 160.37,
    "to": 165.51,
    "sid": 59,
    "location": 2,
    "content": "你脑中呃草莓和巧克力各自是一群神经元",
    "music": 0.0
  },
  {
    "from": 165.51,
    "to": 169.71,
    "sid": 60,
    "location": 2,
    "content": "它们之间有一种叫做GABA的分子哎",
    "music": 0.0
  },
  {
    "from": 169.71,
    "to": 171.12,
    "sid": 61,
    "location": 2,
    "content": "互相踩刹车",
    "music": 0.0
  },
  {
    "from": 171.12,
    "to": 173.02,
    "sid": 62,
    "location": 2,
    "content": "你犹豫的那几秒钟",
    "music": 0.0
  },
  {
    "from": 173.02,
    "to": 175.8,
    "sid": 63,
    "location": 2,
    "content": "他们就在物理性的相互压制",
    "music": 0.0
  },
  {
    "from": 175.8,
    "to": 179.44,
    "sid": 64,
    "location": 2,
    "content": "你的脑子里啊是真实的在拔河的",
    "music": 0.0
  },
  {
    "from": 179.44,
    "to": 181.26,
    "sid": 65,
    "location": 2,
    "content": "而物理现实是这样",
    "music": 0.0
  },
  {
    "from": 181.26,
    "to": 186.36,
    "sid": 66,
    "location": 2,
    "content": "那这台机器天生我们的脑子它就是并行的矛盾",
    "music": 0.0
  },
  {
    "from": 186.36,
    "to": 188.06,
    "sid": 67,
    "location": 2,
    "content": "就是它的默认状态",
    "music": 0.0
  },
  {
    "from": 188.06,
    "to": 193.929,
    "sid": 68,
    "location": 2,
    "content": "那么问题可能就不再是我怎么去消灭矛盾了",
    "music": 0.0
  },
  {
    "from": 193.929,
    "to": 199.08,
    "sid": 69,
    "location": 2,
    "content": "而是变成了我怎么让这些打架的声音坐下来",
    "music": 0.0
  },
  {
    "from": 199.08,
    "to": 200.2,
    "sid": 70,
    "location": 2,
    "content": "开个会",
    "music": 0.0
  },
  {
    "from": 200.2,
    "to": 202.78,
    "sid": 71,
    "location": 2,
    "content": "而反映在现实情景上",
    "music": 0.0
  },
  {
    "from": 202.78,
    "to": 205.079,
    "sid": 72,
    "location": 2,
    "content": "最终你做出来一个决定",
    "music": 0.0
  },
  {
    "from": 205.079,
    "to": 208.599,
    "sid": 73,
    "location": 2,
    "content": "但是这个时候又有一个新的麻烦了",
    "music": 0.0
  },
  {
    "from": 208.599,
    "to": 210.2,
    "sid": 74,
    "location": 2,
    "content": "你决定了一个口味",
    "music": 0.0
  },
  {
    "from": 210.2,
    "to": 211.64,
    "sid": 75,
    "location": 2,
    "content": "那你又要选择",
    "music": 0.0
  },
  {
    "from": 211.64,
    "to": 214.88,
    "sid": 76,
    "location": 2,
    "content": "是今天晚上我就把所有的酸奶都吃光",
    "music": 0.0
  },
  {
    "from": 214.88,
    "to": 216.48,
    "sid": 77,
    "location": 2,
    "content": "还是只吃一半儿",
    "music": 0.0
  },
  {
    "from": 216.48,
    "to": 219.52,
    "sid": 78,
    "location": 2,
    "content": "那刚才开会的那种情景又要再来一次",
    "music": 0.0
  },
  {
    "from": 219.52,
    "to": 222.829,
    "sid": 79,
    "location": 2,
    "content": "那生活中啊这种情况是数不胜数的",
    "music": 0.0
  },
  {
    "from": 222.829,
    "to": 227.929,
    "sid": 80,
    "location": 2,
    "content": "那你看我们心里面难道真的只有一个声音吗",
    "music": 0.0
  },
  {
    "from": 227.929,
    "to": 233.7,
    "sid": 81,
    "location": 2,
    "content": "它里边会产生数之不尽的念头和想法",
    "music": 0.0
  },
  {
    "from": 233.7,
    "to": 237.3,
    "sid": 82,
    "location": 2,
    "content": "有一句话或者说一个思想啊",
    "music": 0.0
  },
  {
    "from": 237.3,
    "to": 239.48,
    "sid": 83,
    "location": 2,
    "content": "影响了当时的我呃",
    "music": 0.0
  },
  {
    "from": 239.48,
    "to": 241.18,
    "sid": 84,
    "location": 2,
    "content": "在学精神分析",
    "music": 0.0
  },
  {
    "from": 241.18,
    "to": 243.34,
    "sid": 85,
    "location": 2,
    "content": "大概第三个年头的时候",
    "music": 0.0
  },
  {
    "from": 243.34,
    "to": 244.96,
    "sid": 86,
    "location": 2,
    "content": "我听到了一个观点",
    "music": 0.0
  },
  {
    "from": 244.96,
    "to": 247.74,
    "sid": 87,
    "location": 2,
    "content": "从武志红老师那儿听来的啊",
    "music": 0.0
  },
  {
    "from": 247.74,
    "to": 249.12,
    "sid": 88,
    "location": 2,
    "content": "他是这么说的",
    "music": 0.0
  },
  {
    "from": 249.12,
    "to": 253.73,
    "sid": 89,
    "location": 2,
    "content": "我们心里面每一个想法都有他的生命",
    "music": 0.0
  },
  {
    "from": 253.73,
    "to": 257.14,
    "sid": 90,
    "location": 2,
    "content": "每一个念头都有他自己的生命",
    "music": 0.0
  },
  {
    "from": 257.14,
    "to": 260.0,
    "sid": 91,
    "location": 2,
    "content": "如果我们想要斩断一个念头",
    "music": 0.0
  },
  {
    "from": 260.0,
    "to": 263.58,
    "sid": 92,
    "location": 2,
    "content": "彻底杀死它或者杀死一种情绪",
    "music": 0.0
  },
  {
    "from": 263.58,
    "to": 267.16,
    "sid": 93,
    "location": 2,
    "content": "那对于这个念头或者情绪本身来说",
    "music": 0.0
  },
  {
    "from": 267.16,
    "to": 269.69,
    "sid": 94,
    "location": 2,
    "content": "就是一种巨大的威胁",
    "music": 0.0
  },
  {
    "from": 269.69,
    "to": 273.76,
    "sid": 95,
    "location": 2,
    "content": "你没有办法杀死自己脑内的东西",
    "music": 0.0
  },
  {
    "from": 273.76,
    "to": 275.52,
    "sid": 96,
    "location": 2,
    "content": "你越想驱逐他",
    "music": 0.0
  },
  {
    "from": 275.52,
    "to": 276.92,
    "sid": 97,
    "location": 2,
    "content": "越想消解它",
    "music": 0.0
  },
  {
    "from": 276.92,
    "to": 279.299,
    "sid": 98,
    "location": 2,
    "content": "它就越奋起反抗",
    "music": 0.0
  },
  {
    "from": 279.299,
    "to": 283.28,
    "sid": 99,
    "location": 2,
    "content": "那既然每个念头都有它的生命力",
    "music": 0.0
  },
  {
    "from": 283.28,
    "to": 288.64,
    "sid": 100,
    "location": 2,
    "content": "那我的体内有没有可能存在很多很多个我呢",
    "music": 0.0
  },
  {
    "from": 288.64,
    "to": 291.52,
    "sid": 101,
    "location": 2,
    "content": "他们的想法是不一样的",
    "music": 0.0
  },
  {
    "from": 291.52,
    "to": 293.64,
    "sid": 102,
    "location": 2,
    "content": "甚至截然相反",
    "music": 0.0
  },
  {
    "from": 293.64,
    "to": 296.35,
    "sid": 103,
    "location": 2,
    "content": "他们的记忆也不相同",
    "music": 0.0
  },
  {
    "from": 296.35,
    "to": 299.53,
    "sid": 104,
    "location": 2,
    "content": "有一些我的记忆停留在两年前",
    "music": 0.0
  },
  {
    "from": 299.53,
    "to": 302.039,
    "sid": 105,
    "location": 2,
    "content": "有一些停留在昨天",
    "music": 0.0
  },
  {
    "from": 302.039,
    "to": 305.039,
    "sid": 106,
    "location": 2,
    "content": "而每个我的性格也不一样啊",
    "music": 0.0
  },
  {
    "from": 305.039,
    "to": 307.159,
    "sid": 107,
    "location": 2,
    "content": "有的是个火爆脾气啊",
    "music": 0.0
  },
  {
    "from": 307.159,
    "to": 309.26,
    "sid": 108,
    "location": 2,
    "content": "每别人啊说一句话",
    "music": 0.0
  },
  {
    "from": 309.26,
    "to": 312.73,
