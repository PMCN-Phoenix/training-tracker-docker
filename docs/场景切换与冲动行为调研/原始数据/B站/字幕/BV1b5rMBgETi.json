  },
  {
    "from": 46.1,
    "to": 49.06,
    "sid": 32,
    "location": 2,
    "content": "你会发现你在想的那件事情可能真的很小",
    "music": 0.0
  },
  {
    "from": 49.06,
    "to": 50.82,
    "sid": 33,
    "location": 2,
    "content": "就是你把这个维度拉长",
    "music": 0.0
  },
  {
    "from": 50.82,
    "to": 51.9,
    "sid": 34,
    "location": 2,
    "content": "把时间维度拉长",
