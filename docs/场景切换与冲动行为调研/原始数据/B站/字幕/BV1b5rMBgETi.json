    "from": 57.98,
    "to": 58.58,
    "sid": 41,
    "location": 2,
    "content": "怎么了呢",
    "music": 0.0
  },
  {
    "from": 58.58,
    "to": 59.78,
    "sid": 42,
    "location": 2,
    "content": "同学和我闹矛盾了",
