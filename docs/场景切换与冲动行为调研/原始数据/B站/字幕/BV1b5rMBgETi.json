[
  {
    "from": 0.04,
    "to": 1.6,
    "sid": 1,
    "location": 2,
    "content": "我觉得意志力是一个消耗品",
    "music": 0.0
  },
  {
    "from": 1.6,
    "to": 2.8,
    "sid": 2,
    "location": 2,
    "content": "但是很多人都认识不到",
    "music": 0.0
  },
  {
    "from": 2.8,
    "to": 5.62,
    "sid": 3,
    "location": 2,
    "content": "就是可能你觉得你一直在全力的往前跑",
    "music": 0.0
  },
  {
    "from": 5.62,
    "to": 6.58,
    "sid": 4,
    "location": 2,
    "content": "但其实不知不觉间",
    "music": 0.0
  },
  {
    "from": 6.58,
    "to": 7.72,
    "sid": 5,
    "location": 2,
    "content": "你的速度已经下来了",
    "music": 0.0
  },
  {
    "from": 7.72,
    "to": 8.7,
    "sid": 6,
    "location": 2,
    "content": "确实花了时间",
    "music": 0.0
  },
  {
    "from": 8.7,
    "to": 9.4,
    "sid": 7,
    "location": 2,
    "content": "你也在做",
    "music": 0.0
  },
  {
    "from": 9.4,
    "to": 12.23,
    "sid": 8,
    "location": 2,
    "content": "但是嗯嗯你可能是一种麻木的状态",
    "music": 0.0
  },
  {
    "from": 12.23,
    "to": 14.27,
    "sid": 9,
    "location": 2,
    "content": "就是如果我查一下你的工作量",
    "music": 0.0
  },
  {
    "from": 14.27,
    "to": 16.02,
    "sid": 10,
    "location": 2,
    "content": "查一下你的效率其实不会很高",
    "music": 0.0
  },
  {
    "from": 16.02,
    "to": 16.86,
    "sid": 11,
    "location": 2,
    "content": "为什么会这样呢",
    "music": 0.0
  },
  {
    "from": 16.86,
    "to": 18.26,
    "sid": 12,
    "location": 2,
    "content": "就是因为你的意志被消耗完了",
    "music": 0.0
  },
  {
    "from": 18.26,
    "to": 19.02,
    "sid": 13,
    "location": 2,
    "content": "没有补充上",
    "music": 0.0
  },
  {
    "from": 19.02,
    "to": 22.86,
    "sid": 14,
    "location": 2,
    "content": "所以我会觉得就是不能一直一昧的往前跑",
    "music": 0.0
  },
  {
    "from": 22.86,
    "to": 24.24,
    "sid": 15,
    "location": 2,
    "content": "就是你偶尔也要停一停",
    "music": 0.0
  },
  {
    "from": 24.24,
    "to": 25.64,
    "sid": 16,
    "location": 2,
    "content": "你可以抬头看一看",
    "music": 0.0
  },
  {
    "from": 25.64,
    "to": 26.42,
    "sid": 17,
    "location": 2,
    "content": "看什么呢",
    "music": 0.0
  },
  {
    "from": 26.42,
    "to": 27.7,
    "sid": 18,
    "location": 2,
    "content": "就是我很喜欢的一句话",
    "music": 0.0
  },
  {
    "from": 27.7,
    "to": 30.44,
    "sid": 19,
    "location": 2,
    "content": "就是用宏大的世界稀释痛苦",
    "music": 0.0
  },
  {
    "from": 30.44,
    "to": 32.08,
    "sid": 20,
    "location": 2,
    "content": "从生活的小事感知幸福",
    "music": 0.0
  },
  {
    "from": 32.08,
    "to": 32.8,
    "sid": 21,
    "location": 2,
    "content": "就是你想嘛",
    "music": 0.0
  },
  {
    "from": 32.8,
    "to": 34.32,
    "sid": 22,
    "location": 2,
    "content": "为什么你的意志力会被消耗完呢",
    "music": 0.0
  },
  {
    "from": 34.32,
    "to": 35.54,
    "sid": 23,
    "location": 2,
    "content": "要么就是没有补充上",
    "music": 0.0
  },
  {
    "from": 35.54,
    "to": 37.0,
    "sid": 24,
    "location": 2,
    "content": "要么就是消耗的太快了",
    "music": 0.0
  },
  {
    "from": 37.0,
    "to": 37.88,
    "sid": 25,
    "location": 2,
    "content": "消耗的太快了",
    "music": 0.0
  },
  {
    "from": 37.88,
    "to": 39.12,
    "sid": 26,
    "location": 2,
    "content": "就是遇到了一些不好的事情",
    "music": 0.0
  },
  {
    "from": 39.12,
    "to": 40.42,
    "sid": 27,
    "location": 2,
    "content": "你感觉到痛苦",
    "music": 0.0
  },
  {
    "from": 40.42,
    "to": 41.48,
    "sid": 28,
    "location": 2,
    "content": "你感觉到焦虑",
    "music": 0.0
  },
  {
    "from": 41.48,
    "to": 43.0,
    "sid": 29,
    "location": 2,
    "content": "这个时候你就可以抬头看一看",
    "music": 0.0
  },
  {
    "from": 43.0,
    "to": 44.58,
    "sid": 30,
    "location": 2,
    "content": "你看一看这广阔的天空",
