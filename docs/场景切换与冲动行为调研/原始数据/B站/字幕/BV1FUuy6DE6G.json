[
  {
    "from": 0.28,
    "to": 1.78,
    "sid": 1,
    "location": 2,
    "content": "假如书籍会说话",
    "music": 0.0
  },
  {
    "from": 1.78,
    "to": 4.06,
    "sid": 2,
    "location": 2,
    "content": "今日对话不可打扰",
    "music": 0.0
  },
  {
    "from": 4.06,
    "to": 5.56,
    "sid": 3,
    "location": 2,
    "content": "你说你能帮人专注",
    "music": 0.0
  },
  {
    "from": 5.56,
    "to": 7.74,
    "sid": 4,
    "location": 2,
    "content": "但我身边没有一个人靠下定决心",
    "music": 0.0
  },
  {
    "from": 7.74,
    "to": 8.9,
    "sid": 5,
    "location": 2,
    "content": "真的戒掉手机的",
    "music": 0.0
  },
  {
    "from": 8.9,
    "to": 9.94,
    "sid": 6,
    "location": 2,
    "content": "因为他们搞错了",
    "music": 0.0
  },
  {
    "from": 9.94,
    "to": 10.74,
    "sid": 7,
    "location": 2,
    "content": "敌人是谁",
    "music": 0.0
  },
  {
    "from": 10.74,
    "to": 11.75,
    "sid": 8,
    "location": 2,
    "content": "什么意思啊",
    "music": 0.0
  },
  {
    "from": 11.75,
    "to": 13.37,
    "sid": 9,
    "location": 2,
    "content": "手机不就是敌人吗",
    "music": 0.0
  },
  {
    "from": 13.37,
    "to": 14.73,
    "sid": 10,
    "location": 2,
    "content": "手机只是出口",
    "music": 0.0
  },
  {
    "from": 14.73,
    "to": 17.97,
    "sid": 11,
    "location": 2,
    "content": "真正的敌人在你脑子里是你想逃跑的那个感觉",
    "music": 0.0
  },
  {
    "from": 17.97,
    "to": 20.37,
    "sid": 12,
    "location": 2,
    "content": "逃跑我只是无聊才刷手机",
    "music": 0.0
  },
  {
    "from": 20.37,
    "to": 22.18,
    "sid": 13,
    "location": 2,
    "content": "无聊就是一种不适感",
    "music": 0.0
  },
  {
    "from": 22.18,
    "to": 24.94,
    "sid": 14,
    "location": 2,
    "content": "你刷手机是因为坐在那里什么都不做",
    "music": 0.0
  },
  {
    "from": 24.94,
    "to": 25.74,
    "sid": 15,
    "location": 2,
    "content": "让你难受",
    "music": 0.0
  },
  {
    "from": 25.74,
    "to": 27.56,
    "sid": 16,
    "location": 2,
    "content": "那我把手机删了不就行了",
    "music": 0.0
  },
  {
    "from": 27.56,
    "to": 29.86,
    "sid": 17,
    "location": 2,
    "content": "删了手机你会去翻冰箱",
    "music": 0.0
  },
  {
    "from": 29.86,
    "to": 32.18,
    "sid": 18,
    "location": 2,
    "content": "问题从来不在手机里好",
    "music": 0.0
  },
  {
    "from": 32.18,
    "to": 35.12,
    "sid": 19,
    "location": 2,
    "content": "那你说分心的问题到底出在哪",
    "music": 0.0
  },
  {
    "from": 35.12,
    "to": 36.86,
    "sid": 20,
    "location": 2,
    "content": "出在你每次感到不舒服",
    "music": 0.0
  },
  {
    "from": 36.86,
    "to": 38.66,
    "sid": 21,
    "location": 2,
    "content": "就立刻找东西转移注意力",
    "music": 0.0
  },
  {
    "from": 38.66,
    "to": 40.74,
    "sid": 22,
    "location": 2,
    "content": "这个反应才是真正的问题",
    "music": 0.0
  },
  {
    "from": 40.74,
    "to": 42.6,
    "sid": 23,
    "location": 2,
    "content": "不舒服就转移注意力",
    "music": 0.0
  },
  {
    "from": 42.6,
    "to": 44.22,
    "sid": 24,
    "location": 2,
    "content": "这不是人之常情吗",
    "music": 0.0
  },
  {
    "from": 44.22,
    "to": 45.14,
    "sid": 25,
    "location": 2,
    "content": "是常情",
    "music": 0.0
  },
  {
    "from": 45.14,
    "to": 46.31,
    "sid": 26,
    "location": 2,
    "content": "但也是陷阱",
    "music": 0.0
  },
  {
    "from": 46.31,
    "to": 47.97,
    "sid": 27,
    "location": 2,
    "content": "你越擅长逃避不适",
    "music": 0.0
  },
  {
    "from": 47.97,
    "to": 50.35,
    "sid": 28,
    "location": 2,
    "content": "就越没办法做任何需要忍耐的事",
    "music": 0.0
  },
  {
    "from": 50.35,
    "to": 52.07,
    "sid": 29,
    "location": 2,
    "content": "那这跟手机有什么关系",
    "music": 0.0
  },
  {
    "from": 52.07,
    "to": 54.33,
    "sid": 30,
    "location": 2,
    "content": "手机设计出来就是让人上瘾的",
    "music": 0.0
  },
  {
    "from": 54.33,
    "to": 55.63,
    "sid": 31,
    "location": 2,
    "content": "这不是我的错吧",
    "music": 0.0
  },
  {
    "from": 55.63,
    "to": 58.27,
    "sid": 32,
    "location": 2,
    "content": "对外部诱惑是真实存在的",
    "music": 0.0
  },
  {
    "from": 58.27,
    "to": 60.33,
    "sid": 33,
    "location": 2,
    "content": "但你有没有注意到同一个人",
    "music": 0.0
  },
  {
    "from": 60.33,
    "to": 62.93,
    "sid": 34,
    "location": 2,
    "content": "同一部手机有时候能专注几小时",
    "music": 0.0
  },
  {
    "from": 62.93,
    "to": 64.55,
    "sid": 35,
    "location": 2,
    "content": "有时候5分钟都撑不住",
    "music": 0.0
  },
  {
    "from": 64.55,
    "to": 66.83,
    "sid": 36,
    "location": 2,
    "content": "对确实那是为什么",
    "music": 0.0
  },
  {
    "from": 66.83,
    "to": 69.389,
    "sid": 37,
    "location": 2,
    "content": "因为那几小时你没有在逃什么",
    "music": 0.0
  },
  {
    "from": 69.389,
    "to": 72.589,
    "sid": 38,
    "location": 2,
    "content": "你当时做的事本身就是你真正想做的",
    "music": 0.0
  },
  {
    "from": 72.589,
    "to": 74.809,
    "sid": 39,
    "location": 2,
    "content": "所以你的意思是专注力差",
    "music": 0.0
  },
  {
    "from": 74.809,
    "to": 77.58,
    "sid": 40,
    "location": 2,
    "content": "根本原因是我在逃避某种情绪",
    "music": 0.0
  },
  {
    "from": 78.45,
    "to": 80.51,
    "sid": 41,
    "location": 2,
    "content": "这本书管他叫内在触发器",
    "music": 0.0
  },
  {
    "from": 80.51,
    "to": 81.77,
    "sid": 42,
    "location": 2,
    "content": "焦虑无聊",
    "music": 0.0
  },
  {
    "from": 81.77,
    "to": 82.57,
    "sid": 43,
    "location": 2,
    "content": "挫败感",
    "music": 0.0
  },
  {
    "from": 82.57,
    "to": 83.77,
    "sid": 44,
    "location": 2,
    "content": "被冷落的感觉",
    "music": 0.0
  },
  {
    "from": 83.77,
    "to": 85.29,
    "sid": 45,
    "location": 2,
    "content": "这些情绪一冒出来",
    "music": 0.0
  },
  {
    "from": 85.29,
    "to": 86.61,
    "sid": 46,
    "location": 2,
    "content": "你的手就先动了",
    "music": 0.0
  },
  {
    "from": 86.61,
    "to": 88.09,
    "sid": 47,
    "location": 2,
    "content": "那我要怎么办",
    "music": 0.0
  },
  {
    "from": 88.09,
    "to": 89.78,
    "sid": 48,
    "location": 2,
    "content": "难道要坐在那里硬撑",
    "music": 0.0
  },
  {
    "from": 89.78,
    "to": 90.82,
    "sid": 49,
    "location": 2,
    "content": "不是硬撑",
    "music": 0.0
  },
  {
    "from": 90.82,
    "to": 92.1,
    "sid": 50,
    "location": 2,
    "content": "是先给它命名",
    "music": 0.0
  },
  {
    "from": 92.1,
    "to": 93.24,
    "sid": 51,
    "location": 2,
    "content": "你感到烦躁",
    "music": 0.0
  },
  {
    "from": 93.24,
    "to": 94.2,
    "sid": 52,
    "location": 2,
    "content": "就在心里说",
    "music": 0.0
  },
  {
    "from": 94.2,
    "to": 95.5,
    "sid": 53,
    "location": 2,
    "content": "我现在烦躁了",
    "music": 0.0
  },
  {
    "from": 95.5,
    "to": 96.64,
    "sid": 54,
    "location": 2,
    "content": "就这一句话",
    "music": 0.0
  },
  {
    "from": 96.64,
    "to": 99.23,
    "sid": 55,
    "location": 2,
    "content": "就这说一句话有什么用",
    "music": 0.0
  },
  {
    "from": 99.23,
    "to": 100.67,
    "sid": 56,
    "location": 2,
    "content": "你一旦给情绪命名",
    "music": 0.0
  },
  {
    "from": 100.67,
    "to": 102.53,
    "sid": 57,
    "location": 2,
    "content": "你就从情绪里面跳出来了",
    "music": 0.0
  },
  {
    "from": 102.53,
    "to": 103.93,
    "sid": 58,
    "location": 2,
    "content": "变成了观察他的人",
    "music": 0.0
  },
  {
    "from": 103.93,
    "to": 106.72,
    "sid": 59,
    "location": 2,
    "content": "他就没那么大力气拖着你跑了好",
    "music": 0.0
  },
  {
    "from": 106.72,
    "to": 108.2,
    "sid": 60,
    "location": 2,
    "content": "我承认这有点道理",
    "music": 0.0
  },
  {
    "from": 108.2,
    "to": 109.74,
    "sid": 61,
    "location": 2,
    "content": "但光命名有什么用",
    "music": 0.0
  },
  {
    "from": 109.74,
    "to": 110.8,
    "sid": 62,
    "location": 2,
    "content": "情绪还在啊",
    "music": 0.0
  },
  {
    "from": 110.8,
    "to": 113.06,
    "sid": 63,
    "location": 2,
    "content": "命名之后你就做第二件事",
    "music": 0.0
  },
  {
    "from": 113.06,
    "to": 114.27,
    "sid": 64,
    "location": 2,
    "content": "不要立刻逃",
    "music": 0.0
  },
  {
    "from": 114.27,
    "to": 115.89,
    "sid": 65,
    "location": 2,
    "content": "就停在那个不舒服里",
    "music": 0.0
  },
  {
    "from": 115.89,
    "to": 118.57,
    "sid": 66,
    "location": 2,
    "content": "10分钟你会发现它自己就过去了",
    "music": 0.0
  },
  {
    "from": 118.57,
    "to": 119.4,
    "sid": 67,
    "location": 2,
    "content": "10分钟",
    "music": 0.0
  },
  {
    "from": 119.4,
    "to": 120.54,
    "sid": 68,
    "location": 2,
    "content": "我现在坐在那里",
    "music": 0.0
  },
  {
    "from": 120.54,
    "to": 122.38,
    "sid": 69,
    "location": 2,
    "content": "不到2分钟就要拿手机了",
    "music": 0.0
  },
  {
    "from": 122.38,
    "to": 124.19,
    "sid": 70,
    "location": 2,
    "content": "那就从2分钟开始",
    "music": 0.0
  },
  {
    "from": 124.19,
    "to": 125.37,
    "sid": 71,
    "location": 2,
    "content": "不是感觉像浪",
    "music": 0.0
  },
  {
    "from": 125.37,
    "to": 126.43,
    "sid": 72,
    "location": 2,
    "content": "他会涌上来",
    "music": 0.0
  },
  {
    "from": 126.43,
    "to": 127.53,
    "sid": 73,
    "location": 2,
    "content": "但他也会退",
    "music": 0.0
  },
  {
    "from": 127.53,
    "to": 128.77,
    "sid": 74,
    "location": 2,
    "content": "你不用打赢他",
    "music": 0.0
  },
  {
    "from": 128.77,
    "to": 131.06,
    "sid": 75,
    "location": 2,
    "content": "你只需要不跟着他跑好",
    "music": 0.0
  },
  {
    "from": 131.06,
    "to": 132.52,
    "sid": 76,
    "location": 2,
    "content": "假设我能撑住情绪了",
    "music": 0.0
  },
  {
    "from": 132.52,
    "to": 133.84,
    "sid": 77,
    "location": 2,
    "content": "但我还有另一个问题",
    "music": 0.0
  },
  {
    "from": 133.84,
    "to": 135.22,
    "sid": 78,
    "location": 2,
    "content": "我每天计划了一堆事",
    "music": 0.0
  },
  {
    "from": 135.22,
    "to": 136.64,
    "sid": 79,
    "location": 2,
    "content": "最后一件都没做完",
    "music": 0.0
  },
  {
    "from": 136.64,
    "to": 138.04,
    "sid": 80,
    "location": 2,
    "content": "这又是怎么回事",
    "music": 0.0
  },
  {
    "from": 138.04,
    "to": 139.8,
    "sid": 81,
    "location": 2,
    "content": "因为你的计划是任务清单",
    "music": 0.0
  },
  {
    "from": 139.8,
    "to": 141.04,
    "sid": 82,
    "location": 2,
    "content": "不是时间安排",
    "music": 0.0
  },
  {
    "from": 141.04,
    "to": 142.64,
    "sid": 83,
    "location": 2,
    "content": "你写了今天要写报告",
    "music": 0.0
  },
  {
    "from": 142.64,
    "to": 144.88,
    "sid": 84,
    "location": 2,
    "content": "但你没有写几点到几点写报告",
    "music": 0.0
  },
  {
    "from": 144.88,
    "to": 146.04,
    "sid": 85,
    "location": 2,
    "content": "这有区别吗",
    "music": 0.0
  },
  {
    "from": 146.04,
    "to": 147.589,
    "sid": 86,
    "location": 2,
    "content": "反正都是要做的事",
    "music": 0.0
  },
  {
    "from": 147.589,
    "to": 148.809,
    "sid": 87,
    "location": 2,
    "content": "区别大了",
    "music": 0.0
  },
  {
    "from": 148.809,
    "to": 150.069,
    "sid": 88,
    "location": 2,
    "content": "没有时间的任务",
    "music": 0.0
  },
  {
    "from": 150.069,
    "to": 152.22,
    "sid": 89,
    "location": 2,
    "content": "会被任何一件插进来的事挤掉",
    "music": 0.0
  },
  {
    "from": 152.22,
    "to": 153.54,
    "sid": 90,
    "location": 2,
    "content": "有时间的任务",
    "music": 0.0
  },
  {
    "from": 153.54,
    "to": 155.44,
    "sid": 91,
    "location": 2,
    "content": "那个时间段就是他的地盘",
    "music": 0.0
  },
  {
    "from": 155.44,
    "to": 156.62,
    "sid": 92,
    "location": 2,
    "content": "别的是进不来",
    "music": 0.0
  },
  {
    "from": 156.62,
    "to": 158.52,
    "sid": 93,
    "location": 2,
    "content": "这不就是普通的时间管理吗",
    "music": 0.0
  },
  {
    "from": 158.52,
    "to": 160.41,
    "sid": 94,
    "location": 2,
    "content": "我用过番茄钟没用",
    "music": 0.0
  },
  {
    "from": 160.41,
    "to": 162.07,
    "sid": 95,
    "location": 2,
    "content": "番茄中管的是任务",
    "music": 0.0
  },
  {
    "from": 162.07,
    "to": 164.65,
    "sid": 96,
    "location": 2,
    "content": "这本书说的时间和管的是价值",
    "music": 0.0
  },
  {
    "from": 164.65,
    "to": 167.25,
    "sid": 97,
    "location": 2,
    "content": "你真正在乎的是要先占住位置",
    "music": 0.0
  },
  {
    "from": 167.25,
    "to": 169.78,
    "sid": 98,
    "location": 2,
    "content": "不是等有空再填进去等等",
    "music": 0.0
  },
  {
    "from": 169.78,
    "to": 171.48,
    "sid": 99,
    "location": 2,
    "content": "这两个有什么不一样",
    "music": 0.0
  },
  {
    "from": 171.48,
    "to": 173.66,
    "sid": 100,
    "location": 2,
    "content": "你有没有发现你的行事历上",
    "music": 0.0
  },
  {
    "from": 173.66,
    "to": 175.2,
    "sid": 101,
    "location": 2,
    "content": "工作会议排的满满的",
    "music": 0.0
  },
  {
    "from": 175.2,
    "to": 178.2,
    "sid": 102,
    "location": 2,
    "content": "但陪孩子锻炼学你想学的东西",
    "music": 0.0
  },
  {
    "from": 178.2,
    "to": 180.54,
    "sid": 103,
    "location": 2,
    "content": "这些是从来没有固定时间对",
    "music": 0.0
  },
  {
    "from": 180.54,
    "to": 182.72,
    "sid": 104,
    "location": 2,
    "content": "因为这些事随时都可以做",
    "music": 0.0
  },
  {
    "from": 182.72,
    "to": 183.82,
    "sid": 105,
    "location": 2,
    "content": "随时可以做",
    "music": 0.0
  },
  {
    "from": 183.82,
    "to": 185.24,
    "sid": 106,
    "location": 2,
    "content": "就等于随时不做",
    "music": 0.0
  },
  {
    "from": 185.24,
    "to": 188.14,
    "sid": 107,
    "location": 2,
    "content": "你最在乎的事反而最容易被挤掉",
    "music": 0.0
  },
  {
    "from": 188.14,
    "to": 189.14,
    "sid": 108,
    "location": 2,
    "content": "这话有点渣",
    "music": 0.0
  },
  {
    "from": 189.14,
    "to": 190.72,
    "sid": 109,
    "location": 2,
    "content": "那时间和具体怎么用",
    "music": 0.0
  },
  {
    "from": 190.72,
    "to": 194.29,
    "sid": 110,
    "location": 2,
    "content": "别跟我说把事情写进日历这种废话三步",
    "music": 0.0
  },
  {
    "from": 194.29,
    "to": 196.47,
    "sid": 111,
    "location": 2,
    "content": "第一步先排你自己的事",
    "music": 0.0
  },
  {
    "from": 196.47,
    "to": 198.62,
    "sid": 112,
    "location": 2,
    "content": "不是先排工作健身",
    "music": 0.0
  },
  {
    "from": 198.62,
    "to": 199.56,
    "sid": 113,
    "location": 2,
