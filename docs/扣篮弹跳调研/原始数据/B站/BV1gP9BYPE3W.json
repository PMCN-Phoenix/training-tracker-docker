          "music": 0.0
        },
        {
          "from": 2.9,
          "to": 5.59,
          "sid": 3,
          "location": 2,
          "content": "好多网友都说他说怎么这么惨",
          "music": 0.0
        },
        {
          "from": 5.59,
          "to": 8.13,
          "sid": 4,
          "location": 2,
          "content": "什么自己170只能摸到206",
          "music": 0.0
        },
        {
          "from": 8.13,
          "to": 9.19,
          "sid": 5,
          "location": 2,
          "content": "给个结论",
          "music": 0.0
        },
        {
          "from": 9.19,
          "to": 13.41,
          "sid": 6,
          "location": 2,
          "content": "这些结论99%都是没有测准",
          "music": 0.0
        },
        {
          "from": 13.41,
          "to": 14.98,
          "sid": 7,
          "location": 2,
          "content": "真实的站立摸高",
          "music": 0.0
        },
        {
          "from": 14.98,
          "to": 18.06,
          "sid": 8,
          "location": 2,
          "content": "就应该是光脚站在摸高器的最下端",
          "music": 0.0
        },
        {
          "from": 18.06,
          "to": 20.96,
          "sid": 9,
          "location": 2,
          "content": "用惯用手用力的向上身",
          "music": 0.0
        },
        {
          "from": 20.96,
          "to": 23.32,
          "sid": 10,
          "location": 2,
          "content": "尽可能拨出去更多的片",
          "music": 0.0
        },
        {
          "from": 23.32,
          "to": 26.34,
          "sid": 11,
          "location": 2,
          "content": "这种情况下的测量才是真实的",
          "music": 0.0
        },
        {
          "from": 26.34,
          "to": 26.72,
          "sid": 12,
          "location": 2,
          "content": "惠",
          "music": 0.0
        },
        {
          "from": 26.72,
          "to": 30.03,
          "sid": 13,
          "location": 2,
          "content": "比用卷尺呀对着墙摸准得多",
          "music": 0.0
        },
        {
          "from": 30.03,
          "to": 32.09,
          "sid": 14,
          "location": 2,
          "content": "一开始我也以为我的站立摸高",
          "music": 0.0
        },
        {
          "from": 32.09,
          "to": 34.65,
          "sid": 15,
          "location": 2,
          "content": "对着墙测量只有204cm",
          "music": 0.0
        },
        {
          "from": 34.65,
          "to": 35.73,
          "sid": 16,
          "location": 2,
          "content": "这样算下来",
          "music": 0.0
        },
        {
          "from": 35.73,
          "to": 38.33,
          "sid": 17,
          "location": 2,
          "content": "我的原地弹跳高度就达到了100cm啊",
          "music": 0.0
        },
        {
          "from": 38.33,
          "to": 40.59,
          "sid": 18,
          "location": 2,
          "content": "听起来还是很令人振奋的",
          "music": 0.0
        },
        {
          "from": 40.59,
          "to": 44.52,
          "sid": 19,
          "location": 2,
          "content": "但实际站在摸高器下端用力的向上伸",
          "music": 0.0
        },
        {
          "from": 44.52,
          "to": 47.93,
          "sid": 20,
          "location": 2,
          "content": "至少是能达到212cm以上的原因",
          "music": 0.0
        },
        {
          "from": 47.93,
          "to": 49.97,
          "sid": 21,
          "location": 2,
          "content": "第一个是因为肩胛骨是可以活动的",
          "music": 0.0
        },
        {
          "from": 49.97,
          "to": 52.48,
          "sid": 22,
          "location": 2,
          "content": "第二个身体侧身倾斜",
          "music": 0.0
        },
        {
          "from": 52.48,
          "to": 56.5,
          "sid": 23,
          "location": 2,
          "content": "第三个是站在最下方是最优状态啊",
          "music": 0.0
        },
        {
          "from": 56.5,
          "to": 58.68,
          "sid": 24,
          "location": 2,
          "content": "经过长时间的线下学员观察",
          "music": 0.0
        },
        {
          "from": 58.68,
          "to": 60.74,
          "sid": 25,
          "location": 2,
          "content": "170的普通标准",
          "music": 0.0
        },
        {
          "from": 60.74,
          "to": 64.02,
          "sid": 26,
          "location": 2,
          "content": "站立摸高是能达到215cm的啊",
          "music": 0.0
        },
        {
          "from": 64.02,
          "to": 66.4,
          "sid": 27,
          "location": 2,
          "content": "优秀的标准可以达到220cm",
          "music": 0.0
        },
        {
          "from": 66.4,
          "to": 70.11,
          "sid": 28,
          "location": 2,
          "content": "所以各位你们大多数真的不需要跳很高",
          "music": 0.0
        },
        {
          "from": 70.11,
          "to": 73.62,
          "sid": 29,
          "location": 2,
          "content": "以下是一个站立摸高的数据参考啊",
          "music": 0.0
        },
        {
          "from": 73.62,
          "to": 76.56,
          "sid": 30,
          "location": 2,
          "content": "采样来自于线下学员的测量啊",
          "music": 0.0
        },
        {
          "from": 76.56,
          "to": 80.1,
          "sid": 31,
          "location": 2,
          "content": "学员基本都属于没有什么运动天赋的人群",
