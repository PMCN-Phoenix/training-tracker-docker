    ]
  },
  "subs": [
    {
      "part": "P1",
      "lang": "ai-zh",
      "segments": [
        {
          "from": 0.64,
          "to": 2.11,
          "sid": 1,
          "location": 2,
          "content": "还在这样练摸高",
          "music": 0.1754385811018788
        },
        {
          "from": 2.11,
          "to": 4.359,
          "sid": 2,
          "location": 2,
          "content": "这样练这样练",
          "music": 0.0
        },
        {
          "from": 4.359,
          "to": 5.529,
          "sid": 3,
          "location": 2,
          "content": "深蹲也好",
          "music": 0.0
        },
        {
          "from": 5.529,
          "to": 6.459,
          "sid": 4,
          "location": 2,
          "content": "蛙跳也好",
          "music": 0.0
        },
        {
          "from": 6.459,
          "to": 10.119,
          "sid": 5,
          "location": 2,
          "content": "都是非常经典的提高下肢力量的动作",
          "music": 0.0
        },
        {
          "from": 10.119,
          "to": 12.1,
          "sid": 6,
          "location": 2,
          "content": "但是我很遗憾的告诉你",
          "music": 0.0
        },
        {
          "from": 12.1,
          "to": 13.09,
          "sid": 7,
          "location": 2,
          "content": "练得越多",
          "music": 0.0
        },
        {
          "from": 13.09,
          "to": 14.65,
          "sid": 8,
          "location": 2,
          "content": "跳得越低",
          "music": 0.0
        },
        {
          "from": 14.65,
          "to": 18.8,
          "sid": 9,
          "location": 2,
          "content": "为什么增大力量的动作反而让你越跳跃低呢",
          "music": 0.0
        },
        {
          "from": 18.8,
          "to": 20.09,
          "sid": 10,
          "location": 2,
          "content": "原因有两个",
          "music": 0.0
        },
        {
          "from": 20.09,
          "to": 23.58,
          "sid": 11,
          "location": 2,
          "content": "第一个肌肉的力量其实分为两种",
          "music": 0.0
        },
        {
          "from": 23.58,
          "to": 26.07,
          "sid": 12,
          "location": 2,
          "content": "一种是叫肌肉耐受力",
          "music": 0.0
        },
        {
          "from": 26.07,
          "to": 28.41,
          "sid": 13,
          "location": 2,
          "content": "另一种叫肌肉的爆发力",
          "music": 0.0
        },
        {
          "from": 28.41,
          "to": 29.46,
          "sid": 14,
          "location": 2,
          "content": "深蹲蛙跳",
          "music": 0.0
        },
        {
          "from": 29.46,
          "to": 33.38,
          "sid": 15,
          "location": 2,
          "content": "这种抗阻训练是通过长时间的持续发力",
          "music": 0.0
        },
        {
          "from": 33.38,
          "to": 35.06,
          "sid": 16,
          "location": 2,
          "content": "来撕裂肌肉组织",
          "music": 0.0
        },
        {
          "from": 35.06,
          "to": 37.94,
          "sid": 17,
          "location": 2,
          "content": "再通过蛋白质等营养物质去修负",
          "music": 0.0
        },
        {
          "from": 37.94,
          "to": 39.14,
          "sid": 18,
          "location": 2,
          "content": "我们的撕裂部位",
          "music": 0.0
        },
        {
          "from": 39.14,
          "to": 41.27,
          "sid": 19,
          "location": 2,
          "content": "以达到增大肌肉维度",
          "music": 0.0
        },
        {
          "from": 41.27,
          "to": 44.0,
          "sid": 20,
          "location": 2,
          "content": "增加肌肉持续发力的能力",
          "music": 0.0
        },
        {
          "from": 44.0,
          "to": 46.7,
          "sid": 21,
          "location": 2,
          "content": "过去你只能举20斤的杠铃",
          "music": 0.0
        },
        {
          "from": 46.7,
          "to": 47.72,
          "sid": 22,
          "location": 2,
          "content": "那通过训练",
          "music": 0.0
        },
        {
          "from": 47.72,
          "to": 50.18,
          "sid": 23,
          "location": 2,
          "content": "随着你的肌肉的耐受力增加",
          "music": 0.0
        },
        {
          "from": 50.18,
          "to": 51.47,
          "sid": 24,
          "location": 2,
          "content": "肌肉维度增加",
          "music": 0.0
        },
        {
          "from": 51.47,
          "to": 53.66,
          "sid": 25,
          "location": 2,
          "content": "你慢慢就可以举起30斤的杠铃",
          "music": 0.0
        },
        {
          "from": 53.66,
          "to": 56.44,
          "sid": 26,
          "location": 2,
          "content": "这个锻炼的就是肌肉的耐受力",
          "music": 0.0
        },
        {
          "from": 56.44,
          "to": 59.2,
          "sid": 27,
          "location": 2,
          "content": "它的特点就是发力时间很长",
          "music": 0.0
        },
        {
          "from": 59.2,
          "to": 62.97,
          "sid": 28,
          "location": 2,
          "content": "而且发力时间越长越有利于撕裂肌肉",
          "music": 0.0
        },
        {
          "from": 62.97,
          "to": 66.45,
          "sid": 29,
          "location": 2,
          "content": "所以健身教练通常都会让你做动作一定要慢",
          "music": 0.0
        },
        {
          "from": 66.45,
          "to": 69.18,
          "sid": 30,
          "location": 2,
          "content": "那么什么是肌肉爆发力呢",
          "music": 0.0
        },
        {
          "from": 69.18,
          "to": 70.29,
          "sid": 31,
          "location": 2,
          "content": "举个例子",
          "music": 0.0
        },
        {
          "from": 70.29,
          "to": 73.4,
          "sid": 32,
          "location": 2,
          "content": "当你拿着一个石块在河边去打水漂",
          "music": 0.0
        },
        {
          "from": 73.4,
          "to": 75.02,
          "sid": 33,
          "location": 2,
          "content": "通过瞬间的发力",
          "music": 0.0
        },
        {
          "from": 75.02,
          "to": 77.36,
          "sid": 34,
          "location": 2,
          "content": "让石头产生更大的位移",
          "music": 0.0
        },
        {
          "from": 77.36,
          "to": 79.43,
          "sid": 35,
          "location": 2,
          "content": "这种就是肌肉的爆发力",
          "music": 0.0
        },
        {
          "from": 79.43,
          "to": 82.21,
          "sid": 36,
          "location": 2,
          "content": "比如你回学校宿舍没有带钥匙",
          "music": 0.0
        },
        {
          "from": 82.21,
          "to": 83.86,
          "sid": 37,
          "location": 2,
          "content": "一脚把门踹开",
          "music": 0.0
        },
        {
          "from": 83.86,
          "to": 85.75,
          "sid": 38,
          "location": 2,
          "content": "这种也是肌肉爆发力",
          "music": 0.0
        },
        {
          "from": 85.75,
          "to": 87.7,
          "sid": 39,
          "location": 2,
          "content": "再比如你是一个渣男",
          "music": 0.0
        },
        {
          "from": 87.7,
          "to": 89.47,
          "sid": 40,
          "location": 2,
          "content": "被你女朋友甩了一巴掌",
          "music": 0.0
        },
        {
          "from": 89.47,
          "to": 92.23,
          "sid": 41,
          "location": 2,
          "content": "这一巴掌用的也是肌肉的爆发力",
          "music": 0.0
        },
        {
          "from": 92.23,
          "to": 96.79,
          "sid": 42,
          "location": 2,
          "content": "所以两者的区别就是肌肉耐受力的特点就是慢",
          "music": 0.0
        },
        {
          "from": 96.79,
          "to": 100.1,
          "sid": 43,
          "location": 2,
          "content": "肌肉爆发力的特点就是快",
          "music": 0.0
        },
        {
          "from": 100.1,
          "to": 104.24,
          "sid": 44,
          "location": 2,
          "content": "你用慢的方式去试图提高快的结果",
          "music": 0.0
        },
        {
          "from": 104.24,
          "to": 105.89,
          "sid": 45,
          "location": 2,
          "content": "那只能是南辕北辙",
          "music": 0.0
        },
        {
          "from": 105.89,
          "to": 107.24,
          "sid": 46,
          "location": 2,
          "content": "方法错误",
          "music": 0.0
        },
        {
          "from": 107.24,
          "to": 108.64,
          "sid": 47,
          "location": 2,
          "content": "这就是这么多年",
          "music": 0.0
        },
        {
          "from": 108.64,
          "to": 112.57,
          "sid": 48,
          "location": 2,
          "content": "我一再反对负重训练练爆发力的原因",
          "music": 0.0
        },
        {
          "from": 112.57,
          "to": 114.44,
          "sid": 49,
          "location": 2,
          "content": "所以我要问你一个问题",
          "music": 0.0
        },
        {
          "from": 114.44,
          "to": 119.8,
          "sid": 50,
          "location": 2,
          "content": "为什么奥运会跳高跳远这些运动项目的运动员",
          "music": 0.0
        },
        {
          "from": 119.8,
          "to": 121.72,
          "sid": 51,
          "location": 2,
          "content": "他们的肌肉都不发达",
          "music": 0.0
        },
        {
          "from": 121.72,
          "to": 123.25,
          "sid": 52,
          "location": 2,
          "content": "反而是偏瘦的呢",
          "music": 0.0
        },
        {
          "from": 123.25,
          "to": 125.16,
          "sid": 53,
          "location": 2,
          "content": "而且他们的肌肉不够发达",
          "music": 0.0
        },
        {
          "from": 125.16,
          "to": 127.59,
          "sid": 54,
          "location": 2,
          "content": "为什么不会影响发力呢",
          "music": 0.0
        },
        {
          "from": 127.59,
          "to": 129.57,
          "sid": 55,
          "location": 2,
          "content": "你可千万别说他们不懂",
          "music": 0.0
        },
        {
          "from": 129.57,
          "to": 131.56,
          "sid": 56,
          "location": 2,
          "content": "或者是他们的教练不懂",
          "music": 0.0
        },
        {
          "from": 131.56,
          "to": 132.52,
          "sid": 57,
          "location": 2,
          "content": "你别忘了",
          "music": 0.0
        },
        {
          "from": 132.52,
          "to": 136.32,
          "sid": 58,
          "location": 2,
          "content": "他们可是这个星球上弹跳力最顶级的一群人",
          "music": 0.0
        },
        {
          "from": 136.32,
          "to": 140.16,
          "sid": 59,
          "location": 2,
          "content": "为什么不去练肌肉去增加力量啊",
          "music": 0.0
        },
        {
          "from": 140.16,
          "to": 142.95,
          "sid": 60,
          "location": 2,
          "content": "如果刚才的内容你真的理解了",
          "music": 0.0
        },
        {
          "from": 142.95,
          "to": 145.62,
          "sid": 61,
          "location": 2,
          "content": "那么这个答案就很显而易见",
          "music": 0.0
        },
        {
          "from": 145.62,
          "to": 147.13,
          "sid": 62,
          "location": 2,
          "content": "回到开头的问题",
          "music": 0.0
        },
        {
          "from": 147.13,
          "to": 150.46,
          "sid": 63,
          "location": 2,
          "content": "为什么练力量会让你越跳越低",
          "music": 0.0
        },
        {
          "from": 150.46,
          "to": 154.81,
          "sid": 64,
          "location": 2,
          "content": "因为增肌会导致你的体重增加",
          "music": 0.0
        },
        {
          "from": 154.81,
          "to": 157.15,
          "sid": 65,
          "location": 2,
          "content": "给自己带来更大的阻力",
          "music": 0.0
        },
        {
          "from": 157.15,
          "to": 159.26,
          "sid": 66,
          "location": 2,
          "content": "降低你摸高的高度",
          "music": 0.0
        },
        {
          "from": 159.26,
          "to": 161.78,
          "sid": 67,
          "location": 2,
          "content": "而且增肌可不是今天撕裂",
          "music": 0.0
        },
        {
          "from": 161.78,
          "to": 163.13,
          "sid": 68,
          "location": 2,
          "content": "明天就长出来的",
          "music": 0.0
        },
        {
          "from": 163.13,
          "to": 165.18,
          "sid": 69,
          "location": 2,
          "content": "需要4~8周的时间",
          "music": 0.0
        },
        {
          "from": 165.18,
          "to": 167.56,
          "sid": 70,
          "location": 2,
          "content": "很多人备考的时间非常短",
          "music": 0.0
        },
        {
          "from": 167.56,
          "to": 170.95,
          "sid": 71,
          "location": 2,
          "content": "所以在你的肌肉被撕裂的那段时间去考试",
          "music": 0.0
        },
        {
          "from": 170.95,
          "to": 172.93,
          "sid": 72,
          "location": 2,
          "content": "你只会跳得越来越低",
          "music": 0.0
        },
        {
          "from": 172.93,
          "to": 174.2,
          "sid": 73,
          "location": 2,
          "content": "是这个原因",
          "music": 0.0
        },
        {
          "from": 174.2,
          "to": 177.05,
          "sid": 74,
          "location": 2,
          "content": "促使我研发出三合一爆破术",
          "music": 0.0
        },
        {
          "from": 177.05,
          "to": 178.7,
          "sid": 75,
          "location": 2,
          "content": "避开了力量训练",
          "music": 0.0
        },
        {
          "from": 178.7,
          "to": 180.13,
          "sid": 76,
          "location": 2,
          "content": "找到发力技巧",
          "music": 0.0
        },
        {
          "from": 180.13,
          "to": 183.48,
          "sid": 77,
          "location": 2,
          "content": "没有看过的同学到我置顶视频去看",
          "music": 0.0
        },
        {
          "from": 183.48,
          "to": 185.4,
          "sid": 78,
          "location": 2,
          "content": "记得点击头像关注我",
          "music": 0.0
        },
        {
          "from": 185.4,
          "to": 187.44,
          "sid": 79,
          "location": 2,
          "content": "我们下一段视频再见",
          "music": 0.0
        }
      ]
    }
  ]
}