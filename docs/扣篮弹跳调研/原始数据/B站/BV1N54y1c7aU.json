  },
  "subs": [
    {
      "part": "P1",
      "lang": "ai-zh",
      "segments": [
        {
          "from": 0.12,
          "to": 2.02,
          "sid": 1,
          "location": 2,
          "content": "自己扣篮不在兄弟们扣",
          "music": 0.0
        },
        {
          "from": 2.02,
          "to": 3.13,
          "sid": 2,
          "location": 2,
          "content": "那就太不仗义了",
          "music": 0.0
        },
        {
          "from": 3.13,
          "to": 6.1,
          "sid": 3,
          "location": 2,
          "content": "今天给大家分享一下提升爆发力的黄金动作",
          "music": 0.0
        },
        {
          "from": 6.1,
          "to": 7.72,
          "sid": 4,
          "location": 2,
          "content": "高翻大家一定要练",
          "music": 0.0
        },
        {
          "from": 7.72,
          "to": 9.7,
          "sid": 5,
          "location": 2,
          "content": "很多兄弟是不在高翻",
          "music": 0.0
        },
        {
          "from": 9.7,
          "to": 11.44,
          "sid": 6,
          "location": 2,
          "content": "接杠的时候都会出现这个问题",
          "music": 0.0
        },
        {
          "from": 11.44,
          "to": 13.12,
          "sid": 7,
          "location": 2,
          "content": "这样手腕压力非常大",
          "music": 0.0
        },
        {
          "from": 13.12,
          "to": 14.38,
          "sid": 8,
          "location": 2,
          "content": "而且非常容易受伤",
          "music": 0.0
        },
        {
          "from": 14.38,
          "to": 16.06,
          "sid": 9,
          "location": 2,
          "content": "首先我们来解决一下这个问题",
          "music": 0.0
        },
        {
          "from": 16.06,
          "to": 17.94,
          "sid": 10,
          "location": 2,
          "content": "在健身房先找到一个卧推椅",
          "music": 0.0
        },
        {
          "from": 17.94,
          "to": 19.77,
          "sid": 11,
          "location": 2,
          "content": "来拉伸一下我们的背阔肌",
          "music": 0.3780487574360518
        },
        {
          "from": 19.77,
          "to": 20.88,
          "sid": 12,
          "location": 2,
          "content": "做这个动作",
          "music": 0.0
        },
        {
          "from": 20.88,
          "to": 24.48,
          "sid": 13,
          "location": 2,
          "content": "我们用手指抵住平凳向下",
          "music": 0.16666666035353606
        },
        {
          "from": 24.48,
          "to": 26.38,
          "sid": 14,
          "location": 2,
          "content": "尽可拉伸我们的背阔肌",
          "music": 0.40259737645471666
        },
        {
          "from": 26.9,
          "to": 29.59,
          "sid": 15,
          "location": 2,
          "content": "然后我们需要去压一下我们的手腕",
          "music": 0.056224897340364406
        },
        {
          "from": 29.59,
          "to": 30.94,
          "sid": 16,
          "location": 2,
          "content": "这个是正面的感",
          "music": 0.22222220576131574
        },
        {
          "from": 30.94,
          "to": 33.3,
          "sid": 17,
          "location": 2,
          "content": "觉到最大的拉伸感以后停留30秒",
          "music": 0.0
        },
        {
          "from": 33.3,
          "to": 34.86,
          "sid": 18,
          "location": 2,
          "content": "然后是反面的拉伸",
          "music": 0.0
        },
        {
          "from": 34.86,
          "to": 38.0,
          "sid": 19,
          "location": 2,
          "content": "反面的时候我们身体就要向后",
          "music": 0.2477064106556689
        },
        {
          "from": 38.16,
          "to": 40.82,
          "sid": 20,
          "location": 2,
          "content": "其实这个时候我感觉小臂的拉伸感已经很强了",
          "music": 0.0
        },
        {
          "from": 40.82,
          "to": 42.86,
          "sid": 21,
          "location": 2,
          "content": "一样的也是停留30秒前后",
          "music": 0.0
        },
        {
          "from": 42.86,
          "to": 43.98,
          "sid": 22,
          "location": 2,
          "content": "我们各做三组",
          "music": 0.0
        },
        {
          "from": 43.98,
          "to": 45.12,
          "sid": 23,
          "location": 2,
          "content": "我们接杠的时候",
          "music": 0.0
        },
        {
          "from": 45.12,
          "to": 47.02,
          "sid": 24,
          "location": 2,
          "content": "其实压力并不在我们的手腕上",
          "music": 0.0
        },
        {
          "from": 47.02,
          "to": 49.12,
          "sid": 25,
          "location": 2,
          "content": "而是在我们三角肌前束上",
          "music": 0.0
        },
        {
          "from": 49.12,
          "to": 50.44,
          "sid": 26,
          "location": 2,
          "content": "最后接杠的时候",
          "music": 0.0
        },
        {
          "from": 50.44,
          "to": 52.03,
          "sid": 27,
          "location": 2,
          "content": "我们可以用手指勾住",
          "music": 0.2830188501246018
        },
        {
          "from": 52.03,
          "to": 54.56,
          "sid": 28,
          "location": 2,
          "content": "看三根手指系上就够了",
          "music": 0.07177033149424196
        },
        {
          "from": 56.76,
          "to": 58.68,
          "sid": 29,
          "location": 2,
          "content": "然后是高翻的握距啊",
          "music": 0.26388887056327376
        },
        {
          "from": 58.68,
          "to": 61.44,
          "sid": 30,
          "location": 2,
          "content": "握的太宽或太窄都不合适",
          "music": 0.19047618291761367
        },
        {
          "from": 61.44,
          "to": 64.87,
          "sid": 31,
          "location": 2,
          "content": "我们得根据自己的臂展来选择合适的握距",
          "music": 0.0
        },
        {
          "from": 64.87,
          "to": 68.44,
          "sid": 32,
          "location": 2,
          "content": "像我的B站窝在这个位置就刚刚合适",
          "music": 0.0
        },
        {
          "from": 68.44,
          "to": 69.97,
          "sid": 33,
          "location": 2,
          "content": "向下屈髋屈膝",
          "music": 0.0
        },
        {
          "from": 69.97,
          "to": 71.78,
          "sid": 34,
          "location": 2,
          "content": "将杠铃滑动到膝盖上方",
          "music": 0.0
        },
        {
          "from": 71.78,
          "to": 73.1,
          "sid": 35,
          "location": 2,
          "content": "不要过度屈膝",
          "music": 0.0
        },
        {
          "from": 73.1,
          "to": 75.68,
          "sid": 36,
          "location": 2,
          "content": "有种膝盖往前跪的姿态就是错误的",
          "music": 0.0
        },
        {
          "from": 75.68,
          "to": 76.52,
          "sid": 37,
          "location": 2,
          "content": "随后挺胸",
          "music": 0.0
        },
        {
          "from": 76.52,
          "to": 77.63,
          "sid": 38,
          "location": 2,
          "content": "保持背部刚性",
          "music": 0.27027024592159704
        },
        {
          "from": 77.63,
          "to": 78.9,
          "sid": 39,
          "location": 2,
          "content": "错误示范",
          "music": 0.0
        },
        {
          "from": 78.9,
          "to": 82.5,
          "sid": 40,
          "location": 2,
          "content": "我们应该尽量保证杠铃向下和向上的时候",
          "music": 0.0
        },
        {
          "from": 82.5,
          "to": 83.61,
          "sid": 41,
          "location": 2,
          "content": "全程贴着大腿",
          "music": 0.0
        },
        {
          "from": 83.61,
          "to": 86.52,
          "sid": 42,
          "location": 2,
          "content": "可以多多少少向上或向下滑动的感觉",
          "music": 0.0
        },
        {
          "from": 86.52,
          "to": 87.42,
          "sid": 43,
          "location": 2,
          "content": "熟练之后",
          "music": 0.0
        },
        {
          "from": 87.42,
          "to": 88.5,
          "sid": 44,
          "location": 2,
          "content": "在杠铃向上时",
          "music": 0.0
        },
        {
          "from": 88.5,
          "to": 90.96,
          "sid": 45,
          "location": 2,
          "content": "快速完成髋膝踝三倍伸展后",
          "music": 0.0
        },
        {
          "from": 90.96,
          "to": 92.58,
          "sid": 46,
          "location": 2,
          "content": "分腿接杠",
          "music": 0.0
        }
      ]
    }
  ]
}