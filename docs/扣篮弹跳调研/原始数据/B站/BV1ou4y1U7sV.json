        },
        {
          "from": 33.66,
          "to": 34.97,
          "sid": 20,
          "location": 2,
          "content": "高组数的练习方式",
          "music": 0.0
        },
        {
          "from": 34.97,
          "to": 35.93,
          "sid": 21,
          "location": 2,
          "content": "慢下快起",
          "music": 0.0
        },
        {
          "from": 35.93,
          "to": 38.56,
          "sid": 22,
          "location": 2,
          "content": "重点提升我们的爆发力和神经募集能力",
