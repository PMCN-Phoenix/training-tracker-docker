        },
        {
          "from": 18.27,
          "to": 19.02,
          "sid": 12,
          "location": 2,
          "content": "第一点",
          "music": 0.0
        },
        {
          "from": 19.02,
          "to": 21.57,
          "sid": 13,
          "location": 2,
          "content": "好的深蹲训练应当在提升激励的同时",
          "music": 0.0
        },
        {
          "from": 21.57,
          "to": 22.939,
          "sid": 14,
          "location": 2,
          "content": "起到预防伤病的作用",
          "music": 0.0
        },
        {
          "from": 22.939,
          "to": 25.429,
          "sid": 15,
          "location": 2,
          "content": "而绝不应该成为我们关节损伤的来源",
          "music": 0.0
        },
        {
          "from": 25.429,
          "to": 27.409,
          "sid": 16,
          "location": 2,
          "content": "因此在进行大重量深蹲之前",
          "music": 0.0
        },
        {
          "from": 27.409,
          "to": 29.359,
          "sid": 17,
          "location": 2,
          "content": "建立动作模式阶段尤为重要",
