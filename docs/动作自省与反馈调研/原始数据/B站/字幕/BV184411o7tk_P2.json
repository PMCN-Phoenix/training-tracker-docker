[
 {
  "from": 0.64,
  "to": 2.18,
  "sid": 1,
  "location": 2,
  "content": "大家好，查德·威尔逊·史密斯在这里"
 },
 {
  "from": 2.18,
  "to": 4.97,
  "sid": 2,
  "location": 2,
  "content": "为您带来我们系列的第二部分"
 },
 {
  "from": 4.97,
  "to": 6.69,
  "sid": 3,
  "location": 2,
  "content": "大板凳技术的支柱"
 },
 {
  "from": 6.69,
  "to": 7.49,
  "sid": 4,
  "location": 2,
  "content": "如果你还没有退房"
 },
 {
  "from": 7.49,
  "to": 8.189,
  "sid": 5,
  "location": 2,
  "content": "第一部分"
 },
 {
  "from": 8.189,
  "to": 10.59,
  "sid": 6,
  "location": 2,
  "content": "覆盖脚的位置和脚的压力"
 },
 {
  "from": 10.59,
  "to": 12.499,
  "sid": 7,
  "location": 2,
  "content": "今天一定要这样做"
 },
 {
  "from": 12.499,
  "to": 15.18,
  "sid": 8,
  "location": 2,
  "content": "我们要解决上背部的位置"
 },
 {
  "from": 15.18,
  "to": 19.32,
  "sid": 9,
  "location": 2,
  "content": "以及如何锁定上背部以获得一个很好的设置"
 },
 {
  "from": 19.32,
  "to": 22.26,
  "sid": 10,
  "location": 2,
  "content": "IPF世界冠军也加入了我的行列"
 },
 {
  "from": 22.26,
  "to": 23.92,
  "sid": 11,
  "location": 2,
  "content": "IPF世界纪录保持者"
 },
 {
  "from": 23.92,
  "to": 24.84,
  "sid": 12,
  "location": 2,
  "content": "三次"
 },
 {
  "from": 24.84,
  "to": 28.16,
  "sid": 13,
  "location": 2,
  "content": "板凳上的美国冠军和美国纪录保持者"
 },
 {
  "from": 28.16,
  "to": 29.81,
  "sid": 14,
  "location": 2,
  "content": "死升和总升降"
 },
 {
  "from": 30.09,
  "to": 30.65,
  "sid": 15,
  "location": 2,
  "content": "我说"
 },
 {
  "from": 30.65,
  "to": 31.61,
  "sid": 16,
  "location": 2,
  "content": "世界纪录保持者"
 },
 {
  "from": 31.61,
  "to": 31.85,
  "sid": 17,
  "location": 2,
  "content": "我也是"
 },
 {
  "from": 31.85,
  "to": 32.31,
  "sid": 18,
  "location": 2,
  "content": "对呀"
 },
 {
  "from": 32.31,
  "to": 34.199,
  "sid": 19,
  "location": 2,
  "content": "好的，总记录保持者"
 },
 {
  "from": 34.3,
  "to": 35.24,
  "sid": 20,
  "location": 2,
  "content": "玛丽莎小姐"
 },
 {
  "from": 35.24,
  "to": 36.14,
  "sid": 21,
  "location": 2,
  "content": "你今天上午好吗？"
 },
 {
  "from": 36.14,
  "to": 36.38,
  "sid": 22,
  "location": 2,
  "content": "好的"
 },
 {
  "from": 37.46,
  "to": 40.6,
  "sid": 23,
  "location": 2,
  "content": "所以这对"
 },
 {
  "from": 40.6,
  "to": 44.41,
  "sid": 24,
  "location": 2,
  "content": "第一步对良好的上背部位置至关重要"
 },
 {
  "from": 44.73,
  "to": 46.85,
  "sid": 25,
  "location": 2,
  "content": "并正确地利用上背部"
 },
 {
  "from": 46.85,
  "to": 50.04,
  "sid": 26,
  "location": 2,
  "content": "在卧推是肩胛骨控制"
 },
 {
  "from": 50.72,
  "to": 52.52,
  "sid": 27,
  "location": 2,
  "content": "演示肩胛骨控制"
 },
 {
  "from": 52.52,
  "to": 56.94,
  "sid": 28,
  "location": 2,
  "content": "不仅对你能举起多少重量至关重要"
 },
 {
  "from": 56.94,
  "to": 59.579,
  "sid": 29,
  "location": 2,
  "content": "但也延长了"
 },
 {
  "from": 59.579,
  "to": 60.139,
  "sid": 30,
  "location": 2,
  "content": "你知道的"
 },
 {
  "from": 60.139,
  "to": 63.729,
  "sid": 31,
  "location": 2,
  "content": "通过保持肩膀健康来创造卧推的寿命"
 },
 {
  "from": 63.729,
  "to": 67.429,
  "sid": 32,
  "location": 2,
  "content": "如果你不能正确地缩回和压低肩胛骨"
 },
 {
  "from": 67.429,
  "to": 67.789,
  "sid": 33,
  "location": 2,
  "content": "你知道吗"
 },
 {
  "from": 67.789,
  "to": 69.129,
  "sid": 34,
  "location": 2,
  "content": "让你平躺着"
 },
 {
  "from": 69.129,
  "to": 71.32,
  "sid": 35,
  "location": 2,
  "content": "肩膀不会稳定"
 },
 {
  "from": 71.32,
  "to": 72.65,
  "sid": 36,
  "location": 2,
  "content": "它会导致肩膀"
 },
 {
  "from": 72.65,
  "to": 73.29,
  "sid": 37,
  "location": 2,
  "content": "呃"
 },
 {
  "from": 73.29,
  "to": 76.35,
  "sid": 38,
  "location": 2,
  "content": "在某个时候疼痛和可能的伤害"
 },
 {
  "from": 76.35,
  "to": 79.38,
  "sid": 39,
  "location": 2,
  "content": "所以我们不仅想最大限度地增加重量"
 },
 {
  "from": 79.38,
  "to": 81.26,
  "sid": 40,
  "location": 2,
  "content": "你能举起的重量"
 },
 {
  "from": 81.26,
  "to": 84.92,
  "sid": 41,
  "location": 2,
  "content": "但也要确保你在能做到的时候保持健康"
 },
 {
  "from": 84.92,
  "to": 87.88,
  "sid": 42,
  "location": 2,
  "content": "所以你可以做你喜欢的事情很长一段时间"
 },
 {
  "from": 87.9,
  "to": 90.84,
  "sid": 43,
  "location": 2,
  "content": "展示肩胛骨控制的第一部分"
 },
 {
  "from": 90.84,
  "to": 93.8,
  "sid": 44,
  "location": 2,
  "content": "是正确缩回肩胛骨的能力"
 },
 {
  "from": 93.8,
  "to": 96.86,
  "sid": 45,
  "location": 2,
  "content": "所以Immersa要把她的肩胛骨拉在一起"
 },
 {
  "from": 96.86,
  "to": 98.26,
  "sid": 46,
  "location": 2,
  "content": "真的很容易的色调"
 },
 {
  "from": 98.26,
  "to": 101.13,
  "sid": 47,
  "location": 2,
  "content": "作为教练只是说捏我的手指"
 },
 {
  "from": 101.13,
  "to": 104.03,
  "sid": 48,
  "location": 2,
  "content": "把它们放在肩胛骨之间，现在捏手指"
 },
 {
  "from": 104.03,
  "to": 107.639,
  "sid": 49,
  "location": 2,
  "content": "我们现在要做的是压住肩胛骨"
 },
 {
  "from": 107.639,
  "to": 109.06,
  "sid": 50,
  "location": 2,
  "content": "把它们拉下来"
 },
 {
  "from": 109.16,
  "to": 113.16,
  "sid": 51,
  "location": 2,
  "content": "一个常见的错误是抬高肩胛骨"
 },
 {
  "from": 113.16,
  "to": 115.16,
  "sid": 52,
  "location": 2,
  "content": "所以他们走到一起"
 },
 {
  "from": 115.16,
  "to": 117.65,
  "sid": 53,
  "location": 2,
  "content": "所有的东西都在上面的陷阱里"
 },
 {
  "from": 117.65,
  "to": 120.17,
  "sid": 54,
  "location": 2,
  "content": "这会导致各种问题"
 },
 {
  "from": 120.17,
  "to": 121.41,
  "sid": 55,
  "location": 2,
  "content": "技术问题"
 },
 {
  "from": 121.41,
  "to": 123.69,
  "sid": 56,
  "location": 2,
  "content": "或者你的胸部摸得太高了"
 },
 {
  "from": 123.69,
  "to": 126.71,
  "sid": 57,
  "location": 2,
  "content": "以及肩部健康问题"
 },
 {
  "from": 126.71,
  "to": 130.37,
  "sid": 58,
  "location": 2,
  "content": "还有很多前三角肌或二头肌肌腱疼痛"
 },
 {
  "from": 130.37,
  "to": 133.01,
  "sid": 59,
  "location": 2,
  "content": "所以我们需要确保肩胛骨在一起"
 },
 {
  "from": 133.01,
  "to": 135.28,
  "sid": 60,
  "location": 2,
  "content": "缩回然后压低"
 },
 {
  "from": 135.28,
  "to": 136.58,
  "sid": 61,
  "location": 2,
  "content": "当你正确地这样做时"
 },
 {
  "from": 136.58,
  "to": 140.61,
  "sid": 62,
  "location": 2,
  "content": "你应该会感觉到背部中部有很大的张力"
 },
 {
  "from": 140.61,
  "to": 141.63,
  "sid": 63,
  "location": 2,
  "content": "那种"
 },
 {
  "from": 141.63,
  "to": 142.97,
  "sid": 64,
  "location": 2,
  "content": "上背部的底部"
 },
 {
  "from": 142.97,
  "to": 144.33,
  "sid": 65,
  "location": 2,
  "content": "中背部较高的部分"
 },
 {
  "from": 144.33,
  "to": 146.3,
  "sid": 66,
  "location": 2,
  "content": "就在较低的陷阱所在的地方"
 },
 {
  "from": 146.86,
  "to": 147.22,
  "sid": 67,
  "location": 2,
  "content": "所以说"
 },
 {
  "from": 147.22,
  "to": 148.82,
  "sid": 68,
  "location": 2,
  "content": "现在我们要复习两个练习"
 },
 {
  "from": 148.82,
  "to": 154.46,
  "sid": 69,
  "location": 2,
  "content": "帮助您提高肩胛骨的活动能力和控制墙滑梯及其"
 },
 {
  "from": 154.979,
  "to": 157.719,
  "sid": 70,
  "location": 2,
  "content": "当我们开始为卧推热身时"
 },
 {
  "from": 157.719,
  "to": 158.499,
  "sid": 71,
  "location": 2,
  "content": "我想确定"
 },
 {
  "from": 158.499,
  "to": 162.14,
  "sid": 72,
  "location": 2,
  "content": "我们上背部的肌肉是温暖和方便的"
 },
 {
  "from": 162.14,
  "to": 165.38,
  "sid": 73,
  "location": 2,
  "content": "我们的肩膀可以通过全方位的运动来表达"
 },
 {
  "from": 165.38,
  "to": 167.52,
  "sid": 74,
  "location": 2,
  "content": "所以我们可以压最重的重量"
 },
 {
  "from": 167.52,
  "to": 169.71,
  "sid": 75,
  "location": 2,
  "content": "也让我们的肩膀保持健康"
 },
 {
  "from": 169.71,
  "to": 173.25,
  "sid": 76,
  "location": 2,
  "content": "默萨要演示的第一个练习是墙滑梯"
 },
 {
  "from": 173.25,
  "to": 173.91,
  "sid": 77,
  "location": 2,
  "content": "用于墙壁滑梯"
 },
 {
  "from": 173.91,
  "to": 176.969,
  "sid": 78,
  "location": 2,
  "content": "你想站在离墙6到8英寸的地方"
 },
 {
  "from": 176.969,
  "to": 180.36,
  "sid": 79,
  "location": 2,
  "content": "把手掌的边缘靠在墙上"
 },
 {
  "from": 180.36,
  "to": 181.92,
  "sid": 80,
  "location": 2,
  "content": "推到墙上"
 },
 {
  "from": 181.92,
  "to": 184.82,
  "sid": 81,
  "location": 2,
  "content": "当你的手在墙上滑动时"
 },
 {
  "from": 184.82,
  "to": 188.82,
  "sid": 82,
  "location": 2,
  "content": "然后在运动结束时增加一点额外的运动范围"
 },
 {
  "from": 188.82,
  "to": 190.72,
  "sid": 83,
  "location": 2,
  "content": "你要靠在墙上"
 },
 {
  "from": 190.72,
  "to": 194.73,
  "sid": 84,
  "location": 2,
  "content": "也要专注于保持在中立肋骨位置"
 },
 {
  "from": 194.73,
  "to": 195.67,
  "sid": 85,
  "location": 2,
  "content": "肋骨向下"
 },
 {
  "from": 195.67,
  "to": 198.46,
  "sid": 86,
  "location": 2,
  "content": "整个肋骨笼和骨盆对齐"
 },
 {
  "from": 198.46,
  "to": 201.54,
  "sid": 87,
  "location": 2,
  "content": "你不想在顶部进行大量的扩展"
 },
 {
  "from": 201.54,
  "to": 203.08,
  "sid": 88,
  "location": 2,
  "content": "在运动结束时"
 },
 {
  "from": 203.08,
  "to": 206.84,
  "sid": 89,
  "location": 2,
  "content": "因为我们希望我们希望活动范围来自肩膀"
 },
 {
  "from": 206.84,
  "to": 209.68,
  "sid": 90,
  "location": 2,
  "content": "不是因为伸展腰椎"
 },
 {
  "from": 210.339,
  "to": 212.139,
  "sid": 91,
  "location": 2,
  "content": "接下来我们的卧推热身"
 },
 {
  "from": 212.139,
  "to": 214.779,
  "sid": 92,
  "location": 2,
  "content": "是一种叫做TS TS的钻头"
 },
 {
  "from": 214.779,
  "to": 218.68,
  "sid": 93,
  "location": 2,
  "content": "要俯卧在倾斜的长椅上"
 },
 {
  "from": 218.78,
  "to": 220.3,
  "sid": 94,
  "location": 2,
  "content": "让手臂垂下来"
 },
 {
  "from": 220.3,
  "to": 222.44,
  "sid": 95,
  "location": 2,
  "content": "我们要用手臂做这些字母"
 },
 {
  "from": 222.44,
  "to": 225.2,
  "sid": 96,
  "location": 2,
  "content": "所以首先我直接站在尸体前面"
 },
 {
  "from": 225.2,
  "to": 227.54,
  "sid": 97,
  "location": 2,
  "content": "你可以竖起大拇指，也可以放下手掌"
 },
 {
  "from": 227.54,
  "to": 229.32,
  "sid": 98,
  "location": 2,
  "content": "你在那里更舒服的"
 },
 {
  "from": 229.32,
  "to": 230.92,
  "sid": 99,
  "location": 2,
  "content": "然后再下来"
 },
 {
  "from": 230.959,
  "to": 232.139,
  "sid": 100,
  "location": 2,
  "content": "我要去Y"
 },
 {
  "from": 232.139,
  "to": 233.879,
  "sid": 101,
  "location": 2,
  "content": "它是以四十五度的角度添加的"
 },
 {
  "from": 233.879,
  "to": 237.08,
  "sid": 102,
  "location": 2,
  "content": "大拇指在这里"
 },
 {
  "from": 237.08,
  "to": 239.88,
  "sid": 103,
  "location": 2,
  "content": "然后最后直接到旁边"
 },
 {
  "from": 239.88,
  "to": 241.36,
  "sid": 104,
  "location": 2,
  "content": "手掌向下"
 },
 {
  "from": 243.079,
  "to": 244.559,
  "sid": 105,
  "location": 2,
  "content": "你经历的每一封信"
 },
 {
  "from": 244.559,
  "to": 244.959,
  "sid": 106,
  "location": 2,
  "content": "你想"
 },
 {
  "from": 244.959,
  "to": 248.209,
  "sid": 107,
  "location": 2,
  "content": "确保你的肩胛骨有明显的挤压"
 },
 {
  "from": 248.209,
  "to": 251.729,
  "sid": 108,
  "location": 2,
  "content": "肩胛骨在一起，就像一个计数在每个代表的顶部"
 },
 {
  "from": 251.729,
  "to": 253.449,
  "sid": 109,
  "location": 2,
  "content": "让我们每封信再来一次"
 },
 {
  "from": 253.449,
  "to": 256.559,
  "sid": 110,
  "location": 2,
  "content": "我径直走在Y前面"
 },
 {
  "from": 256.559,
  "to": 261.73,
  "sid": 111,
  "location": 2,
  "content": "以45度角，并再次直接向侧面伸出"
 },
 {
  "from": 261.73,
  "to": 265.77,
  "sid": 112,
  "location": 2,
  "content": "确保每个动作都挤压顶部的肩胛骨"
 },
 {
  "from": 265.97,
  "to": 267.71,
  "sid": 113,
  "location": 2,
  "content": "对于初学者来说"
 },
 {
  "from": 267.71,
  "to": 269.93,
  "sid": 114,
  "location": 2,
  "content": "你知道不需要额外的重量"
 },
 {
  "from": 269.93,
  "to": 271.05,
  "sid": 115,
  "location": 2,
  "content": "但如果你想"
 },
 {
  "from": 271.05,
  "to": 274.27,
  "sid": 116,
  "location": 2,
  "content": "你可以在手里增加2.5或5磅的重量"
 },
 {
  "from": 274.27,
  "to": 276.89,
  "sid": 117,
  "location": 2,
  "content": "所以现在你已经提高了你的肩胛骨的活动能力和控制力"
 },
 {
  "from": 276.89,
  "to": 278.65,
  "sid": 118,
  "location": 2,
  "content": "随着墙的滑动和它的"
 },
 {
  "from": 278.65,
  "to": 282.59,
  "sid": 119,
  "location": 2,
  "content": "现在我们可以看看上背部是如何在你设置的时候发挥作用的"
 },
 {
  "from": 282.59,
  "to": 286.54,
  "sid": 120,
  "location": 2,
  "content": "以及通过设置来提高其密封性的方法"
 },
 {
  "from": 286.82,
  "to": 287.84,
  "sid": 121,
  "location": 2,
  "content": "所以最优"
 },
 {
  "from": 287.84,
  "to": 292.46,
  "sid": 122,
  "location": 2,
  "content": "板凳位置会让运动员在陷阱上尽可能高"
 },
 {
  "from": 292.76,
  "to": 294.32,
  "sid": 123,
  "location": 2,
  "content": "所以当玛丽莎在这里安顿下来的时候"
 },
 {
  "from": 294.32,
  "to": 296.54,
  "sid": 124,
  "location": 2,
  "content": "这是一个很好的练习"
 },
 {
  "from": 296.54,
  "to": 298.62,
  "sid": 125,
  "location": 2,
  "content": "如果你在长凳上做臀肌桥接"
 },
 {
  "from": 298.62,
  "to": 301.95,
  "sid": 126,
  "location": 2,
  "content": "这给了你一些空间来缩回和压低"
 },
 {
  "from": 301.95,
  "to": 302.91,
  "sid": 127,
  "location": 2,
  "content": "肩胛骨"
 },
 {
  "from": 302.91,
  "to": 306.47,
  "sid": 128,
  "location": 2,
  "content": "让玛丽莎真正感受到陷阱的重量"
 },
 {
  "from": 306.47,
  "to": 309.27,
  "sid": 129,
  "location": 2,
