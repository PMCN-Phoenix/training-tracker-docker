[
 {
  "content": "刻意练习是一种有意识且高度结构化的学习方式",
  "from": 0.22,
  "location": 2,
  "music": 0.0,
  "sid": 1,
  "to": 4.62
 },
 {
  "content": "通过做",
  "from": 4.62,
  "location": 2,
  "music": 0.0,
  "sid": 2,
  "to": 5.81
 },
 {
  "content": "它是一种持续实验的过程",
  "from": 5.81,
  "location": 2,
  "music": 0.0,
  "sid": 3,
  "to": 8.97
 },
 {
  "content": "首先达到精通，然后最终达到特定技能的完全自动化",
  "from": 8.97,
  "location": 2,
  "music": 0.0,
  "sid": 4,
  "to": 14.719
 },
 {
  "content": "2014年发表在《心理学科学》杂志的一项研究认为，这可以将我们的表现提高20%-60%",
  "from": 14.719,
  "location": 2,
  "music": 0.0,
  "sid": 5,
  "to": 21.519
 },
 {
  "content": "在游戏方面提高60%",
  "from": 21.519,
  "location": 2,
  "music": 0.0,
  "sid": 6,
  "to": 23.03
 },
 {
  "content": "在音乐方面提高10%-20%，在体育方面提高18%",
  "from": 23.03,
  "location": 2,
  "music": 0.0,
  "sid": 7,
  "to": 27.25
 },
 {
  "content": "以下是一些如何做好它的建议",
  "from": 27.25,
  "location": 2,
  "music": 0.0,
  "sid": 8,
  "to": 30.55
 },
 {
  "content": "定义成功并刻意练习，定义你所需练习的所有元素以成为成功",
  "from": 32.18,
  "location": 2,
  "music": 0.0,
  "sid": 9,
  "to": 40.239
 },
 {
  "content": "然后有意识地一个一个练习每个元素，就像网球一样",
  "from": 40.239,
  "location": 2,
  "music": 0.0,
  "sid": 10,
  "to": 44.999
 },
 {
  "content": "这可能是你的服务，然后是你的工作",
  "from": 44.999,
  "location": 2,
  "music": 0.0,
  "sid": 11,
  "to": 48.65
 },
 {
  "content": "如果你想成为一名专业的咖啡师",
  "from": 48.65,
  "location": 2,
  "music": 0.0,
  "sid": 12,
  "to": 51.33
 },
 {
  "content": "首先完美你的移动来制作浓缩咖啡",
  "from": 51.33,
  "location": 2,
  "music": 0.0,
  "sid": 13,
  "to": 54.23
 },
 {
  "content": "然后你的技能来提供理想的咖啡",
  "from": 54.23,
  "location": 2,
  "music": 0.0,
  "sid": 14,
  "to": 57.65
 },
 {
  "content": "计划",
  "from": 59.06,
  "location": 2,
  "music": 0.0,
  "sid": 15,
  "to": 59.82
 },
 {
  "content": "反思并做笔记",
  "from": 59.82,
  "location": 2,
  "music": 0.0,
  "sid": 16,
  "to": 61.58
 },
 {
  "content": "规划你的练习日程",
  "from": 62.82,
  "location": 2,
  "music": 0.0,
  "sid": 17,
  "to": 64.52
 },
 {
  "content": "例如",
  "from": 64.52,
  "location": 2,
  "music": 0.0,
  "sid": 18,
  "to": 65.22
 },
 {
  "content": "在每个会议后，在一本笔记本上",
  "from": 65.22,
  "location": 2,
  "music": 0.0,
  "sid": 19,
  "to": 67.91
 },
 {
  "content": "反思并写下你所发现的",
  "from": 67.91,
  "location": 2,
  "music": 0.0,
  "sid": 20,
  "to": 70.53
 },
 {
  "content": "什么有效",
  "from": 70.53,
  "location": 2,
  "music": 0.0,
  "sid": 21,
  "to": 71.69
 },
 {
  "content": "什么无效",
  "from": 71.69,
  "location": 2,
  "music": 0.0,
  "sid": 22,
  "to": 73.15
 },
 {
  "content": "想法是了解特定训练如何提高你的技能",
  "from": 73.15,
  "location": 2,
  "music": 0.0,
  "sid": 23,
  "to": 78.14
 },
 {
  "content": "然后进行实验",
  "from": 78.14,
  "location": 2,
  "music": 0.0,
  "sid": 24,
  "to": 79.46
 },
 {
  "content": "以找到新的方法，甚至更好的方法来实现你的目标",
  "from": 79.46,
  "location": 2,
  "music": 0.0,
  "sid": 25,
  "to": 83.7
 },
 {
  "content": "慢慢来，建立良好的肌肉记忆基础，练习要慢且正确",
  "from": 85.32,
  "location": 2,
  "music": 0.0,
  "sid": 26,
  "to": 92.21
 },
 {
  "content": "如果我们太快",
  "from": 92.21,
  "location": 2,
  "music": 0.0,
  "sid": 27,
  "to": 93.85
 },
 {
  "content": "我们可能会学习并内化错误的技能",
  "from": 93.85,
  "location": 2,
  "music": 0.0,
  "sid": 28,
  "to": 97.19
 },
 {
  "content": "这可能会给追求精通带来可怕的后果",
  "from": 97.19,
  "location": 2,
  "music": 0.0,
  "sid": 29,
  "to": 101.51
 },
 {
  "content": "我们的大脑需要时间发展",
  "from": 101.51,
  "location": 2,
  "music": 0.0,
  "sid": 30,
  "to": 103.84
 },
 {
  "content": "所以从慢开始",
  "from": 103.84,
  "location": 2,
  "music": 0.0,
  "sid": 31,
  "to": 105.28
 },
 {
  "content": "然后逐渐增加速度，直到你全力以赴",
  "from": 105.28,
  "location": 2,
  "music": 0.0,
  "sid": 32,
  "to": 108.58
 },
 {
  "content": "你已经有了",
  "from": 108.58,
  "location": 2,
  "music": 0.0,
  "sid": 33,
  "to": 109.96
 },
 {
  "content": "限制你的训练会话来集中注意力",
  "from": 111.269,
  "location": 2,
  "music": 0.0,
  "sid": 34,
  "to": 113.89
 },
 {
  "content": "刻意练习是困难的",
  "from": 114.17,
  "location": 2,
  "music": 0.0,
  "sid": 35,
  "to": 115.97
 },
 {
  "content": "精神工作",
  "from": 115.97,
  "location": 2,
  "music": 0.0,
  "sid": 36,
  "to": 117.15
 },
 {
  "content": "限制训练时间，让你能够保持专注",
  "from": 117.15,
  "location": 2,
  "music": 0.0,
  "sid": 37,
  "to": 122.23
 },
 {
  "content": "这可能是15分钟，如果你年轻，60分钟如果你年纪大",
  "from": 122.23,
  "location": 2,
  "music": 0.0,
  "sid": 38,
  "to": 127.25
 },
 {
  "content": "年轻的舍和僧人早上练习2小时，下午练习2小时",
  "from": 132.23,
  "location": 2,
  "music": 0.0,
  "sid": 39,
  "to": 137.23
 },
 {
  "content": "为了保持他们的注意力，",
  "from": 137.23,
  "location": 2,
  "music": 0.0,
  "sid": 40,
  "to": 139.1
 },
 {
  "content": "他们每10分钟切换一种练习方式，",
  "from": 139.1,
  "location": 2,
  "music": 0.0,
  "sid": 41,
  "to": 142.74
 },
 {
  "content": "最大化练习时间，",
  "from": 144.3,
  "location": 2,
  "music": 0.0,
  "sid": 42,
  "to": 146.72
 },
 {
  "content": "传奇篮球教练约翰·伍登曾经让他的每个球员练习，",
  "from": 146.8,
  "location": 2,
  "music": 0.0,
  "sid": 43,
  "to": 151.4
 },
 {
  "content": "穿上袜子和鞋子，以便他们能很快地完成，",
  "from": 151.4,
  "location": 2,
  "music": 0.0,
  "sid": 44,
  "to": 155.35
 },
 {
  "content": "通过这样做，",
  "from": 155.35,
  "location": 2,
  "music": 0.0,
  "sid": 45,
  "to": 156.49
 },
 {
  "content": "他最大化了练习投球和与团队讨论比赛策略的时间，",
  "from": 156.49,
  "location": 2,
  "music": 0.0,
  "sid": 46,
  "to": 162.35
 },
 {
  "content": "如果你练习800米跑，追踪小的进步间隔，",
  "from": 163.82,
  "location": 2,
  "music": 0.0,
  "sid": 47,
  "to": 169.24
 },
 {
  "content": "计算毫秒，",
  "from": 169.24,
  "location": 2,
  "music": 0.0,
  "sid": 48,
  "to": 170.66
 },
 {
  "content": "而不是分钟，如果你在锻炼",
  "from": 170.66,
  "location": 2,
  "music": 0.0,
  "sid": 49,
  "to": 173.42
 },
 {
  "content": "或者练习控制你的饮食",
  "from": 173.42,
  "location": 2,
  "music": 0.0,
  "sid": 50,
  "to": 175.46
 },
 {
  "content": "测量毫克和毫米",
  "from": 175.46,
  "location": 2,
  "music": 0.0,
  "sid": 51,
  "to": 178.14
 },
 {
  "content": "你测量的数据点越小",
  "from": 178.14,
  "location": 2,
  "music": 0.0,
  "sid": 52,
  "to": 180.24
 },
 {
  "content": "你进展得越快",
  "from": 180.24,
  "location": 2,
  "music": 0.0,
  "sid": 53,
  "to": 182.0
 },
 {
  "content": "你的动力就越强，继续下去",
  "from": 182.0,
  "location": 2,
  "music": 0.0,
  "sid": 54,
  "to": 185.22
 },
 {
  "content": "模仿练习",
  "from": 186.65,
  "location": 2,
  "music": 0.0,
  "sid": 55,
  "to": 187.99
 },
 {
  "content": "而不是表现",
  "from": 187.99,
  "location": 2,
  "music": 0.0,
  "sid": 56,
  "to": 189.64
 },
 {
  "content": "我们在屏幕上或在舞台上看到的顶级表现",
  "from": 189.64,
  "location": 2,
  "music": 0.0,
  "sid": 57,
  "to": 193.0
 },
 {
  "content": "是幕后无尽努力的结果",
  "from": 193.0,
  "location": 2,
  "music": 0.0,
  "sid": 58,
  "to": 196.7
 },
 {
  "content": "如果你想成为像帕瓦罗蒂一样的歌剧明星",
  "from": 196.7,
