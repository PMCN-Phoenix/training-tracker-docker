  "content": "接着8点吟唱",
  "from": 284.0,
  "location": 2,
  "music": 0.0,
  "sid": 85,
  "to": 286.5
 },
 {
  "content": "10点冥想，准备就寝",
  "from": 286.5,
  "location": 2,
  "music": 0.0,
  "sid": 86,
  "to": 289.89
 },
 {
  "content": "普通人可以每天开始15分钟",
  "from": 289.89,
  "location": 2,
  "music": 0.0,
  "sid": 87,
  "to": 293.83
 },
 {
  "content": "然后逐渐增加训练时间",
