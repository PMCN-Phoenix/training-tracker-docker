[
 {
  "from": 4.1,
  "to": 6.3,
  "sid": 1,
  "location": 2,
  "content": "你怎么了？"
 },
 {
  "from": 6.3,
  "to": 6.46,
  "sid": 2,
  "location": 2,
  "content": "伙计们"
 },
 {
  "from": 6.46,
  "to": 7.08,
  "sid": 3,
  "location": 2,
  "content": "杰夫·卡瓦利耶"
 },
 {
  "from": 7.08,
  "to": 12.0,
  "sid": 4,
  "location": 2,
  "content": "运动员X网络今天我们要谈谈卧推经典练习"
 },
 {
  "from": 12.0,
  "to": 15.409,
  "sid": 5,
  "location": 2,
  "content": "现在这可能是一个你已经做了一百万次的"
 },
 {
  "from": 15.409,
  "to": 18.009,
  "sid": 6,
  "location": 2,
  "content": "但你必须确保你一直做得对"
 },
 {
  "from": 21.259,
  "to": 22.619,
  "sid": 7,
  "location": 2,
  "content": "很多时候在你的肩膀上"
 },
 {
  "from": 22.619,
  "to": 23.859,
  "sid": 8,
  "location": 2,
  "content": "有时在你的肘部"
 },
 {
  "from": 23.859,
  "to": 24.93,
  "sid": 9,
  "location": 2,
  "content": "有时在你的手腕上"
 },
 {
  "from": 24.93,
  "to": 26.61,
  "sid": 10,
  "location": 2,
  "content": "有时在你的胸口有一个撕裂的啄"
 },
 {
  "from": 26.61,
  "to": 27.81,
  "sid": 11,
  "location": 2,
  "content": "你得确保你做得对"
 },
 {
  "from": 27.81,
  "to": 29.34,
  "sid": 12,
  "location": 2,
  "content": "所以我整理了一份清单"
 },
 {
  "from": 29.34,
  "to": 32.28,
  "sid": 13,
  "location": 2,
  "content": "我们要一步一步来让它变得非常简单"
 },
 {
  "from": 32.28,
  "to": 34.34,
  "sid": 14,
  "location": 2,
  "content": "所以我们要确保你把每一部分都钉好"
 },
 {
  "from": 34.34,
  "to": 36.44,
  "sid": 15,
  "location": 2,
  "content": "当你加载酒吧的第一件事"
 },
 {
  "from": 36.44,
  "to": 38.76,
  "sid": 16,
  "location": 2,
  "content": "理想情况下，你在这里的笼子里做"
 },
 {
  "from": 38.76,
  "to": 42.07,
  "sid": 17,
  "location": 2,
  "content": "其次，为了安全起见，你在吧台上放了一个夹子"
 },
 {
  "from": 42.07,
  "to": 45.95,
  "sid": 18,
  "location": 2,
  "content": "然而，作为一个从经验中学到这一点的人，我要指出"
 },
 {
  "from": 45.95,
  "to": 47.65,
  "sid": 19,
  "location": 2,
  "content": "如果你在家训练"
 },
 {
  "from": 47.65,
  "to": 49.19,
  "sid": 20,
  "location": 2,
  "content": "您可能不想使用剪辑"
 },
 {
  "from": 49.19,
  "to": 52.41,
  "sid": 21,
  "location": 2,
  "content": "为什么，因为如果你被卡住了，周围没有人发现你"
 },
 {
  "from": 52.41,
  "to": 55.51,
  "sid": 22,
  "location": 2,
  "content": "你真正从酒吧里出来的唯一选择就是把它扔掉"
 },
 {
  "from": 55.51,
  "to": 56.61,
  "sid": 23,
  "location": 2,
  "content": "如果剪辑在这里"
 },
 {
  "from": 56.61,
  "to": 58.55,
  "sid": 24,
  "location": 2,
  "content": "你不能再这么做了"
 },
 {
  "from": 58.55,
  "to": 59.03,
  "sid": 25,
  "location": 2,
  "content": "不是什么"
 },
 {
  "from": 59.03,
  "to": 59.61,
  "sid": 26,
  "location": 2,
  "content": "我建议"
 },
 {
  "from": 59.61,
  "to": 62.51,
  "sid": 27,
  "location": 2,
  "content": "我宁愿你现在就去伊拉克"
 },
 {
  "from": 62.51,
  "to": 64.69,
  "sid": 28,
  "location": 2,
  "content": "接下来的事情是愚蠢的简单"
 },
 {
  "from": 64.69,
  "to": 66.15,
  "sid": 29,
  "location": 2,
  "content": "但看看我的肩膀"
 },
 {
  "from": 66.15,
  "to": 69.62,
  "sid": 30,
  "location": 2,
  "content": "杆在机架本身的位置是什么"
 },
 {
  "from": 69.62,
  "to": 71.28,
  "sid": 31,
  "location": 2,
  "content": "它位于中心位置吗"
 },
 {
  "from": 71.28,
  "to": 74.57,
  "sid": 32,
  "location": 2,
  "content": "因为很多时候你上来发现他们就像那样"
 },
 {
  "from": 74.57,
  "to": 77.65,
  "sid": 33,
  "location": 2,
  "content": "突然间，它已经偏离了你的方向"
 },
 {
  "from": 77.65,
  "to": 79.21,
  "sid": 34,
  "location": 2,
  "content": "这真的很容易"
 },
 {
  "from": 79.21,
  "to": 80.63,
  "sid": 35,
  "location": 2,
  "content": "愚蠢容易做"
 },
 {
  "from": 80.63,
  "to": 81.85,
  "sid": 36,
  "location": 2,
  "content": "但一定要做到"
 },
 {
  "from": 81.85,
  "to": 82.63,
  "sid": 37,
  "location": 2,
  "content": "因为这很重要"
 },
 {
  "from": 82.63,
  "to": 84.21,
  "sid": 38,
  "location": 2,
  "content": "所以一旦我们把它排好"
 },
 {
  "from": 84.21,
  "to": 86.39,
  "sid": 39,
  "location": 2,
  "content": "然后我们找板凳的位置"
 },
 {
  "from": 86.39,
  "to": 88.43,
  "sid": 40,
  "location": 2,
  "content": "关于杆的中间滚花"
 },
 {
  "from": 88.43,
  "to": 90.15,
  "sid": 41,
  "location": 2,
  "content": "你可以看到这里我们排得很好"
 },
 {
  "from": 90.15,
  "to": 93.43,
  "sid": 42,
  "location": 2,
  "content": "你想确保你在做同样的事情，现在我来到这里"
 },
 {
  "from": 93.43,
  "to": 96.37,
  "sid": 43,
  "location": 2,
  "content": "我想知道酒吧下面有多远"
 },
 {
  "from": 96.37,
  "to": 97.73,
  "sid": 44,
  "location": 2,
  "content": "长凳应该是"
 },
 {
  "from": 97.73,
  "to": 99.03,
  "sid": 45,
  "location": 2,
  "content": "你要明白"
 },
 {
  "from": 99.03,
  "to": 100.53,
  "sid": 46,
  "location": 2,
  "content": "当我们躺在这里"
 },
 {
  "from": 100.53,
  "to": 102.99,
  "sid": 47,
  "location": 2,
  "content": "我的眼睛会直直地看着酒吧"
 },
 {
  "from": 102.99,
  "to": 104.96,
  "sid": 48,
  "location": 2,
  "content": "我稍后会更深入地介绍"
 },
 {
  "from": 104.96,
  "to": 106.88,
  "sid": 49,
  "location": 2,
  "content": "所以为了适应"
 },
 {
  "from": 106.88,
  "to": 109.48,
  "sid": 50,
  "location": 2,
  "content": "我头顶和眼睛之间有这么大的空间"
 },
 {
  "from": 109.48,
  "to": 113.69,
  "sid": 51,
  "location": 2,
  "content": "所以在吧台和长椅之外至少应该有那么大的空间"
 },
 {
  "from": 113.69,
  "to": 114.89,
  "sid": 52,
  "location": 2,
  "content": "这样我就可以容纳我的头"
 },
 {
  "from": 114.89,
  "to": 116.53,
  "sid": 53,
  "location": 2,
  "content": "所以我把头从后面探了出来"
 },
 {
  "from": 116.53,
  "to": 120.22,
  "sid": 54,
  "location": 2,
  "content": "我已经做过了现在你向后靠"
 },
 {
  "from": 120.22,
  "to": 124.08,
  "sid": 55,
  "location": 2,
  "content": "我们坐在这里，我们现在把自己放在吧台下面"
 },
 {
  "from": 124.08,
  "to": 125.26,
  "sid": 56,
  "location": 2,
  "content": "所以现在到上面来"
 },
 {
  "from": 125.26,
  "to": 127.42,
  "sid": 57,
  "location": 2,
  "content": "你可以看到酒吧"
 },
 {
  "from": 127.42,
  "to": 129.36,
  "sid": 58,
  "location": 2,
  "content": "关于我在长凳上的身体"
 },
 {
  "from": 129.36,
  "to": 131.64,
  "sid": 59,
  "location": 2,
  "content": "你真的想盯着酒吧"
 },
 {
  "from": 131.64,
  "to": 136.41,
  "sid": 60,
  "location": 2,
  "content": "你可以看到我的眼睛真的和这个位置的酒吧排成一行"
 },
 {
  "from": 136.41,
  "to": 139.62,
  "sid": 61,
  "location": 2,
  "content": "这样它就设置好了我的升空位置"
 },
 {
  "from": 139.62,
  "to": 141.7,
  "sid": 62,
  "location": 2,
  "content": "我可以从这边解释得更多"
 },
 {
  "from": 141.7,
  "to": 143.62,
  "sid": 63,
  "location": 2,
  "content": "现在注意我们在这里做什么"
 },
 {
  "from": 143.62,
  "to": 145.3,
  "sid": 64,
  "location": 2,
  "content": "就你的抓地力而言"
 },
 {
  "from": 145.3,
  "to": 147.18,
  "sid": 65,
  "location": 2,
  "content": "你想知道你的抓地力应该有多宽"
 },
 {
  "from": 147.18,
  "to": 149.269,
  "sid": 66,
  "location": 2,
  "content": "你想知道你应该使用的握把类型"
 },
 {
  "from": 149.269,
  "to": 151.409,
  "sid": 67,
  "location": 2,
  "content": "当你看握把的宽度"
 },
 {
  "from": 151.409,
  "to": 154.55,
  "sid": 68,
  "location": 2,
  "content": "你必须下到底部才能明白它应该在哪里"
 },
 {
  "from": 154.55,
  "to": 155.69,
  "sid": 69,
  "location": 2,
  "content": "从这里开始"
 },
 {
  "from": 155.69,
  "to": 156.69,
  "sid": 70,
  "location": 2,
  "content": "我会再掩护一次"
 },
 {
  "from": 156.69,
  "to": 159.28,
  "sid": 71,
  "location": 2,
  "content": "肘部定位将是关键"
 },
 {
  "from": 159.28,
  "to": 162.6,
  "sid": 72,
  "location": 2,
  "content": "你不会想把你的胳膊肘一直放在这里的"
 },
 {
  "from": 162.6,
  "to": 164.11,
  "sid": 73,
  "location": 2,
  "content": "在这个断头台的位置上"
 },
 {
  "from": 164.11,
  "to": 165.85,
  "sid": 74,
  "location": 2,
  "content": "如果你在做断头台新闻"
 },
 {
  "from": 165.85,
  "to": 166.87,
  "sid": 75,
  "location": 2,
  "content": "那是另一回事"
 },
 {
  "from": 166.87,
  "to": 169.35,
  "sid": 76,
  "location": 2,
  "content": "但你要确保你用的哑铃更轻"
 },
 {
  "from": 169.35,
  "to": 170.31,
  "sid": 77,
  "location": 2,
  "content": "而不是试图加载"
 },
 {
  "from": 170.31,
  "to": 172.36,
  "sid": 78,
  "location": 2,
  "content": "正如我在这里展示的经典卧推"
 },
 {
  "from": 172.36,
  "to": 174.72,
  "sid": 79,
  "location": 2,
  "content": "因为发生的事情是在这个最高的位置上"
 },
 {
  "from": 174.72,
  "to": 176.56,
  "sid": 80,
  "location": 2,
  "content": "你没有给自己留余地"
 },
 {
  "from": 177.38,
  "to": 179.4,
  "sid": 81,
  "location": 2,
  "content": "真正操作的肩袖"
 },
 {
  "from": 179.4,
  "to": 181.34,
  "sid": 82,
  "location": 2,
  "content": "当然，如果重量变得有点重"
 },
 {
  "from": 181.34,
  "to": 183.769,
  "sid": 83,
  "location": 2,
  "content": "横杆传球开始向前一点"
 },
 {
  "from": 183.769,
  "to": 185.55,
  "sid": 84,
  "location": 2,
  "content": "你会得到内部旋转"
 },
 {
  "from": 185.55,
  "to": 188.89,
  "sid": 85,
  "location": 2,
  "content": "这会真的真的破坏这个位置的肩袖"
 },
 {
  "from": 188.89,
  "to": 190.27,
  "sid": 86,
  "location": 2,
  "content": "因为你的手肘太高了"
 },
 {
  "from": 190.27,
  "to": 194.06,
  "sid": 87,
  "location": 2,
  "content": "你的手肘应该离你的身体大约75度"
 },
 {
  "from": 194.06,
  "to": 197.02,
  "sid": 88,
  "location": 2,
  "content": "所以如果你知道你这样设置这个位置"
 },
 {
  "from": 197.02,
  "to": 200.02,
  "sid": 89,
  "location": 2,
  "content": "你的肘部弯曲90度"
 },
 {
  "from": 200.02,
  "to": 202.38,
  "sid": 90,
  "location": 2,
  "content": "你的前臂垂直于地面"
 },
 {
  "from": 202.38,
  "to": 203.92,
  "sid": 91,
  "location": 2,
  "content": "直直地指向天花板"
 },
 {
  "from": 203.92,
  "to": 205.48,
  "sid": 92,
  "location": 2,
  "content": "无论那是给你的"
 },
 {
  "from": 205.48,
  "to": 208.73,
  "sid": 93,
  "location": 2,
  "content": "因为手臂长度会因人而异"
 },
 {
  "from": 208.73,
  "to": 210.99,
  "sid": 94,
  "location": 2,
  "content": "然后你从这里直接到达吧台"
 },
 {
  "from": 210.99,
  "to": 214.919,
  "sid": 95,
  "location": 2,
  "content": "你可以看到我的无名指放在"
 },
 {
  "from": 214.919,
  "to": 215.099,
  "sid": 96,
  "location": 2,
  "content": "呃"
 },
 {
  "from": 215.099,
  "to": 216.839,
  "sid": 97,
  "location": 2,
  "content": "杆的非神经部分"
 },
 {
  "from": 216.839,
  "to": 218.459,
  "sid": 98,
  "location": 2,
  "content": "所以这就是我的宽度"
 },
 {
  "from": 218.459,
  "to": 219.459,
  "sid": 99,
  "location": 2,
  "content": "所以当我在底部的时候"
 },
 {
  "from": 219.459,
  "to": 222.22,
  "sid": 100,
  "location": 2,
  "content": "我的前臂有一个完全支撑的杆"
 },
 {
  "from": 222.22,
  "to": 224.16,
  "sid": 101,
  "location": 2,
  "content": "我指着并支撑着下面的杆"
 },
 {
  "from": 224.16,
  "to": 225.74,
  "sid": 102,
  "location": 2,
  "content": "这就引出了下一个问题"
 },
 {
  "from": 225.74,
  "to": 227.24,
  "sid": 103,
  "location": 2,
  "content": "握把本身"
 },
 {
  "from": 227.5,
  "to": 229.11,
  "sid": 104,
  "location": 2,
  "content": "什么是正确的抓地力"
 },
 {
  "from": 229.11,
  "to": 231.55,
  "sid": 105,
  "location": 2,
  "content": "有一个无拇指的握把，有些人会用"
 },
 {
  "from": 231.55,
  "to": 233.03,
  "sid": 106,
  "location": 2,
  "content": "因为他们想在做的时候看起来很酷"
 },
 {
  "from": 233.03,
  "to": 233.89,
  "sid": 107,
  "location": 2,
  "content": "一切都安排好了"
 },
 {
  "from": 233.89,
  "to": 236.23,
  "sid": 108,
  "location": 2,
  "content": "但如果杆子向前滑出你的手中会发生什么"
 },
 {
  "from": 236.23,
  "to": 237.18,
  "sid": 109,
  "location": 2,
  "content": "你有麻烦了"
 },
 {
  "from": 237.18,
  "to": 238.02,
  "sid": 110,
  "location": 2,
  "content": "所以你要做的是"
 },
 {
  "from": 238.02,
  "to": 239.54,
  "sid": 111,
  "location": 2,
  "content": "你总是想拥有你的酒吧"
 },
 {
  "from": 239.54,
  "to": 240.98,
  "sid": 112,
  "location": 2,
  "content": "你的拇指缠在吧台上"
 },
 {
  "from": 240.98,
  "to": 244.3,
  "sid": 113,
  "location": 2,
  "content": "但你如何接近酒吧对做到这一点非常重要"
 },
 {
  "from": 244.3,
  "to": 245.48,
  "sid": 114,
  "location": 2,
  "content": "如果我下来"
 },
 {
  "from": 245.48,
  "to": 246.78,
  "sid": 115,
  "location": 2,
  "content": "很多时候人们会这么做"
 },
 {
  "from": 246.78,
  "to": 247.62,
  "sid": 116,
  "location": 2,
  "content": "他们会从这边过来"
 },
 {
  "from": 247.62,
  "to": 247.82,
  "sid": 117,
  "location": 2,
  "content": "好的"
 },
 {
  "from": 247.82,
  "to": 248.84,
  "sid": 118,
  "location": 2,
  "content": "我刚才说我的无名指"
 },
 {
  "from": 248.84,
  "to": 249.7,
  "sid": 119,
  "location": 2,
  "content": "我需要去的地方"
 },
 {
  "from": 249.7,
  "to": 252.03,
  "sid": 120,
  "location": 2,
  "content": "我从这边走，我抓住酒吧"
 },
 {
  "from": 252.03,
  "to": 253.71,
  "sid": 121,
  "location": 2,
  "content": "然后我走了，我抓住周围"
 },
 {
  "from": 253.71,
  "to": 255.87,
  "sid": 122,
  "location": 2,
  "content": "或者我这样抓我的拇指"
 },
 {
  "from": 255.87,
  "to": 257.31,
  "sid": 123,
  "location": 2,
  "content": "哪一个对你更舒服"
 },
 {
  "from": 257.31,
  "to": 258.5,
  "sid": 124,
  "location": 2,
  "content": "这个比较强"
 },
 {
  "from": 258.5,
  "to": 259.5,
  "sid": 125,
  "location": 2,
  "content": "但如果我走这条路"
 },
 {
  "from": 259.5,
  "to": 262.38,
  "sid": 126,
  "location": 2,
  "content": "问题是我手指上的标准太高了"
 },
 {
  "from": 262.38,
  "to": 265.26,
  "sid": 127,
  "location": 2,
  "content": "所以现在当我自动升空时"
 },
 {
  "from": 265.26,
  "to": 267.58,
  "sid": 128,
  "location": 2,
  "content": "吧台会向后翻滚"
 },
 {
  "from": 267.58,
  "to": 268.95,
  "sid": 129,
  "location": 2,
  "content": "我对我的手腕做了什么"
 },
 {
  "from": 268.95,
  "to": 273.29,
  "sid": 130,
  "location": 2,
