  "sid": 38,
  "location": 2,
  "content": "我会说"
 },
 {
  "from": 103.14,
  "to": 108.78,
  "sid": 39,
  "location": 2,
  "content": "很少有人在板凳上有更多的肘部耀斑"
 },
 {
  "from": 108.78,
  "to": 110.04,
  "sid": 40,
  "location": 2,
  "content": "比玛丽莎"
 },
 {
  "from": 110.04,
  "to": 112.49,
  "sid": 41,
  "location": 2,
  "content": "但如果我们真的有一个非常"
 },
 {
  "from": 112.49,
  "to": 116.8,
  "sid": 42,
  "location": 2,
  "content": "非常宽的抓地力，像最大值"
 },
 {
  "from": 116.8,
  "to": 120.24,
  "sid": 43,
  "location": 2,
  "content": "她的合法抓地力来实现手腕上的障碍"
 },
 {
  "from": 120.24,
  "to": 120.44,
  "sid": 44,
  "location": 2,
  "content": "手腕"
 },
 {
  "from": 120.44,
  "to": 121.86,
  "sid": 45,
  "location": 2,
  "content": "肘部以上位置"
 },
 {
  "from": 122.34,
  "to": 125.32,
  "sid": 46,
  "location": 2,
  "content": "她需要在胸前摸得很高"
 },
 {
  "from": 131.36,
  "to": 134.8,
  "sid": 47,
  "location": 2,
  "content": "所以你可以玩不同的抓地力宽度"
 },
 {
  "from": 134.8,
  "to": 140.27,
  "sid": 48,
  "location": 2,
  "content": "用不同的触点，找到你感觉最舒服和最强的东西"
 },
 {
  "from": 140.27,
  "to": 141.41,
  "sid": 49,
  "location": 2,
  "content": "但又一次"
 },
 {
  "from": 141.41,
  "to": 142.93,
  "sid": 50,
  "location": 2,
  "content": "一般的经验法则"
 },
 {
  "from": 142.93,
  "to": 145.06,
  "sid": 51,
  "location": 2,
  "content": "有更宽的手"
 },
 {
  "from": 145.06,
  "to": 146.2,
  "sid": 52,
  "location": 2,
  "content": "更高的触觉"
 },
 {
  "from": 146.2,
  "to": 147.72,
  "sid": 53,
  "location": 2,
  "content": "更多肘部耀斑"
 },
 {
  "from": 147.72,
  "to": 148.88,
  "sid": 54,
  "location": 2,
  "content": "更亲密的手"
 },
 {
  "from": 148.88,
  "to": 150.04,
  "sid": 55,
  "location": 2,
  "content": "下触觉"
 },
 {
  "from": 150.04,
  "to": 151.76,
  "sid": 56,
  "location": 2,
  "content": "更多的肘部掖"
 },
 {
  "from": 152.2,
  "to": 154.84,
  "sid": 57,
  "location": 2,
  "content": "所以现在你已经找到了你的最佳接触点"
 },
 {
  "from": 155.36,
  "to": 159.62,
  "sid": 58,
  "location": 2,
  "content": "现在我们想看看你如何最大化你的头寸和杠杆"
 },
 {
  "from": 159.62,
  "to": 161.05,
