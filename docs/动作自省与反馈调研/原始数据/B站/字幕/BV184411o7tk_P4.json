  "location": 2,
  "content": "她用架子爬上她的陷阱"
 },
 {
  "from": 185.06,
  "to": 186.12,
  "sid": 70,
  "location": 2,
  "content": "臀桥"
 },
 {
  "from": 186.12,
  "to": 187.5,
  "sid": 71,
  "location": 2,
  "content": "感觉到她陷阱里的压力"
 },
 {
  "from": 187.5,
  "to": 188.7,
  "sid": 72,
  "location": 2,
  "content": "她的脚向下走"
 },
 {
  "from": 188.7,
  "to": 190.5,
  "sid": 73,
  "location": 2,
  "content": "同时保持这种压力"
 },
 {
  "from": 190.5,
  "to": 191.56,
  "sid": 74,
  "location": 2,
  "content": "全足压力"
