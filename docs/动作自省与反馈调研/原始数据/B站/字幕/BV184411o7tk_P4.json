  "location": 2,
  "content": "我们要呼吸大空气"
 },
 {
  "from": 198.179,
  "to": 199.539,
  "sid": 78,
  "location": 2,
  "content": "把背带锁好"
 },
 {
  "from": 199.539,
  "to": 202.259,
  "sid": 79,
  "location": 2,
  "content": "当她放下时，锁定上背部的位置"
 },
 {
  "from": 202.259,
  "to": 203.199,
  "sid": 80,
  "location": 2,
  "content": "把酒吧拉下来"
 },
 {
  "from": 203.199,
  "to": 206.709,
  "sid": 81,
  "location": 2,
  "content": "我们试图用她的胸部够到吧台"
 },
 {
  "from": 206.709,
  "to": 210.769,
  "sid": 82,
  "location": 2,
  "content": "我们会看到一个很常见的问题当运动员把横杆放下时"
 },
 {
  "from": 210.769,
  "to": 212.44,
  "sid": 83,
  "location": 2,
  "content": "他们的胸部开始塌陷"
 },
 {
  "from": 212.44,
  "to": 214.04,
  "sid": 84,
  "location": 2,
  "content": "他们失去了紧张"
 },
 {
  "from": 214.04,
  "to": 216.08,
  "sid": 85,
  "location": 2,
  "content": "他们失去了一些上背部的位置"
 },
 {
  "from": 216.08,
  "to": 219.6,
  "sid": 86,
  "location": 2,
  "content": "通常与头部相连"
 },
 {
  "from": 219.6,
  "to": 224.12,
  "sid": 87,
  "location": 2,
  "content": "运动员从板凳上抬起头来已经成为一种非常普遍的做法"
 },
 {
  "from": 224.12,
  "to": 227.54,
  "sid": 88,
  "location": 2,
  "content": "除非你非常非常注意它"
 },
 {
  "from": 227.54,
  "to": 229.02,
  "sid": 89,
  "location": 2,
  "content": "当头部抬起时"
 },
 {
  "from": 229.02,
  "to": 230.86,
  "sid": 90,
  "location": 2,
  "content": "胸部经常会往下掉"
 },
 {
  "from": 230.86,
  "to": 233.32,
  "sid": 91,
  "location": 2,
  "content": "胸部会从吧台后退"
 },
 {
  "from": 233.32,
  "to": 236.78,
  "sid": 92,
  "location": 2,
  "content": "这会导致上背部定位的损失"
 },
 {
  "from": 236.78,
  "to": 238.64,
  "sid": 93,
  "location": 2,
  "content": "会造成很大的紧张"
 },
 {
  "from": 238.64,
  "to": 242.41,
  "sid": 94,
  "location": 2,
  "content": "这也会导致你不得不把杆移动更远的距离"
 },
 {
  "from": 242.41,
  "to": 242.77,
  "sid": 95,
  "location": 2,
  "content": "现在"
 },
 {
  "from": 242.77,
  "to": 245.09,
  "sid": 96,
  "location": 2,
  "content": "不是的不一定要那样"
 },
 {
  "from": 245.09,
  "to": 249.71,
  "sid": 97,
  "location": 2,
  "content": "你可以稍微抬起头仍然保持良好的上背部位置"
 },
 {
  "from": 249.71,
  "to": 251.7,
  "sid": 98,
  "location": 2,
  "content": "仍然保持胸高"
 },
 {
  "from": 251.7,
  "to": 253.74,
  "sid": 99,
  "location": 2,
  "content": "但你只是在做的时候"
 },
 {
  "from": 253.74,
  "to": 255.94,
  "sid": 100,
  "location": 2,
  "content": "你只需要非常非常注意这一点"
 },
 {
  "from": 255.94,
  "to": 259.04,
  "sid": 101,
  "location": 2,
  "content": "你先睹为快看看酒吧在哪里"
 },
 {
  "from": 259.04,
  "to": 259.899,
  "sid": 102,
  "location": 2,
  "content": "你是"
 },
 {
  "from": 259.899,
  "to": 262.359,
  "sid": 103,
  "location": 2,
  "content": "你真的想保持胸高"
 },
 {
  "from": 262.359,
  "to": 263.019,
  "sid": 104,
  "location": 2,
  "content": "很多"
 },
 {
  "from": 263.019,
  "to": 267.399,
  "sid": 105,
  "location": 2,
  "content": "把车头抬起来是齿轮支撑技术的延续"
 },
 {
  "from": 267.399,
  "to": 271.64,
  "sid": 106,
  "location": 2,
  "content": "因为你可能需要看看酒吧离你的胸部有多远"
 },
 {
  "from": 271.64,
  "to": 274.44,
  "sid": 107,
  "location": 2,
  "content": "也可能缓解一些"
 },
 {
  "from": 274.44,
  "to": 277.86,
  "sid": 108,
  "location": 2,
  "content": "衬衫上的一些张力实际上能够触摸你的胸部"
 },
 {
  "from": 277.86,
  "to": 279.68,
  "sid": 109,
  "location": 2,
  "content": "我想如果你在看这个视频"
 },
 {
  "from": 279.68,
  "to": 281.46,
  "sid": 110,
  "location": 2,
  "content": "你可能是个生手"
 },
 {
  "from": 281.46,
  "to": 285.51,
  "sid": 111,
  "location": 2,
  "content": "所以你不应该因为这些原因而抬起头来"
 },
 {
  "from": 285.51,
  "to": 288.39,
  "sid": 112,
  "location": 2,
  "content": "所以如果对你来说更舒服什么的"
 },
 {
  "from": 288.39,
  "to": 289.45,
  "sid": 113,
  "location": 2,
  "content": "去做吧"
 },
 {
  "from": 289.45,
  "to": 293.05,
  "sid": 114,
  "location": 2,
  "content": "注意胸部尽量抬高"
 },
 {
  "from": 293.05,
  "to": 297.98,
  "sid": 115,
  "location": 2,
  "content": "在整个电梯过程中，当玛丽莎把酒吧拿出来时，又是关于呼吸的"
 },
 {
  "from": 303.0,
  "to": 306.26,
  "sid": 116,
  "location": 2,
  "content": "她在下降前呼吸了很大的空气"
 },
 {
  "from": 306.36,
  "to": 307.64,
  "sid": 117,
  "location": 2,
  "content": "保持胸高"
 },
 {
  "from": 307.64,
  "to": 310.07,
  "sid": 118,
  "location": 2,
  "content": "保持空气在压力机中"
 },
 {
  "from": 310.07,
  "to": 313.29,
  "sid": 119,
  "location": 2,
  "content": "并保持她的空气，直到她回到电梯的顶部"
 },
 {
  "from": 313.29,
  "to": 314.49,
  "sid": 120,
  "location": 2,
  "content": "如果是打火机"
 },
 {
  "from": 314.49,
  "to": 316.75,
  "sid": 121,
  "location": 2,
  "content": "你可以很快地移动酒吧"
 },
 {
  "from": 316.75,
  "to": 320.31,
  "sid": 122,
  "location": 2,
  "content": "你可以一口气做多个代表"
 },
 {
  "from": 320.31,
  "to": 320.83,
  "sid": 123,
  "location": 2,
  "content": "但是我们"
 },
 {
  "from": 320.83,
  "to": 324.31,
  "sid": 124,
  "location": 2,
  "content": "我们绝对不想让默萨大放异彩"
 },
 {
  "from": 324.31,
  "to": 326.75,
  "sid": 125,
  "location": 2,
  "content": "然后要么把杆放在胸前呼气"
 },
 {
  "from": 326.75,
  "to": 330.09,
  "sid": 126,
  "location": 2,
  "content": "或者当你按的时候她按的时候呼气"
 },
 {
  "from": 330.09,
  "to": 330.73,
  "sid": 127,
  "location": 2,
  "content": "你知道的"
 },
 {
  "from": 330.73,
  "to": 333.009,
  "sid": 128,
  "location": 2,
  "content": "当你蹲着的时候"
 },
 {
