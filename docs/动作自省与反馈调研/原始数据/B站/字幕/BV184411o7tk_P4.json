 {
  "from": 76.86,
  "to": 80.8,
  "sid": 27,
  "location": 2,
  "content": "或者更多的肘部收腹会在三头肌更占优势"
 },
 {
  "from": 80.8,
  "to": 84.02,
  "sid": 28,
  "location": 2,
  "content": "你需要找出什么对你更有效"
 },
 {
  "from": 84.02,
  "to": 84.92,
  "sid": 29,
  "location": 2,
  "content": "嗯"
 },
 {
  "from": 85.28,
  "to": 89.66,
  "sid": 30,
  "location": 2,
  "content": "但最重要的是要达到这个标准"
 },
 {
  "from": 89.66,
  "to": 90.44,
  "sid": 31,
  "location": 2,
  "content": "叠在手腕上"
 },
 {
  "from": 90.44,
  "to": 90.78,
  "sid": 32,
  "location": 2,
  "content": "手腕"
 },
 {
  "from": 90.78,
  "to": 91.96,
  "sid": 33,
  "location": 2,
  "content": "肘部以上位置"
 },
 {
  "from": 91.96,
  "to": 95.5,
  "sid": 34,
  "location": 2,
  "content": "所以如果玛丽莎能紧紧地抓住她"
 },
 {
  "from": 95.5,
  "to": 97.1,
  "sid": 35,
  "location": 2,
  "content": "仍然达到这个位置"
 },
 {
  "from": 97.1,
  "to": 99.66,
  "sid": 36,
  "location": 2,
  "content": "这需要她摸得更低一点"
 },
 {
  "from": 99.66,
  "to": 102.3,
  "sid": 37,
  "location": 2,
  "content": "让她把胳膊肘收得更多"
 },
 {
  "from": 102.3,
