  "location": 2,
  "content": "我建议你多穿一双举重鞋"
 },
 {
  "from": 252.86,
  "to": 253.32,
  "sid": 115,
  "location": 2,
  "content": "你知道的"
 },
 {
  "from": 253.32,
  "to": 253.76,
  "sid": 116,
  "location": 2,
  "content": "半英寸"
 },
 {
  "from": 253.76,
