  "sid": 56,
  "location": 2,
  "content": "我们的地位就越高"
 },
 {
  "from": 149.829,
  "to": 151.229,
  "sid": 57,
  "location": 2,
  "content": "大部分膝盖疼痛"
 },
 {
  "from": 151.229,
  "to": 156.07,
  "sid": 58,
  "location": 2,
  "content": "大多数背痛来自足部的机械问题"
 },
 {
  "from": 156.07,
  "to": 158.19,
  "sid": 59,
  "location": 2,
  "content": "所以我们清理了脚部机械师"
 },
 {
  "from": 158.19,
  "to": 160.93,
  "sid": 60,
  "location": 2,
  "content": "我们增强那些内在的肌肉"
