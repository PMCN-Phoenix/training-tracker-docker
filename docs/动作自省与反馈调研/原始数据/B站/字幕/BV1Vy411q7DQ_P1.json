  "sid": 3,
  "location": 2,
  "content": "呃"
 },
 {
  "from": 5.94,
  "to": 9.83,
  "sid": 4,
  "location": 2,
  "content": "建立稳定性，让本体感觉回到脚上"
 },
 {
  "from": 9.83,
  "to": 12.63,
  "sid": 5,
  "location": 2,
  "content": "所以这就是知道脚在太空中的位置"
 },
 {
  "from": 12.63,
  "to": 14.81,
  "sid": 6,
  "location": 2,
  "content": "我们都因为僵硬而失去了这个"
 },
 {
  "from": 14.81,
  "to": 15.39,
  "sid": 7,
  "location": 2,
  "content": "有底鞋"
 },
 {
  "from": 15.39,
  "to": 16.98,
  "sid": 8,
  "location": 2,
  "content": "所以我们要做的是"
 },
 {
  "from": 16.98,
  "to": 18.64,
  "sid": 9,
  "location": 2,
  "content": "很明显脱掉我们的鞋子"
 },
 {
  "from": 18.64,
  "to": 20.5,
  "sid": 10,
  "location": 2,
  "content": "把袜子脱了"
 },
 {
  "from": 20.5,
  "to": 24.0,
  "sid": 11,
  "location": 2,
  "content": "如果你想在健身房做这个作为热身的延伸，很好"
 },
 {
  "from": 24.0,
  "to": 25.83,
  "sid": 12,
  "location": 2,
  "content": "这就是我们为NBA球员所做的"
 },
 {
  "from": 25.83,
  "to": 27.71,
  "sid": 13,
  "location": 2,
  "content": "但这可以与程序分开"
 },
 {
  "from": 27.71,
  "to": 29.19,
  "sid": 14,
  "location": 2,
  "content": "这可以是你在家"
 },
 {
  "from": 30.19,
  "to": 31.31,
  "sid": 15,
  "location": 2,
  "content": "靠在墙上"
 },
 {
  "from": 31.31,
  "to": 32.45,
  "sid": 16,
  "location": 2,
  "content": "看电视"
 },
 {
  "from": 32.45,
  "to": 33.29,
  "sid": 17,
  "location": 2,
  "content": "没关系"
 },
 {
  "from": 33.29,
  "to": 35.77,
  "sid": 18,
  "location": 2,
  "content": "我们的目标是三到四盘"
 },
 {
  "from": 35.77,
  "to": 37.89,
  "sid": 19,
  "location": 2,
  "content": "每周三至四天"
 },
 {
  "from": 37.89,
  "to": 40.79,
  "sid": 20,
  "location": 2,
  "content": "你可以重复六到十次"
 },
 {
  "from": 40.79,
  "to": 45.21,
  "sid": 21,
  "location": 2,
  "content": "所以站起来靠着墙或任何我们可以伸手触摸的地方"
 },
 {
  "from": 45.21,
  "to": 47.41,
  "sid": 22,
  "location": 2,
  "content": "我要向上走半步"
 },
 {
  "from": 47.41,
  "to": 48.95,
  "sid": 23,
  "location": 2,
  "content": "当我们在这方面做得更好的时候"
 },
 {
  "from": 48.95,
  "to": 50.06,
  "sid": 24,
  "location": 2,
  "content": "我们可以走得更远"
 },
 {
  "from": 50.06,
  "to": 52.419,
  "sid": 25,
  "location": 2,
  "content": "但我现在就从这里开始"
 },
 {
  "from": 52.419,
  "to": 57.119,
  "sid": 26,
  "location": 2,
  "content": "在整个演习中，我保持着三点联系"
 },
 {
  "from": 57.119,
  "to": 60.31,
  "sid": 27,
  "location": 2,
  "content": "我的三脚架脚是脚后跟"
 },
 {
  "from": 60.31,
  "to": 63.55,
  "sid": 28,
  "location": 2,
  "content": "大脚趾球和小脚趾球"
 },
 {
  "from": 63.55,
  "to": 65.09,
  "sid": 29,
  "location": 2,
  "content": "那是你的三脚架"
 },
 {
  "from": 65.09,
  "to": 68.1,
  "sid": 30,
  "location": 2,
  "content": "现在你们很多人，当你的脚累了"
 },
 {
  "from": 68.1,
  "to": 69.54,
  "sid": 31,
  "location": 2,
  "content": "你进入超级国家"
 },
 {
  "from": 69.54,
  "to": 72.82,
  "sid": 32,
  "location": 2,
  "content": "意味着你的脚外侧"
 },
 {
  "from": 72.82,
  "to": 77.06,
  "sid": 33,
  "location": 2,
  "content": "有些人可能会喋喋不休地说你的脚内侧"
 },
 {
  "from": 77.06,
  "to": 81.76,
  "sid": 34,
  "location": 2,
  "content": "你必须在整个练习中保持三个接触点"
 },
 {
  "from": 81.76,
  "to": 84.049,
  "sid": 35,
  "location": 2,
  "content": "所以尽量保持一个拱门"
 },
 {
  "from": 84.049,
  "to": 86.849,
  "sid": 36,
  "location": 2,
  "content": "所以我们可以通过抬起脚趾来做到这一点"
 },
 {
  "from": 86.849,
  "to": 91.36,
  "sid": 37,
  "location": 2,
  "content": "然后挤在大脚趾和脚后跟之间"
 },
 {
  "from": 91.5,
  "to": 95.28,
  "sid": 38,
  "location": 2,
  "content": "现在抓住那个拱门，把你的脚趾放下来"
 },
 {
  "from": 95.28,
  "to": 97.52,
  "sid": 39,
  "location": 2,
  "content": "从这里我抓着地板"
 },
 {
  "from": 97.52,
  "to": 99.52,
  "sid": 40,
  "location": 2,
  "content": "我只是要回去"
 },
 {
  "from": 103.16,
  "to": 104.54,
  "sid": 41,
  "location": 2,
  "content": "回来好吗"
 },
 {
  "from": 104.54,
  "to": 107.32,
  "sid": 42,
  "location": 2,
  "content": "看看我是怎么失去平衡的"
 },
 {
  "from": 107.32,
  "to": 111.56,
  "sid": 43,
  "location": 2,
  "content": "但我不会失去那只三脚架脚"
 },
 {
  "from": 112.48,
  "to": 114.699,
  "sid": 44,
  "location": 2,
  "content": "我要把对面的膝盖"
 },
 {
  "from": 114.699,
  "to": 116.819,
  "sid": 45,
  "location": 2,
  "content": "我现在真的回到了过去"
 },
 {
  "from": 116.819,
  "to": 119.559,
  "sid": 46,
  "location": 2,
  "content": "我实际上会感觉到一点四肢屈肌和髋关节屈肌"
 },
 {
  "from": 119.559,
  "to": 122.2,
  "sid": 47,
  "location": 2,
  "content": "我得到了一些好的古怪的工作"
 },
 {
  "from": 126.39,
  "to": 127.87,
  "sid": 48,
  "location": 2,
  "content": "我们现在就说"
 },
 {
  "from": 127.87,
  "to": 130.13,
  "sid": 49,
  "location": 2,
  "content": "我要重复十遍"
 },
 {
  "from": 130.13,
  "to": 132.899,
  "sid": 50,
  "location": 2,
  "content": "然后我会切换到另一边"
 },
 {
  "from": 132.899,
  "to": 136.659,
  "sid": 51,
  "location": 2,
  "content": "但你会注意到，当你开始累的时候"
 },
 {
  "from": 136.659,
  "to": 138.829,
  "sid": 52,
  "location": 2,
  "content": "你开始左右摇摆"
 },
 {
  "from": 138.829,
  "to": 141.01,
  "sid": 53,
  "location": 2,
  "content": "你失去了三脚架脚"
 },
 {
  "from": 141.01,
  "to": 143.09,
  "sid": 54,
  "location": 2,
  "content": "我们做得越好"
 },
 {
  "from": 143.09,
  "to": 147.03,
  "sid": 55,
  "location": 2,
  "content": "我们就越能保持场上的稳定"
 },
 {
  "from": 147.03,
