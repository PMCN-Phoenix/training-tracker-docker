{
 "lan": "ai-zh",
 "lan_doc": "中文",
 "body": [
  {
   "from": 0.0,
   "to": 0.42,
   "sid": 1,
   "location": 2,
   "content": "嗨大家好",
   "music": 0.0
  },
  {
   "from": 0.42,
   "to": 1.2,
   "sid": 2,
   "location": 2,
   "content": "我是爱丽丝",
   "music": 0.0
  },
  {
   "from": 1.2,
   "to": 2.91,
   "sid": 3,
   "location": 2,
   "content": "欢迎大家再次回到我的频道",
   "music": 0.0
  },
  {
   "from": 2.91,
   "to": 6.34,
   "sid": 4,
   "location": 2,
   "content": "今天这期视频呢又回到了练背精讲",
   "music": 0.0
  },
  {
   "from": 6.34,
   "to": 8.74,
   "sid": 5,
   "location": 2,
   "content": "今天我要和大家分享的训练动作",
   "music": 0.0
  },
  {
   "from": 8.74,
   "to": 11.18,
   "sid": 6,
   "location": 2,
   "content": "就是分段式的单臂划船",
   "music": 0.0
  },
  {
   "from": 11.18,
   "to": 13.76,
   "sid": 7,
   "location": 2,
   "content": "希望今天这期视频对你有所帮助",
   "music": 0.0
  },
  {
   "from": 13.76,
   "to": 14.42,
   "sid": 8,
   "location": 2,
   "content": "话不多说",
   "music": 0.0
  },
  {
   "from": 14.42,
   "to": 16.619,
   "sid": 9,
   "location": 2,
   "content": "我们开始吧",
   "music": 0.0
  },
  {
   "from": 24.14,
   "to": 25.42,
   "sid": 10,
   "location": 2,
   "content": "在我旁边的这一排呢",
   "music": 0.0
  },
  {
   "from": 25.42,
   "to": 27.52,
   "sid": 11,
   "location": 2,
   "content": "就是今天我们要学习的器械啊",
   "music": 0.0
  },
  {
   "from": 27.52,
   "to": 29.8,
   "sid": 12,
   "location": 2,
   "content": "这个之前在我的练背合集当中呢",
   "music": 0.0
  },
  {
   "from": 29.8,
   "to": 31.6,
   "sid": 13,
   "location": 2,
   "content": "和大家讲解过一次啊",
   "music": 0.0
  },
  {
   "from": 31.6,
   "to": 34.72,
   "sid": 14,
   "location": 2,
   "content": "但是今天呢我们会非常详细的和透彻的",
   "music": 0.0
  },
  {
   "from": 34.72,
   "to": 37.44,
   "sid": 15,
   "location": 2,
   "content": "把这个动作和这个器械讲明白",
   "music": 0.0
  },
  {
   "from": 37.44,
   "to": 39.12,
   "sid": 16,
   "location": 2,
   "content": "首先呢训练动作的第一点",
   "music": 0.0
  },
  {
   "from": 39.12,
   "to": 41.46,
   "sid": 17,
   "location": 2,
   "content": "就是要学会调节座椅的高度啊",
   "music": 0.0
  },
  {
   "from": 41.46,
   "to": 43.26,
   "sid": 18,
   "location": 2,
   "content": "这个高度也是因人而异啊",
   "music": 0.0
  },
  {
   "from": 43.26,
   "to": 45.3,
   "sid": 19,
   "location": 2,
   "content": "要根据自己的情况去调节啊",
   "music": 0.0
  },
  {
   "from": 45.3,
   "to": 46.46,
   "sid": 20,
   "location": 2,
   "content": "一方面呢是你的身",
   "music": 0.0
  },
  {
   "from": 46.46,
   "to": 49.19,
   "sid": 21,
   "location": 2,
   "content": "一方面呢就是你所抓的握把的位置",
   "music": 0.0
  },
  {
   "from": 49.19,
   "to": 50.36,
   "sid": 22,
   "location": 2,
   "content": "在训练的过程当中",
   "music": 0.0
  },
  {
   "from": 50.36,
   "to": 51.62,
   "sid": 23,
   "location": 2,
   "content": "有一个非常好的去衡量",
   "music": 0.0
  },
  {
   "from": 51.62,
   "to": 55.019,
   "sid": 24,
   "location": 2,
   "content": "你的坐姿高度和握把高度匹不匹配的点",
   "music": 0.0
  },
  {
   "from": 55.019,
   "to": 57.119,
   "sid": 25,
   "location": 2,
   "content": "就是当我们抓好握把之后",
   "music": 0.0
  },
  {
   "from": 57.119,
   "to": 59.56,
   "sid": 26,
   "location": 2,
   "content": "当你向后拉过来的时候呢",
   "music": 0.0
  },
  {
   "from": 59.56,
   "to": 63.34,
   "sid": 27,
   "location": 2,
   "content": "小臂啊有没有基本上平行在地面上",
   "music": 0.0
  },
  {
   "from": 63.34,
   "to": 65.2,
   "sid": 28,
   "location": 2,
   "content": "那比如说我现在做的很高",
   "music": 0.0
  },
  {
   "from": 65.2,
   "to": 67.81,
   "sid": 29,
   "location": 2,
   "content": "我一定会抓在偏高一点的把位",
   "music": 0.0
  },
  {
   "from": 67.81,
   "to": 70.27,
   "sid": 30,
   "location": 2,
   "content": "这个时候呢拉过来啊",
   "music": 0.0
  },
  {
   "from": 70.27,
   "to": 72.49,
   "sid": 31,
   "location": 2,
   "content": "小臂和地面基本上是平行的",
   "music": 0.0
  },
  {
   "from": 72.49,
   "to": 75.04,
   "sid": 32,
   "location": 2,
   "content": "这个时候手臂的受力会小一些",
   "music": 0.0
  },
  {
   "from": 75.04,
   "to": 78.05,
   "sid": 33,
   "location": 2,
   "content": "更多的力呢会增加在这里啊",
   "music": 0.0
  },
  {
   "from": 78.05,
   "to": 81.37,
   "sid": 34,
   "location": 2,
   "content": "背阔肌的拉伸和向后的收缩上",
   "music": 0.0
  },
  {
   "from": 81.37,
   "to": 84.04,
   "sid": 35,
   "location": 2,
   "content": "而如果我握的偏低会怎么样啊",
   "music": 0.0
  },
  {
   "from": 84.04,
   "to": 85.12,
   "sid": 36,
   "location": 2,
   "content": "这样拉过来啊",
   "music": 0.0
  },
  {
   "from": 85.12,
   "to": 87.25,
   "sid": 37,
   "location": 2,
   "content": "手臂也会参与的很多啊",
   "music": 0.0
  },
  {
   "from": 87.25,
   "to": 88.81,
   "sid": 38,
   "location": 2,
   "content": "会觉得手臂更累",
   "music": 0.0
  },
  {
   "from": 88.81,
   "to": 90.04,
   "sid": 39,
   "location": 2,
   "content": "同样的道理",
   "music": 0.0
  },
  {
   "from": 90.04,
   "to": 93.81,
   "sid": 40,
   "location": 2,
   "content": "如果我把座椅设置的非常低的话",
   "music": 0.0
  },
  {
   "from": 94.09,
   "to": 96.24,
   "sid": 41,
   "location": 2,
   "content": "而去采用一个很高的角度啊",
   "music": 0.0
  },
  {
   "from": 96.24,
   "to": 97.59,
   "sid": 42,
   "location": 2,
   "content": "这么去拉的话",
   "music": 0.0
  },
  {
   "from": 97.59,
   "to": 98.25,
   "sid": 43,
   "location": 2,
   "content": "手臂",
   "music": 0.0
  },
  {
   "from": 98.25,
   "to": 102.03,
   "sid": 44,
   "location": 2,
   "content": "大家可以看到肱二头肌的收缩会更加的明显啊",
   "music": 0.0
  },
  {
   "from": 102.03,
   "to": 103.47,
   "sid": 45,
   "location": 2,
   "content": "所以说练完之后呢",
   "music": 0.0
  },
  {
   "from": 103.47,
   "to": 105.65,
   "sid": 46,
   "location": 2,
   "content": "你会觉得手臂更容易力竭啊",
   "music": 0.0
  },
  {
   "from": 105.65,
   "to": 108.77,
   "sid": 47,
   "location": 2,
   "content": "这个也是很多同学在练背的过程当中呢",
   "music": 0.0
  },
  {
   "from": 108.77,
   "to": 110.96,
   "sid": 48,
   "location": 2,
   "content": "会觉得手臂酸的一个主要原因",
   "music": 0.0
  },
  {
   "from": 110.96,
   "to": 113.71,
   "sid": 49,
   "location": 2,
   "content": "就是你的握把宽度或者是高度",
   "music": 0.0
  },
  {
   "from": 113.71,
   "to": 116.53,
   "sid": 50,
   "location": 2,
   "content": "和你所使用的坐姿是不匹配的",
   "music": 0.0
  },
  {
   "from": 116.53,
   "to": 117.91,
   "sid": 51,
   "location": 2,
   "content": "接下来我们就来讲一下",
   "music": 0.0
  },
  {
   "from": 117.91,
   "to": 120.13,
   "sid": 52,
   "location": 2,
   "content": "分段式单臂划船的好处啊",
   "music": 0.0
  },
  {
   "from": 120.13,
   "to": 122.26,
   "sid": 53,
   "location": 2,
   "content": "那么我们在训练的过程当中啊",
   "music": 0.0
  },
  {
   "from": 122.26,
   "to": 124.21,
   "sid": 54,
   "location": 2,
   "content": "有很多类型的划船动作",
   "music": 0.0
  },
  {
   "from": 124.21,
   "to": 127.39,
   "sid": 55,
   "location": 2,
   "content": "都可以训练到我们的背阔肌偏下的位置啊",
   "music": 0.0
  },
  {
   "from": 127.39,
   "to": 130.39,
   "sid": 56,
   "location": 2,
   "content": "那么分动式的单臂划船有什么样的好处呢",
   "music": 0.0
  },
  {
   "from": 130.39,
   "to": 130.87,
   "sid": 57,
   "location": 2,
   "content": "一方面呢",
   "music": 0.0
  },
  {
   "from": 130.87,
   "to": 133.39,
   "sid": 58,
   "location": 2,
   "content": "就是当我们在使用分动式握把的时候啊",
   "music": 0.0
  },
  {
   "from": 133.39,
   "to": 137.59,
   "sid": 59,
   "location": 2,
   "content": "可以更好地集中在单侧的肌肉感受上",
   "music": 0.0
  },
  {
   "from": 137.59,
   "to": 140.61,
   "sid": 60,
   "location": 2,
   "content": "这个时候呢你可以把注意力只放在这一边",
   "music": 0.0
  },
  {
   "from": 140.61,
   "to": 143.1,
   "sid": 61,
   "location": 2,
   "content": "提高你对于这个肌肉的控制",
   "music": 0.0
  },
  {
   "from": 143.1,
   "to": 145.79,
   "sid": 62,
   "location": 2,
   "content": "另外一点呢就是分动式器械",
   "music": 0.0
  },
  {
   "from": 145.79,
   "to": 148.13,
   "sid": 63,
   "location": 2,
   "content": "大家可以看到我所使用的这个器械",
   "music": 0.0
  },
  {
   "from": 148.13,
   "to": 150.59,
   "sid": 64,
   "location": 2,
   "content": "向前的拉伸轨迹是非常的长的",
   "music": 0.0
  },
  {
   "from": 150.59,
   "to": 152.69,
   "sid": 65,
   "location": 2,
   "content": "同时呢前面的靠板呢",
   "music": 0.0
  },
  {
   "from": 152.69,
   "to": 154.85,
   "sid": 66,
   "location": 2,
   "content": "可以给你的上半身更好的支撑啊",
   "music": 0.0
  },
  {
   "from": 154.85,
   "to": 157.41,
   "sid": 67,
   "location": 2,
   "content": "不会因为拉伸的过多造成驼背啊",
   "music": 0.0
  },
  {
   "from": 157.41,
   "to": 159.09,
   "sid": 68,
   "location": 2,
   "content": "同时拉过来的时候呢",
   "music": 0.0
  },
  {
   "from": 159.09,
   "to": 162.34,
   "sid": 69,
   "location": 2,
   "content": "也一样可以帮助你达到更好收缩的效果啊",
   "music": 0.0
  },
  {
   "from": 162.34,
   "to": 165.46,
   "sid": 70,
   "location": 2,
   "content": "因为这种固定器械的轨迹呢也是固定的",
   "music": 0.0
  },
  {
   "from": 165.46,
   "to": 167.019,
   "sid": 71,
   "location": 2,
   "content": "所以说到这里之后呢",
   "music": 0.0
  },
  {
   "from": 167.019,
   "to": 168.699,
   "sid": 72,
   "location": 2,
   "content": "肘关节略微向内收",
   "music": 0.0
  },
  {
   "from": 168.699,
   "to": 171.26,
   "sid": 73,
   "location": 2,
   "content": "夹紧的还是背部偏上的位置啊",
   "music": 0.0
  },
  {
   "from": 171.26,
   "to": 173.42,
   "sid": 74,
   "location": 2,
   "content": "慢一点向前总结起来了",
   "music": 0.0
  },
  {
   "from": 173.42,
   "to": 174.44,
   "sid": 75,
   "location": 2,
   "content": "单臂训练的时候呢",
   "music": 0.0
  },
  {
   "from": 174.44,
   "to": 176.0,
   "sid": 76,
   "location": 2,
   "content": "一方面是可以更好的提高",
   "music": 0.0
  },
  {
   "from": 176.0,
   "to": 178.48,
   "sid": 77,
   "location": 2,
   "content": "我们对于肌肉的控制啊",
   "music": 0.0
  },
  {
   "from": 178.48,
   "to": 181.99,
   "sid": 78,
   "location": 2,
   "content": "另外一点呢就是可以增长整个运动的幅度啊",
   "music": 0.0
  },
  {
   "from": 181.99,
   "to": 185.33,
   "sid": 79,
   "location": 2,
   "content": "给你肌肉更好的收缩和拉伸的感觉",
   "music": 0.0
  },
  {
   "from": 185.33,
   "to": 188.53,
   "sid": 80,
   "location": 2,
   "content": "接下来我们来学习一下不一样的握把的区别啊",
   "music": 0.0
  },
  {
   "from": 188.53,
   "to": 190.57,
   "sid": 81,
   "location": 2,
   "content": "在训练背部的过程当中",
   "music": 0.0
  },
  {
   "from": 190.57,
   "to": 192.25,
   "sid": 82,
   "location": 2,
   "content": "我最喜欢的握把呢",
   "music": 0.0
  },
  {
   "from": 192.25,
   "to": 194.41,
   "sid": 83,
   "location": 2,
   "content": "也是帮助大家更容易找到感受",
   "music": 0.0
  },
  {
   "from": 194.41,
   "to": 195.86,
   "sid": 84,
   "location": 2,
   "content": "就是这个竖握的握把",
   "music": 0.0
  },
  {
   "from": 195.86,
   "to": 198.5,
   "sid": 85,
   "location": 2,
   "content": "在做这种握把方式的划船的时候呢",
   "music": 0.0
  },
  {
   "from": 198.5,
   "to": 201.26,
   "sid": 86,
   "location": 2,
   "content": "我们的肘关节可以更容易向内收进来啊",
   "music": 0.0
  },
  {
   "from": 201.26,
   "to": 202.23,
   "sid": 87,
   "location": 2,
   "content": "贴近身体",
   "music": 0.0
  },
  {
   "from": 202.23,
   "to": 205.63,
   "sid": 88,
   "location": 2,
   "content": "这个时候呢可以帮助我们更好地夹紧背部啊",
   "music": 0.0
  },
  {
   "from": 205.63,
   "to": 208.69,
   "sid": 89,
   "location": 2,
   "content": "同时呢向前的拉伸也是非常的充分的啊",
   "music": 0.0
  },
  {
   "from": 208.69,
   "to": 211.21,
   "sid": 90,
   "location": 2,
   "content": "所以说如果你是刚开始学习这个动作的话",
   "music": 0.0
  },
  {
   "from": 211.21,
   "to": 213.51,
   "sid": 91,
   "location": 2,
   "content": "我建议大家采用竖握的方式啊",
   "music": 0.0
  },
  {
   "from": 213.51,
   "to": 214.83,
   "sid": 92,
   "location": 2,
   "content": "偏高一点的位置呢",
   "music": 0.0
  },
  {
   "from": 214.83,
   "to": 216.09,
   "sid": 93,
   "location": 2,
   "content": "这个握把不仅高啊",
   "music": 0.0
  },
  {
   "from": 216.09,
   "to": 217.77,
   "sid": 94,
   "location": 2,
   "content": "而且它是一个横卧的方式啊",
   "music": 0.0
  },
  {
   "from": 217.77,
   "to": 220.16,
   "sid": 95,
   "location": 2,
   "content": "所以说我们在这样使用的过程当中呢",
   "music": 0.0
  },
  {
   "from": 220.16,
   "to": 221.66,
   "sid": 96,
   "location": 2,
   "content": "向后拉过来的时候",
   "music": 0.0
  },
  {
   "from": 221.66,
   "to": 225.14,
   "sid": 97,
   "location": 2,
   "content": "会更多刺激在背阔肌偏上的位置",
   "music": 0.0
  },
  {
   "from": 225.14,
   "to": 227.48,
   "sid": 98,
   "location": 2,
   "content": "同时呢也会训练到斜方肌啊",
   "music": 0.0
  },
  {
   "from": 227.48,
   "to": 229.1,
   "sid": 99,
   "location": 2,
   "content": "同时呢这样的握把方式",
   "music": 0.0
  },
  {
   "from": 229.1,
   "to": 231.68,
   "sid": 100,
   "location": 2,
   "content": "也会带动一些手臂的参与啊",
   "music": 0.0
  },
  {
   "from": 231.68,
   "to": 233.18,
   "sid": 101,
   "location": 2,
   "content": "那么在训练的过程当中呢",
   "music": 0.0
  },
  {
   "from": 233.18,
   "to": 235.52,
   "sid": 102,
   "location": 2,
   "content": "对于手臂的力量要求也是比较高的",
   "music": 0.0
  },
  {
   "from": 235.52,
   "to": 238.88,
   "sid": 103,
   "location": 2,
   "content": "所以说要根据自己的情况选择自己的握把方式",
   "music": 0.0
  },
  {
   "from": 238.88,
   "to": 242.5,
   "sid": 104,
   "location": 2,
   "content": "而外侧这两边的握把和偏下面一点的握把呢",
   "music": 0.0
  },
  {
   "from": 242.5,
   "to": 243.88,
   "sid": 105,
   "location": 2,
   "content": "是比较少使用的",
   "music": 0.0
  },
  {
   "from": 243.88,
   "to": 246.52,
   "sid": 106,
   "location": 2,
   "content": "因为它的角度呢和我们在运动当中",
   "music": 0.0
  },
  {
   "from": 246.52,
   "to": 248.29,
