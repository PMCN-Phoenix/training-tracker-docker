   "from": 45.299,
   "to": 46.419,
   "sid": 26,
   "location": 2,
   "content": "我们先拿窄版",
   "music": 0.0
  },
  {
   "from": 46.419,
   "to": 48.299,
   "sid": 27,
   "location": 2,
   "content": "但我们做一个肩胛主动收缩的",
   "music": 0.0
  },
  {
   "from": 48.299,
   "to": 49.499,
   "sid": 28,
   "location": 2,
   "content": "那你知道区别对吧",
   "music": 0.0
  },
  {
   "from": 49.499,
   "to": 51.89,
   "sid": 29,
   "location": 2,
   "content": "你说宽和窄的是远了对",
   "music": 0.0
  },
  {
   "from": 51.89,
   "to": 53.63,
   "sid": 30,
   "location": 2,
   "content": "要不要不再讲一下啊",
   "music": 0.0
  },
  {
   "from": 53.63,
   "to": 55.13,
   "sid": 31,
   "location": 2,
   "content": "这是我们得简单带一下啊",
   "music": 0.0
  },
  {
   "from": 55.13,
   "to": 57.41,
   "sid": 32,
   "location": 2,
   "content": "就我们这个只简单跟大家说一下结论",
   "music": 0.0
  },
  {
   "from": 57.41,
   "to": 58.97,
   "sid": 33,
   "location": 2,
   "content": "然后如果具体的推导过程",
   "music": 0.0
  },
  {
   "from": 58.97,
   "to": 60.8,
   "sid": 34,
   "location": 2,
   "content": "大家回去看我前面那期视频",
   "music": 0.0
  },
  {
   "from": 60.8,
   "to": 62.56,
   "sid": 35,
   "location": 2,
   "content": "就是如果你做划船的时候",
   "music": 0.0
  },
  {
   "from": 62.56,
   "to": 66.8,
   "sid": 36,
   "location": 2,
   "content": "你的主练的目的在这个中下斜方肌",
   "music": 0.0
  },
  {
   "from": 66.8,
   "to": 70.0,
   "sid": 37,
   "location": 2,
   "content": "那你适合拿一个宽吧来配合它",
   "music": 0.0
  },
  {
   "from": 70.0,
   "to": 71.92,
   "sid": 38,
   "location": 2,
   "content": "因为你看宽握比窄握",
   "music": 0.0
  },
  {
   "from": 71.92,
   "to": 74.48,
   "sid": 39,
   "location": 2,
   "content": "你的内收空间会更大一点",
   "music": 0.0
  },
  {
   "from": 74.48,
   "to": 74.84,
   "sid": 40,
   "location": 2,
   "content": "对不对",
   "music": 0.0
  },
  {
   "from": 74.84,
   "to": 78.8,
   "sid": 41,
   "location": 2,
   "content": "然后握一个宽握做一个肩胛的主动收缩过来贴",
   "music": 0.0
  },
  {
   "from": 78.8,
   "to": 80.16,
   "sid": 42,
   "location": 2,
   "content": "让你挺胸椎了啊",
   "music": 0.0
  },
  {
   "from": 80.16,
   "to": 81.62,
   "sid": 43,
   "location": 2,
   "content": "你不要挺胸椎嗯",
   "music": 0.0
  },
  {
   "from": 81.62,
   "to": 84.52,
   "sid": 44,
   "location": 2,
   "content": "然后窄卧呢更适合拿来做背阔肌",
   "music": 0.0
  },
  {
   "from": 84.52,
   "to": 85.36,
   "sid": 45,
   "location": 2,
   "content": "肩伸的功能",
   "music": 0.0
  },
  {
   "from": 85.36,
   "to": 88.32,
   "sid": 46,
   "location": 2,
   "content": "要想弹簧在这儿这种压弹簧的感觉",
   "music": 0.0
  },
  {
   "from": 88.32,
   "to": 91.1,
   "sid": 47,
   "location": 2,
