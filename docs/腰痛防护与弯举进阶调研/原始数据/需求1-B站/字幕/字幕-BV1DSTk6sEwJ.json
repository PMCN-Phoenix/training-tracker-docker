{
 "lan": "ai-zh",
 "lan_doc": "中文",
 "body": [
  {
   "from": 0.0,
   "to": 1.44,
   "sid": 1,
   "location": 2,
   "content": "有一些小问题我们先往后讲",
   "music": 0.0
  },
  {
   "from": 1.44,
   "to": 2.2,
   "sid": 2,
   "location": 2,
   "content": "主要三个大的问题",
   "music": 0.0
  },
  {
   "from": 2.2,
   "to": 3.04,
   "sid": 3,
   "location": 2,
   "content": "一你会挺胸椎",
   "music": 0.0
  },
  {
   "from": 3.04,
   "to": 4.56,
   "sid": 4,
   "location": 2,
   "content": "二你的发力主要在手上",
   "music": 0.0
  },
  {
   "from": 4.56,
   "to": 6.4,
   "sid": 5,
   "location": 2,
   "content": "所不在你的腰的肩胛这块",
   "music": 0.0
  },
  {
   "from": 6.4,
   "to": 8.22,
   "sid": 6,
   "location": 2,
   "content": "然后还有第三个就是你的肱骨会旋前",
   "music": 0.0
  },
  {
   "from": 8.22,
   "to": 9.06,
   "sid": 7,
   "location": 2,
   "content": "哈喽大家好",
   "music": 0.0
  },
  {
   "from": 9.06,
   "to": 9.92,
   "sid": 8,
   "location": 2,
   "content": "这里是口口",
   "music": 0.0
  },
  {
   "from": 9.92,
   "to": 11.74,
   "sid": 9,
   "location": 2,
   "content": "刚刚大家看到的这个视频呢",
   "music": 0.0
  },
  {
   "from": 11.74,
   "to": 15.2,
   "sid": 10,
   "location": 2,
   "content": "是学员实际动作过程中出现的三个主要问题",
   "music": 0.0
  },
  {
   "from": 15.2,
   "to": 16.36,
   "sid": 11,
   "location": 2,
   "content": "那把它摘出来呢",
   "music": 0.0
  },
  {
   "from": 16.36,
   "to": 17.8,
   "sid": 12,
   "location": 2,
   "content": "是因为它很具有代表性",
   "music": 0.0
  },
  {
   "from": 17.8,
   "to": 20.2,
   "sid": 13,
   "location": 2,
   "content": "很多人在做坐姿划船这个动作的时候",
   "music": 0.0
  },
  {
   "from": 20.2,
   "to": 21.76,
   "sid": 14,
   "location": 2,
   "content": "都会出现类似的情况",
   "music": 0.0
  },
  {
   "from": 21.76,
   "to": 23.59,
   "sid": 15,
   "location": 2,
   "content": "那在这期视频里呢",
   "music": 0.0
  },
  {
   "from": 23.59,
   "to": 25.19,
   "sid": 16,
   "location": 2,
   "content": "我们以实际的例子出发",
   "music": 0.0
  },
  {
   "from": 25.19,
   "to": 28.09,
   "sid": 17,
   "location": 2,
   "content": "跟大家讲解可能出现问题的原因是什么",
   "music": 0.0
  },
  {
   "from": 28.09,
   "to": 29.41,
   "sid": 18,
   "location": 2,
   "content": "以及怎么解决",
   "music": 0.0
  },
  {
   "from": 29.41,
   "to": 32.17,
   "sid": 19,
   "location": 2,
   "content": "如果你也希望自己的动作以类似的方式",
   "music": 0.0
  },
  {
   "from": 32.17,
   "to": 33.38,
   "sid": 20,
   "location": 2,
   "content": "由我来调整呢",
   "music": 0.0
  },
  {
   "from": 33.38,
   "to": 36.34,
   "sid": 21,
   "location": 2,
   "content": "非常欢迎你把自己的动作视频投稿给我",
   "music": 0.0
  },
  {
   "from": 36.34,
   "to": 37.86,
   "sid": 22,
   "location": 2,
   "content": "那具体的投稿方式呢",
   "music": 0.0
  },
  {
   "from": 37.86,
   "to": 40.62,
   "sid": 23,
   "location": 2,
   "content": "欢迎大家进我主页的小红书群里面",
   "music": 0.0
  },
  {
   "from": 40.62,
   "to": 44.379,
   "sid": 24,
   "location": 2,
   "content": "里面有具体的方式介绍来",
   "music": 0.0
  },
  {
   "from": 44.379,
   "to": 45.299,
   "sid": 25,
   "location": 2,
   "content": "你正常先做",
