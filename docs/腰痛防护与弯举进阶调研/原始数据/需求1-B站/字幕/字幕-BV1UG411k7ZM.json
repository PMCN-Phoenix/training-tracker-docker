{
 "lan": "ai-zh",
 "lan_doc": "中文",
 "body": [
  {
   "from": 0.06,
   "to": 1.56,
   "sid": 1,
   "location": 2,
   "content": "兄弟姐妹们",
   "music": 0.0
  },
  {
   "from": 1.56,
   "to": 2.76,
   "sid": 2,
   "location": 2,
   "content": "你们都说武神划船",
   "music": 0.0
  },
  {
   "from": 2.76,
   "to": 3.9,
   "sid": 3,
   "location": 2,
   "content": "哑铃划船太难了",
   "music": 0.0
  },
  {
   "from": 3.9,
   "to": 5.91,
   "sid": 4,
   "location": 2,
   "content": "然后呢有没有更适合新手上来",
   "music": 0.0
  },
  {
   "from": 5.91,
   "to": 7.74,
   "sid": 5,
   "location": 2,
   "content": "就是更容易一点的",
   "music": 0.0
  },
  {
   "from": 7.74,
   "to": 10.83,
   "sid": 6,
   "location": 2,
   "content": "那我们今天讲这个动作呢叫坐姿划船",
   "music": 0.0
  },
  {
   "from": 10.83,
   "to": 11.85,
   "sid": 7,
   "location": 2,
   "content": "那我们话不多说",
   "music": 0.0
  },
  {
   "from": 11.85,
   "to": 12.8,
   "sid": 8,
   "location": 2,
   "content": "直接进入正题",
   "music": 0.0
  },
  {
   "from": 12.8,
   "to": 14.18,
   "sid": 9,
   "location": 2,
   "content": "我们先说一下脚的位置",
   "music": 0.0
  },
  {
   "from": 14.18,
   "to": 17.0,
   "sid": 10,
   "location": 2,
   "content": "尽量大腿小腿的这个夹角要大于90度",
   "music": 0.0
  },
  {
   "from": 17.0,
   "to": 19.22,
   "sid": 11,
   "location": 2,
   "content": "这样避免大腿过多的参与对",
   "music": 0.0
  },
  {
   "from": 19.22,
   "to": 21.2,
   "sid": 12,
   "location": 2,
   "content": "也就是如果你前面这有一个板的话",
   "music": 0.0
  },
  {
   "from": 21.2,
   "to": 22.16,
   "sid": 13,
   "location": 2,
   "content": "你就要踩到上面",
   "music": 0.0
  },
  {
   "from": 22.16,
   "to": 23.48,
   "sid": 14,
   "location": 2,
   "content": "如果这没有的话",
   "music": 0.0
  },
  {
   "from": 23.48,
   "to": 25.28,
   "sid": 15,
   "location": 2,
   "content": "像我们现在这个位置",
   "music": 0.0
  },
  {
   "from": 25.28,
   "to": 27.619,
   "sid": 16,
   "location": 2,
   "content": "你可以去垫一个杠铃片",
   "music": 0.0
  },
  {
   "from": 27.619,
   "to": 29.539,
   "sid": 17,
   "location": 2,
   "content": "然后这个脚踩在杠铃片",
   "music": 0.0
  },
  {
   "from": 29.539,
   "to": 30.799,
   "sid": 18,
   "location": 2,
   "content": "不能让你发力的时候",
   "music": 0.0
  },
  {
   "from": 30.799,
   "to": 32.509,
   "sid": 19,
   "location": 2,
   "content": "身体被往前拉啊",
   "music": 0.0
  },
  {
   "from": 32.509,
   "to": 33.079,
   "sid": 20,
   "location": 2,
   "content": "固定好",
   "music": 0.0
  },
  {
   "from": 33.079,
   "to": 34.219,
   "sid": 21,
   "location": 2,
   "content": "这个大家知道就行了",
   "music": 0.0
  },
  {
   "from": 34.219,
   "to": 34.92,
   "sid": 22,
   "location": 2,
   "content": "然后呢",
   "music": 0.0
  },
  {
   "from": 34.92,
   "to": 38.76,
   "sid": 23,
   "location": 2,
   "content": "我们身体的位置跟这个器械尽量留差不多",
   "music": 0.0
  },
  {
   "from": 38.76,
   "to": 40.2,
   "sid": 24,
   "location": 2,
   "content": "一拳到两拳的距离",
   "music": 0.0
  },
  {
   "from": 40.2,
   "to": 41.849,
   "sid": 25,
   "location": 2,
   "content": "也就是比如说把他拉起来",
   "music": 0.0
  },
  {
   "from": 41.849,
   "to": 44.009,
   "sid": 26,
   "location": 2,
   "content": "你看把他把他拉起来",
   "music": 0.0
  },
  {
   "from": 44.009,
   "to": 46.139,
   "sid": 27,
   "location": 2,
   "content": "身体调整到重心正好以后",
   "music": 0.0
  },
  {
   "from": 46.139,
   "to": 48.749,
   "sid": 28,
   "location": 2,
   "content": "就是差不多会有个一拳到两拳的量",
   "music": 0.0
  },
  {
   "from": 48.749,
   "to": 50.2,
   "sid": 29,
   "location": 2,
   "content": "哎你往前两拳",
   "music": 0.0
  },
  {
   "from": 50.2,
   "to": 51.76,
   "sid": 30,
   "location": 2,
   "content": "你看就放上了",
   "music": 0.0
  },
  {
   "from": 51.76,
   "to": 52.99,
   "sid": 31,
   "location": 2,
   "content": "不能留特别远",
   "music": 0.0
  },
  {
   "from": 52.99,
   "to": 54.82,
   "sid": 32,
   "location": 2,
   "content": "这样你腰的压力比较大",
   "music": 0.0
  },
  {
   "from": 54.82,
   "to": 56.02,
   "sid": 33,
   "location": 2,
   "content": "也不能特别近",
   "music": 0.0
  },
  {
   "from": 56.02,
   "to": 57.4,
   "sid": 34,
   "location": 2,
   "content": "比如说就再往前坐一点",
   "music": 0.0
  },
  {
   "from": 57.4,
   "to": 60.12,
   "sid": 35,
   "location": 2,
   "content": "对每回放下去的时候就会砸到",
   "music": 0.0
  },
  {
   "from": 60.12,
   "to": 60.93,
   "sid": 36,
   "location": 2,
   "content": "那也不好",
   "music": 0.0
  },
  {
   "from": 60.93,
   "to": 62.88,
   "sid": 37,
   "location": 2,
   "content": "所以说这是前后的距离",
   "music": 0.0
  },
  {
   "from": 62.88,
   "to": 63.6,
   "sid": 38,
   "location": 2,
   "content": "我们要调整好",
   "music": 0.0
  },
  {
   "from": 63.6,
   "to": 66.019,
   "sid": 39,
   "location": 2,
   "content": "然后我们再来说身体的角度哎",
   "music": 0.0
  },
  {
   "from": 66.019,
   "to": 67.039,
   "sid": 40,
   "location": 2,
   "content": "往后倾一点",
   "music": 0.0
  },
  {
   "from": 67.039,
   "to": 71.77,
   "sid": 41,
   "location": 2,
   "content": "OK我们很多人为了追求被最大程度的受力",
   "music": 0.0
  },
  {
   "from": 71.77,
   "to": 73.15,
   "sid": 42,
   "location": 2,
   "content": "就是在力学角度上",
   "music": 0.0
  },
  {
   "from": 73.15,
   "to": 74.83,
   "sid": 43,
   "location": 2,
   "content": "那我们就做了一个",
   "music": 0.0
  },
  {
   "from": 74.83,
   "to": 78.75,
   "sid": 44,
   "location": 2,
   "content": "比如说身体完全垂直于地面的这么一个状态",
   "music": 0.0
  },
  {
   "from": 78.75,
   "to": 80.01,
   "sid": 45,
   "location": 2,
   "content": "这确实在力学角度上",
   "music": 0.0
  },
  {
   "from": 80.01,
   "to": 82.29,
   "sid": 46,
   "location": 2,
   "content": "你的背受力是最大化的对吧",
   "music": 0.0
  },
  {
   "from": 82.29,
   "to": 84.76,
   "sid": 47,
   "location": 2,
   "content": "也就是我们很多人做俯身杠铃划船的时候",
   "music": 0.0
  },
  {
   "from": 84.76,
   "to": 87.64,
   "sid": 48,
   "location": 2,
   "content": "我们我们说的角度其实是在这个角度差不多",
   "music": 0.0
  },
  {
   "from": 87.64,
   "to": 89.5,
   "sid": 49,
   "location": 2,
   "content": "但是很多人会追求哎",
   "music": 0.0
  },
  {
   "from": 89.5,
   "to": 91.84,
   "sid": 50,
   "location": 2,
   "content": "无限的跟地面平行的这个阶段",
   "music": 0.0
  },
  {
   "from": 91.84,
   "to": 94.48,
   "sid": 51,
   "location": 2,
   "content": "这个虽说从理论上说它受力最大化",
   "music": 0.0
  },
  {
   "from": 94.48,
   "to": 96.34,
   "sid": 52,
   "location": 2,
   "content": "但是你一旦有负重的话",
   "music": 0.0
  },
  {
   "from": 96.34,
   "to": 97.89,
   "sid": 53,
   "location": 2,
   "content": "你的腰也会参与",
   "music": 0.0
  },
  {
   "from": 97.89,
   "to": 100.89,
   "sid": 54,
   "location": 2,
   "content": "就是说你的竖脊肌要给它一个向后的力量",
   "music": 0.0
  },
  {
   "from": 100.89,
   "to": 103.91,
   "sid": 55,
   "location": 2,
   "content": "才能保证身体不背拉到前面去",
   "music": 0.0
  },
  {
   "from": 103.91,
   "to": 104.57,
   "sid": 56,
   "location": 2,
   "content": "也就是说",
   "music": 0.0
  },
  {
   "from": 104.57,
   "to": 108.62,
   "sid": 57,
   "location": 2,
   "content": "其实你看似诶把背发展到了一个",
   "music": 0.0
  },
  {
   "from": 108.62,
   "to": 109.64,
   "sid": 58,
   "location": 2,
   "content": "最大化的受力角度",
   "music": 0.0
  },
  {
   "from": 109.64,
   "to": 111.8,
   "sid": 59,
   "location": 2,
   "content": "但是其实是激活了你的竖脊肌",
   "music": 0.0
  },
  {
   "from": 111.8,
   "to": 116.01,
   "sid": 60,
   "location": 2,
   "content": "所以说我们要在垂直地面的情况下后倾啊",
   "music": 0.0
  },
  {
   "from": 116.01,
   "to": 118.57,
   "sid": 61,
   "location": 2,
   "content": "差不多15度左右啊",
   "music": 0.0
  },
  {
   "from": 118.57,
   "to": 120.52,
   "sid": 62,
   "location": 2,
   "content": "15~20度左右都是没问题的",
   "music": 0.0
  },
  {
   "from": 120.52,
   "to": 122.89,
   "sid": 63,
   "location": 2,
   "content": "有很多人为了拉特别大的重量",
   "music": 0.0
  },
  {
   "from": 122.89,
   "to": 124.96,
   "sid": 64,
   "location": 2,
   "content": "然后后倾角度特别大啊",
   "music": 0.0
  },
  {
   "from": 124.96,
   "to": 126.22,
   "sid": 65,
   "location": 2,
   "content": "这个就没有必要了",
   "music": 0.0
  },
  {
   "from": 126.22,
   "to": 127.28,
   "sid": 66,
   "location": 2,
   "content": "因为你越后倾",
   "music": 0.0
  },
  {
   "from": 127.28,
   "to": 129.74,
   "sid": 67,
   "location": 2,
   "content": "你受力就可能会更偏上一点",
   "music": 0.0
  },
  {
   "from": 129.74,
   "to": 130.82,
   "sid": 68,
   "location": 2,
   "content": "OK我说完了",
   "music": 0.0
  },
  {
   "from": 130.82,
   "to": 132.08,
   "sid": 69,
   "location": 2,
   "content": "就是这个身体前后",
   "music": 0.0
  },
  {
   "from": 132.08,
   "to": 133.37,
   "sid": 70,
   "location": 2,
   "content": "然后我们说一下胸椎",
   "music": 0.0
  },
  {
   "from": 133.37,
   "to": 135.48,
   "sid": 71,
   "location": 2,
   "content": "我们把胸腔想象成一个盆",
   "music": 0.0
  },
  {
   "from": 135.48,
   "to": 138.24,
   "sid": 72,
   "location": 2,
   "content": "这个盆往前倒水就是前倾啊",
   "music": 0.0
  },
  {
   "from": 138.24,
   "to": 139.63,
   "sid": 73,
   "location": 2,
   "content": "往后倒水就是后倾",
   "music": 0.0
  },
  {
   "from": 139.63,
   "to": 141.79,
   "sid": 74,
   "location": 2,
   "content": "很多人做了一个玩命的后倾啊",
   "music": 0.0
  },
  {
   "from": 141.79,
   "to": 143.53,
   "sid": 75,
   "location": 2,
   "content": "我认为就是我越挺胸越好",
   "music": 0.0
  },
  {
   "from": 143.53,
   "to": 144.85,
   "sid": 76,
   "location": 2,
   "content": "但是如果你看叶",
   "music": 0.0
  },
  {
   "from": 144.85,
   "to": 147.05,
   "sid": 77,
   "location": 2,
   "content": "现在这就是一个极度挺胸的状态",
   "music": 0.0
  },
  {
   "from": 147.05,
   "to": 149.67,
   "sid": 78,
   "location": 2,
   "content": "你会发现他的腰椎的压力在变大",
   "music": 0.0
  },
  {
   "from": 149.67,
   "to": 151.71,
   "sid": 79,
   "location": 2,
   "content": "所以我们不要让我们的胸椎是一个",
   "music": 0.0
  },
  {
   "from": 151.71,
   "to": 152.94,
   "sid": 80,
   "location": 2,
   "content": "特别后倾的状态",
   "music": 0.0
  },
  {
   "from": 152.94,
   "to": 155.02,
   "sid": 81,
   "location": 2,
   "content": "那么让它中立位啊",
   "music": 0.0
  },
  {
   "from": 155.02,
   "to": 156.67,
   "sid": 82,
   "location": 2,
   "content": "中立位这样就OK了",
   "music": 0.0
  },
  {
   "from": 156.67,
   "to": 158.35,
   "sid": 83,
   "location": 2,
   "content": "当然也不用特别前倾啊",
   "music": 0.0
  },
  {
   "from": 158.35,
   "to": 159.91,
   "sid": 84,
   "location": 2,
   "content": "特别前倾就是另外一种滑法",
   "music": 0.0
  },
  {
   "from": 159.91,
   "to": 161.41,
   "sid": 85,
   "location": 2,
   "content": "我们最后说啊",
   "music": 0.0
  },
  {
   "from": 161.41,
   "to": 163.33,
   "sid": 86,
   "location": 2,
   "content": "这个是我们胸椎状态跟腰椎状态",
   "music": 0.0
  },
  {
   "from": 163.33,
   "to": 164.56,
   "sid": 87,
   "location": 2,
   "content": "还有脚踩的状态",
   "music": 0.0
  },
  {
   "from": 164.56,
   "to": 166.09,
   "sid": 88,
   "location": 2,
   "content": "我们现在把它统一完了之后",
   "music": 0.0
  },
  {
   "from": 166.09,
   "to": 168.03,
   "sid": 89,
   "location": 2,
   "content": "然后我们说手手的区别",
   "music": 0.0
  },
  {
   "from": 168.03,
   "to": 170.31,
   "sid": 90,
   "location": 2,
   "content": "我们这个手拿着负重之后",
   "music": 0.0
  },
  {
   "from": 170.31,
   "to": 172.96,
   "sid": 91,
   "location": 2,
   "content": "首先我们肯定要拿这个把手的中间对吧",
   "music": 0.0
  },
  {
   "from": 172.96,
   "to": 175.21,
   "sid": 92,
   "location": 2,
   "content": "我们今天讲的是这种对握的把手",
   "music": 0.0
  },
  {
   "from": 175.21,
   "to": 177.01,
   "sid": 93,
   "location": 2,
   "content": "但如果它不同的宽度",
   "music": 0.0
  },
  {
   "from": 177.01,
   "to": 179.32,
   "sid": 94,
   "location": 2,
   "content": "练的地儿也是不一样的对吧",
   "music": 0.0
  },
  {
   "from": 179.32,
   "to": 182.29,
   "sid": 95,
   "location": 2,
   "content": "这个对握的把手我们可以让背整体的发展",
   "music": 0.0
  },
  {
   "from": 182.29,
   "to": 183.55,
   "sid": 96,
   "location": 2,
   "content": "比如说中下斜方肌也可以",
   "music": 0.0
  },
  {
   "from": 183.55,
   "to": 184.8,
   "sid": 97,
   "location": 2,
   "content": "然后背阔肌也可以",
   "music": 0.0
  },
  {
   "from": 184.8,
   "to": 186.66,
   "sid": 98,
   "location": 2,
   "content": "但是如果我们拿那种特别宽的把手",
   "music": 0.0
  },
  {
   "from": 186.66,
   "to": 188.28,
   "sid": 99,
   "location": 2,
   "content": "一般都是练上背部的",
   "music": 0.0
  },
  {
   "from": 188.28,
   "to": 190.14,
   "sid": 100,
   "location": 2,
   "content": "练下背部的就参与的比较少了",
   "music": 0.0
  },
  {
   "from": 190.14,
   "to": 192.52,
   "sid": 101,
   "location": 2,
   "content": "如果我们把这个把手更往上",
   "music": 0.0
  },
  {
   "from": 192.52,
   "to": 193.96,
   "sid": 102,
   "location": 2,
   "content": "比如我们来划几个",
   "music": 0.0
  },
  {
   "from": 193.96,
   "to": 195.12,
   "sid": 103,
   "location": 2,
   "content": "唉对啊",
   "music": 0.0
  },
  {
   "from": 195.12,
   "to": 196.5,
   "sid": 104,
   "location": 2,
   "content": "这太太往上了",
   "music": 0.0
  },
  {
   "from": 196.5,
   "to": 197.76,
   "sid": 105,
   "location": 2,
   "content": "就靠近背的位置就可以了",
   "music": 0.0
  },
  {
   "from": 197.76,
   "to": 198.9,
   "sid": 106,
   "location": 2,
   "content": "然后我们从后边看",
   "music": 0.0
  },
  {
   "from": 198.9,
   "to": 200.85,
   "sid": 107,
   "location": 2,
   "content": "尤其是用肩胛内收带动的时候",
   "music": 0.0
  },
  {
   "from": 200.85,
   "to": 202.97,
   "sid": 108,
   "location": 2,
   "content": "这个时候我们的中下斜方肌啊",
   "music": 0.0
  },
  {
   "from": 202.97,
   "to": 203.93,
   "sid": 109,
   "location": 2,
   "content": "菱形肌",
   "music": 0.0
  },
  {
   "from": 203.93,
   "to": 207.23,
   "sid": 110,
   "location": 2,
   "content": "然后呢包括从大圆上背阔过来说",
   "music": 0.0
  },
  {
   "from": 207.23,
   "to": 209.27,
