{
 "lan": "ai-zh",
 "lan_doc": "中文",
 "body": [
  {
   "from": 0.56,
   "to": 1.96,
   "sid": 1,
   "location": 2,
   "content": "为什么你的坐姿划船",
   "music": 0.0
  },
  {
   "from": 1.96,
   "to": 3.38,
   "sid": 2,
   "location": 2,
   "content": "坐完你三条腿",
   "music": 0.0
  },
  {
   "from": 3.38,
   "to": 4.76,
   "sid": 3,
   "location": 2,
   "content": "看看你是不是这样做的",
   "music": 0.0
  },
  {
   "from": 4.76,
   "to": 5.64,
   "sid": 4,
   "location": 2,
   "content": "骨盆不稳定",
   "music": 0.0
  },
  {
   "from": 5.64,
   "to": 6.9,
   "sid": 5,
   "location": 2,
   "content": "脊柱没有中立",
   "music": 0.0
  },
  {
   "from": 6.9,
   "to": 8.14,
   "sid": 6,
   "location": 2,
   "content": "身体都快被带跑了",
   "music": 0.0
  },
  {
   "from": 8.14,
   "to": 9.46,
   "sid": 7,
   "location": 2,
   "content": "腰椎受力这么大",
   "music": 0.0
  },
  {
   "from": 9.46,
   "to": 10.44,
   "sid": 8,
   "location": 2,
   "content": "它能不腰痛吗",
   "music": 0.0
  },
  {
   "from": 10.44,
   "to": 11.48,
   "sid": 9,
   "location": 2,
   "content": "想要避免腰痛",
   "music": 0.0
  },
  {
   "from": 11.48,
   "to": 12.58,
   "sid": 10,
   "location": 2,
   "content": "你得这样一",
   "music": 0.0
  },
  {
   "from": 12.58,
   "to": 14.06,
   "sid": 11,
   "location": 2,
   "content": "重心放在脚后跟上",
   "music": 0.0
  },
  {
   "from": 14.06,
   "to": 15.32,
   "sid": 12,
   "location": 2,
   "content": "不要放在前脚掌",
   "music": 0.0
  },
  {
   "from": 15.32,
   "to": 17.12,
   "sid": 13,
   "location": 2,
   "content": "脚后跟用力向后蹬",
   "music": 0.0
  },
  {
   "from": 17.12,
   "to": 19.66,
   "sid": 14,
   "location": 2,
   "content": "将这个力顺着你的大腿传到骨盆",
   "music": 0.0
  },
  {
   "from": 19.66,
   "to": 21.12,
   "sid": 15,
   "location": 2,
   "content": "才能保持骨盆稳定",
   "music": 0.0
  },
  {
   "from": 21.12,
   "to": 23.06,
   "sid": 16,
   "location": 2,
   "content": "二整个脊柱保持中立",
   "music": 0.0
  },
  {
   "from": 23.06,
   "to": 24.54,
   "sid": 17,
   "location": 2,
   "content": "不要弓腰或者顶腰",
   "music": 0.0
  },
  {
   "from": 24.54,
   "to": 26.02,
   "sid": 18,
   "location": 2,
   "content": "身体不要完全坐直",
   "music": 0.0
  },
  {
   "from": 26.02,
   "to": 27.759,
   "sid": 19,
   "location": 2,
   "content": "微微向后倾十度左右",
   "music": 0.0
  },
  {
   "from": 27.759,
   "to": 29.079,
   "sid": 20,
   "location": 2,
   "content": "减小腰椎的压力",
   "music": 0.0
  },
  {
   "from": 29.079,
   "to": 30.359,
   "sid": 21,
   "location": 2,
   "content": "三离心还原时",
   "music": 0.0
  },
  {
   "from": 30.359,
   "to": 32.559,
   "sid": 22,
   "location": 2,
   "content": "利用肩胛骨前引的功能",
   "music": 0.0
  },
  {
   "from": 32.559,
   "to": 36.32,
   "sid": 23,
   "location": 2,
   "content": "用整个背部的肌肉对抗的重量一点点放回去",
   "music": 0.0
  },
  {
   "from": 36.32,
   "to": 37.9,
   "sid": 24,
   "location": 2,
   "content": "整个脊柱保持稳定",
   "music": 0.0
  },
  {
   "from": 37.9,
   "to": 39.5,
   "sid": 25,
   "location": 2,
   "content": "不要被把手带着往前跑",
   "music": 0.0
  },
  {
   "from": 39.5,
   "to": 40.56,
   "sid": 26,
   "location": 2,
   "content": "造成脊柱前屈",
   "music": 0.0
  },
  {
   "from": 40.56,
   "to": 41.64,
   "sid": 27,
   "location": 2,
   "content": "那些坐姿划船",
   "music": 0.0
  },
  {
   "from": 41.64,
   "to": 43.3,
   "sid": 28,
   "location": 2,
   "content": "腰疼的宝子们赶紧去试试吧",
   "music": 0.0
  }
 ]
}