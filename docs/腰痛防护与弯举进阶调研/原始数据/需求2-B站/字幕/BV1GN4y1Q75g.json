  "body": [
    {
      "from": 0.14,
      "to": 0.62,
      "sid": 1,
      "location": 2,
      "content": "嗨大家好",
      "music": 0.0
    },
    {
      "from": 0.62,
      "to": 1.4,
      "sid": 2,
      "location": 2,
      "content": "我是ALEX",
      "music": 0.0
    },
    {
      "from": 1.4,
      "to": 2.66,
      "sid": 3,
      "location": 2,
      "content": "欢迎大家回到我的频道",
      "music": 0.0
    },
    {
      "from": 2.66,
      "to": 5.279,
      "sid": 4,
      "location": 2,
      "content": "今天这期视频我们带来了手臂训练",
      "music": 0.0
    },
    {
      "from": 5.279,
      "to": 8.519,
      "sid": 5,
      "location": 2,
      "content": "今天所分享的动作呢也是在视频留言当中呢",
      "music": 0.0
    },
    {
      "from": 8.519,
      "to": 12.5,
      "sid": 6,
      "location": 2,
      "content": "体脂率比较高的牧师凳弯举",
      "music": 0.0
    },
    {
      "from": 20.08,
      "to": 22.2,
      "sid": 7,
      "location": 2,
      "content": "想要让你的肱二头肌猛长的话",
      "music": 0.0
    },
    {
      "from": 22.2,
      "to": 24.6,
      "sid": 8,
      "location": 2,
      "content": "那么弯举是一个不可避免的训练动作",
      "music": 0.0
    },
    {
      "from": 24.6,
      "to": 25.76,
      "sid": 9,
      "location": 2,
      "content": "而其中的牧师凳",
      "music": 0.0
    },
    {
      "from": 25.76,
      "to": 28.46,
      "sid": 10,
      "location": 2,
      "content": "弯举呢又是一个非常好的去孤立训练",
      "music": 0.0
    },
    {
      "from": 28.46,
      "to": 29.63,
      "sid": 11,
      "location": 2,
      "content": "肱二头肌的动作",
      "music": 0.0
    },
    {
      "from": 29.63,
      "to": 31.22,
      "sid": 12,
      "location": 2,
      "content": "我们在训练的过程当中呢",
      "music": 0.0
    },
    {
      "from": 31.22,
      "to": 32.76,
      "sid": 13,
      "location": 2,
      "content": "只需要一个牧师凳啊",
      "music": 0.0
    },
    {
      "from": 32.76,
      "to": 33.3,
      "sid": 14,
      "location": 2,
      "content": "然后呢",
      "music": 0.0
    },
    {
      "from": 33.3,
      "to": 36.18,
      "sid": 15,
      "location": 2,
      "content": "就是一个适合你自己重量的杠铃就可以了",
      "music": 0.0
    },
    {
      "from": 36.18,
      "to": 38.28,
      "sid": 16,
      "location": 2,
      "content": "其实牧师凳的设置呢非常简单啊",
      "music": 0.0
    },
    {
      "from": 38.28,
      "to": 39.72,
      "sid": 17,
      "location": 2,
      "content": "这里只有一个可以调节的",
      "music": 0.0
    },
    {
      "from": 39.72,
      "to": 40.86,
      "sid": 18,
      "location": 2,
      "content": "就是我们凳子的高度啊",
      "music": 0.0
    },
    {
      "from": 40.86,
      "to": 43.2,
      "sid": 19,
      "location": 2,
      "content": "这个呢也取决于你上半身的伸长啊",
      "music": 0.0
    },
    {
      "from": 43.2,
      "to": 47.18,
      "sid": 20,
      "location": 2,
      "content": "我们怎么样去衡量一个适合自己的坐姿高度呢",
      "music": 0.0
    },
    {
      "from": 47.18,
      "to": 50.86,
      "sid": 21,
      "location": 2,
      "content": "我们可以保证整个上臂完全贴合在靠板上啊",
      "music": 0.0
    },
    {
      "from": 50.86,
      "to": 55.98,
      "sid": 22,
      "location": 2,
      "content": "是用你的背的外侧和上臂去夹住这个靠板啊",
      "music": 0.0
    },
    {
      "from": 55.98,
      "to": 57.9,
      "sid": 23,
      "location": 2,
      "content": "接下来呢就是我们双手的距离啊",
      "music": 0.0
    },
    {
      "from": 57.9,
      "to": 60.07,
      "sid": 24,
      "location": 2,
      "content": "其实在训练弯举的动作的时候呢",
      "music": 0.0
    },
    {
      "from": 60.07,
      "to": 62.41,
      "sid": 25,
      "location": 2,
      "content": "这是一个最标准的姿势",
      "music": 0.0
    },
    {
      "from": 62.41,
      "to": 65.65,
      "sid": 26,
      "location": 2,
      "content": "也就是说我们两个手臂和你的肩膀是同宽的啊",
      "music": 0.0
    },
    {
      "from": 65.65,
      "to": 68.5,
      "sid": 27,
      "location": 2,
      "content": "保证两个手臂是一个平行的状态啊",
      "music": 0.0
    },
    {
      "from": 68.5,
      "to": 70.3,
      "sid": 28,
      "location": 2,
      "content": "这样呢是一个比较标准的",
      "music": 0.0
    },
    {
      "from": 70.3,
      "to": 73.12,
      "sid": 29,
      "location": 2,
      "content": "去训练整个肱二头肌的动作啊",
      "music": 0.0
    },
    {
      "from": 73.12,
      "to": 75.86,
      "sid": 30,
      "location": 2,
      "content": "而如果我们把上臂打开的比较多",
      "music": 0.0
    },
    {
      "from": 75.86,
      "to": 77.78,
      "sid": 31,
      "location": 2,
      "content": "再向上拉起来会怎么样呢",
      "music": 0.0
    },
    {
      "from": 77.78,
      "to": 81.2,
      "sid": 32,
      "location": 2,
      "content": "我们会更多的刺激在肱二头肌的外侧上啊",
      "music": 0.0
    },
    {
      "from": 81.2,
      "to": 82.76,
      "sid": 33,
      "location": 2,
      "content": "所以说大家在训练的时候",
      "music": 0.0
    },
    {
      "from": 82.76,
      "to": 84.86,
      "sid": 34,
      "location": 2,
      "content": "一定要保持一个正确的训练理念啊",
      "music": 0.0
    },
    {
      "from": 84.86,
      "to": 87.02,
      "sid": 35,
      "location": 2,
      "content": "一定要明白你训练的是哪里啊",
      "music": 0.0
    },
    {
      "from": 87.02,
      "to": 87.8,
      "sid": 36,
      "location": 2,
      "content": "我个人比较喜欢",
      "music": 0.0
    },
    {
      "from": 87.8,
      "to": 90.14,
      "sid": 37,
      "location": 2,
      "content": "关键是我非常推荐大家在做牧师凳",
      "music": 0.0
    },
    {
      "from": 90.14,
      "to": 93.38,
      "sid": 38,
      "location": 2,
      "content": "弯举去使用的杠铃呢是驱杆的杠铃啊",
      "music": 0.0
    },
    {
      "from": 93.38,
      "to": 96.38,
      "sid": 39,
      "location": 2,
      "content": "因为这个更符合我们手腕的角度啊",
      "music": 0.0
    },
    {
      "from": 96.38,
      "to": 98.3,
      "sid": 40,
      "location": 2,
      "content": "不管你是在向上和向下的时候呢",
      "music": 0.0
    },
    {
      "from": 98.3,
      "to": 100.09,
      "sid": 41,
      "location": 2,
      "content": "手腕的压力都不会特别大啊",
      "music": 0.0
    },
    {
      "from": 100.09,
      "to": 102.67,
      "sid": 42,
      "location": 2,
      "content": "如果我们使用直杆呢也是可以的啊",
      "music": 0.0
    },
    {
      "from": 102.67,
      "to": 105.79,
      "sid": 43,
      "location": 2,
      "content": "但是呢如果你本身就已经有手腕不舒服的情况",
      "music": 0.0
    },
    {
      "from": 105.79,
      "to": 107.34,
      "sid": 44,
      "location": 2,
      "content": "那么我们在训练的时候呢",
      "music": 0.0
    },
    {
      "from": 107.34,
      "to": 109.98,
      "sid": 45,
      "location": 2,
      "content": "可能会在重量上对你有所限制",
      "music": 0.0
    },
    {
      "from": 109.98,
      "to": 110.58,
      "sid": 46,
      "location": 2,
      "content": "而曲杆",
      "music": 0.0
    },
    {
      "from": 110.58,
      "to": 113.58,
      "sid": 47,
      "location": 2,
      "content": "杠铃呢可以非常好的帮助你去改善这个问题啊",
      "music": 0.0
    },
    {
      "from": 113.58,
      "to": 116.62,
      "sid": 48,
      "location": 2,
      "content": "既能让你使用一个相对比较大的重量",
      "music": 0.0
    },
    {
      "from": 116.62,
      "to": 119.17,
      "sid": 49,
      "location": 2,
      "content": "又能非常好的去刺激整个肱二头肌",
      "music": 0.0
    },
    {
      "from": 119.17,
      "to": 120.4,
      "sid": 50,
      "location": 2,
      "content": "大家可以看到曲杆",
      "music": 0.0
    },
    {
      "from": 120.4,
      "to": 122.6,
      "sid": 51,
      "location": 2,
      "content": "杠铃呢其实是有不一样的顶点的",
      "music": 0.0
    },
    {
      "from": 122.6,
      "to": 123.68,
      "sid": 52,
      "location": 2,
      "content": "我们在使用的时候",
      "music": 0.0
    },
    {
      "from": 123.68,
      "to": 125.0,
      "sid": 53,
      "location": 2,
      "content": "如果我们采用一个手臂",
      "music": 0.0
    },
    {
      "from": 125.0,
      "to": 126.74,
      "sid": 54,
      "location": 2,
      "content": "比较竖直和标准的方式的时候",
      "music": 0.0
    },
    {
      "from": 126.74,
      "to": 130.31,
      "sid": 55,
      "location": 2,
      "content": "我们是握在这个模杀的最顶端的啊",
      "music": 0.0
    },
    {
      "from": 130.31,
      "to": 131.75,
      "sid": 56,
      "location": 2,
      "content": "是这么去抓住的",
      "music": 0.0
    },
    {
      "from": 131.75,
      "to": 133.55,
      "sid": 57,
      "location": 2,
      "content": "也就是说你的拇指和食指呢",
      "music": 0.0
    },
    {
      "from": 133.55,
      "to": 137.0,
      "sid": 58,
      "location": 2,
      "content": "是握在这个磨砂区域的顶端",
      "music": 0.0
    },
    {
      "from": 137.0,
      "to": 138.62,
      "sid": 59,
      "location": 2,
      "content": "而另外一个顶点在哪里呢",
      "music": 0.0
    },
    {
      "from": 138.62,
      "to": 139.97,
      "sid": 60,
      "location": 2,
      "content": "在另外一侧啊",
      "music": 0.0
    },
    {
      "from": 139.97,
      "to": 141.98,
      "sid": 61,
      "location": 2,
      "content": "是这里啊",
      "music": 0.0
    },
    {
      "from": 141.98,
      "to": 142.73,
      "sid": 62,
      "location": 2,
      "content": "装好之后呢",
      "music": 0.0
    },
    {
      "from": 142.73,
      "to": 145.4,
      "sid": 63,
      "location": 2,
      "content": "接下来就来到了整个运动的运动轨迹啊",
      "music": 0.0
    },
    {
      "from": 145.4,
      "to": 147.02,
      "sid": 64,
      "location": 2,
      "content": "我们保证整个身体坐稳",
      "music": 0.0
    },
    {
      "from": 147.02,
      "to": 148.58,
      "sid": 65,
      "location": 2,
      "content": "上臂完全靠住之后呢",
      "music": 0.0
    },
    {
      "from": 148.58,
      "to": 151.28,
      "sid": 66,
      "location": 2,
      "content": "接下来呢所有的发力就来自于哪里呢",
      "music": 0.0
    },
    {
      "from": 151.28,
      "to": 152.98,
      "sid": 67,
      "location": 2,
      "content": "手掌手腕",
      "music": 0.0
    },
    {
      "from": 152.98,
      "to": 154.81,
      "sid": 68,
      "location": 2,
      "content": "还有呢我们的小臂啊",
      "music": 0.0
    },
    {
      "from": 154.81,
      "to": 156.34,
      "sid": 69,
      "location": 2,
      "content": "在运动的过程当中啊",
      "music": 0.0
    },
    {
      "from": 156.34,
      "to": 157.24,
      "sid": 70,
      "location": 2,
      "content": "向下的时候",
      "music": 0.0
    },
    {
      "from": 157.24,
      "to": 159.2,
      "sid": 71,
      "location": 2,
      "content": "这个是一个非常需要注意的点啊",
      "music": 0.0
    },
    {
      "from": 159.2,
      "to": 161.66,
      "sid": 72,
      "location": 2,
      "content": "我们的手臂不是完全绷直的啊",
      "music": 0.0
    },
    {
      "from": 161.66,
      "to": 164.48,
      "sid": 73,
      "location": 2,
      "content": "一定要保持整个手臂的张力啊",
      "music": 0.0
    },
    {
      "from": 164.48,
      "to": 168.32,
      "sid": 74,
      "location": 2,
      "content": "所以说差不多呢向下完成度是多少呢",
      "music": 0.0
    },
    {
      "from": 168.32,
      "to": 170.14,
      "sid": 75,
      "location": 2,
      "content": "90%啊",
      "music": 0.0
    },
    {
      "from": 170.14,
      "to": 172.42,
      "sid": 76,
      "location": 2,
      "content": "肘关节还是保持一个微弯的状态",
      "music": 0.0
    },
    {
      "from": 172.42,
      "to": 175.14,
      "sid": 77,
      "location": 2,
      "content": "但是呢在底端一定要有控制和停留",
      "music": 0.0
    },
    {
      "from": 175.14,
      "to": 177.03,
      "sid": 78,
      "location": 2,
      "content": "再去向上拉起来啊",
      "music": 0.0
    },
    {
      "from": 177.03,
      "to": 179.25,
      "sid": 79,
      "location": 2,
      "content": "而我们向上抬高又抬到多少呢",
      "music": 0.0
    },
    {
      "from": 179.25,
      "to": 181.72,
      "sid": 80,
      "location": 2,
      "content": "不是说撞到你的鼻子或者是嘴巴的位置啊",
      "music": 0.0
    },
    {
      "from": 181.72,
      "to": 183.46,
      "sid": 81,
      "location": 2,
      "content": "我们在向上拉起来的时候",
      "music": 0.0
    },
    {
      "from": 183.46,
      "to": 185.56,
      "sid": 82,
      "location": 2,
      "content": "差不多是保证你的小臂",
      "music": 0.0
    },
    {
      "from": 185.56,
      "to": 187.99,
      "sid": 83,
      "location": 2,
      "content": "是基本上接近于垂直地面的",
      "music": 0.0
    },
    {
      "from": 187.99,
      "to": 191.2,
      "sid": 84,
      "location": 2,
      "content": "也就是说我们衡量的方式可以是这样的啊",
      "music": 0.0
    },
    {
      "from": 191.2,
      "to": 192.91,
      "sid": 85,
      "location": 2,
      "content": "差不多在这个角度的时候呢",
      "music": 0.0
    },
    {
      "from": 192.91,
      "to": 195.54,
      "sid": 86,
      "location": 2,
      "content": "上臂和小臂的夹角在90度",
      "music": 0.0
    },
    {
      "from": 195.54,
      "to": 198.35,
      "sid": 87,
      "location": 2,
      "content": "而再向上抬高一半的作用啊",
      "music": 0.0
    },
    {
      "from": 198.35,
      "to": 199.8,
      "sid": 88,
      "location": 2,
      "content": "大家一定要注意到",
      "music": 0.0
    },
    {
      "from": 199.8,
      "to": 201.18,
      "sid": 89,
      "location": 2,
      "content": "这是接近于直角啊",
      "music": 0.0
    },
    {
      "from": 201.18,
      "to": 202.56,
      "sid": 90,
      "location": 2,
      "content": "也不是完全垂直的",
      "music": 0.0
    },
    {
      "from": 202.56,
      "to": 203.64,
      "sid": 91,
      "location": 2,
      "content": "因为我们可以想象一下",
      "music": 0.0
    },
    {
      "from": 203.64,
      "to": 206.6,
      "sid": 92,
      "location": 2,
      "content": "如果我们把手臂小臂保持垂直地面的话",
      "music": 0.0
    },
    {
      "from": 206.6,
      "to": 208.28,
      "sid": 93,
      "location": 2,
      "content": "或者是再向后会怎么样呢",
      "music": 0.0
    },
    {
      "from": 208.28,
      "to": 209.0,
      "sid": 94,
      "location": 2,
      "content": "其实这个时候",
      "music": 0.0
    },
    {
      "from": 209.0,
      "to": 211.81,
      "sid": 95,
      "location": 2,
      "content": "肱二头肌已经是完全放松的状态了啊",
      "music": 0.0
    },
    {
      "from": 211.81,
      "to": 215.06,
      "sid": 96,
      "location": 2,
      "content": "那么这个时候呢肌肉的张力就会减少啊",
      "music": 0.0
    },
    {
      "from": 216.98,
      "to": 219.2,
      "sid": 97,
      "location": 2,
      "content": "所以说我们在训练的过程当中呢",
      "music": 0.0
    },
    {
      "from": 219.2,
      "to": 220.16,
      "sid": 98,
      "location": 2,
      "content": "轨迹很重要啊",
      "music": 0.0
    },
    {
      "from": 220.16,
      "to": 222.2,
      "sid": 99,
      "location": 2,
      "content": "但是呢控制要比轨迹更重要",
      "music": 0.0
    },
    {
      "from": 222.2,
      "to": 223.7,
      "sid": 100,
      "location": 2,
      "content": "因为这个动作本身呢是一个",
      "music": 0.0
    },
    {
      "from": 223.7,
      "to": 226.52,
      "sid": 101,
      "location": 2,
      "content": "更偏向于单关节主导的孤立动作",
      "music": 0.0
    },
    {
      "from": 226.52,
      "to": 228.44,
      "sid": 102,
      "location": 2,
      "content": "所以说在训练的轨迹方面",
      "music": 0.0
    },
    {
      "from": 228.44,
      "to": 230.21,
      "sid": 103,
      "location": 2,
      "content": "并不会产生太大的问题啊",
      "music": 0.0
    },
    {
      "from": 230.21,
      "to": 232.7,
      "sid": 104,
      "location": 2,
      "content": "容易产生的问题主要出现在哪里呢",
      "music": 0.0
    },
    {
      "from": 232.7,
      "to": 235.06,
      "sid": 105,
      "location": 2,
      "content": "接下来我们就来一个一个了解一下",
      "music": 0.0
    },
    {
      "from": 235.06,
      "to": 236.44,
