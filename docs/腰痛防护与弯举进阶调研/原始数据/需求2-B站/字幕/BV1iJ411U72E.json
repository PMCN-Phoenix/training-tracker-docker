      "location": 2,
      "content": "膝盖微微自然弯曲",
      "music": 0.0
    },
    {
      "from": 190.349,
      "to": 191.96,
      "sid": 52,
      "location": 2,
      "content": "保持身体的稳定",
      "music": 0.0
    },
    {
      "from": 195.24,
      "to": 195.74,
      "sid": 53,
      "location": 2,
      "content": "啊",
      "music": 0.0
    },
    {
      "from": 197.96,
      "to": 200.86,
