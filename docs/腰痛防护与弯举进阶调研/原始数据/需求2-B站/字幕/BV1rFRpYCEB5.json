{
  "font_size": 0.4,
  "font_color": "#FFFFFF",
  "background_alpha": 0.5,
  "background_color": "#9C27B0",
  "Stroke": "none",
  "type": "AIsubtitle",
  "lang": "zh",
  "version": "v1.7.0.4",
  "body": [
    {
      "from": 0.12,
      "to": 2.2,
      "sid": 1,
      "location": 2,
      "content": "增加重量还是增加重复次数",
      "music": 0.0
    },
    {
      "from": 2.2,
      "to": 4.92,
      "sid": 2,
      "location": 2,
      "content": "哪种渐进超负荷方法更有利于肌肉增长",
      "music": 0.0
    },
    {
      "from": 4.92,
      "to": 7.26,
      "sid": 3,
      "location": 2,
      "content": "训练中怎样应用可以实现持续进步",
      "music": 0.0
    },
    {
      "from": 7.26,
      "to": 8.0,
      "sid": 4,
      "location": 2,
      "content": "2024年",
      "music": 0.0
    },
    {
      "from": 8.0,
      "to": 9.8,
      "sid": 5,
      "location": 2,
      "content": "一项研究对比了这两种方法",
      "music": 0.0
    },
    {
      "from": 9.8,
      "to": 12.36,
      "sid": 6,
      "location": 2,
      "content": "招募了39名没有训练经验的受试者",
      "music": 0.0
    },
    {
      "from": 12.36,
      "to": 14.42,
      "sid": 7,
      "location": 2,
      "content": "让他们进行单腿腿屈伸训练",
      "music": 0.0
    },
    {
      "from": 14.42,
      "to": 16.26,
      "sid": 8,
      "location": 2,
      "content": "一条腿在训练时增加重量",
      "music": 0.0
    },
    {
      "from": 16.26,
      "to": 18.64,
      "sid": 9,
      "location": 2,
      "content": "把重复次数控制在9~12次",
      "music": 0.0
    },
    {
      "from": 18.64,
      "to": 19.76,
      "sid": 10,
      "location": 2,
      "content": "每组做到力竭",
      "music": 0.0
    },
    {
      "from": 19.76,
      "to": 21.6,
      "sid": 11,
      "location": 2,
      "content": "另一条腿则保持重量不变",
      "music": 0.0
    },
    {
      "from": 21.6,
      "to": 24.46,
      "sid": 12,
      "location": 2,
      "content": "重复次数从每组九次增加到15次",
      "music": 0.0
    },
    {
      "from": 24.46,
      "to": 25.86,
      "sid": 13,
      "location": 2,
      "content": "同样每组做到力竭",
      "music": 0.0
    },
    {
      "from": 25.86,
      "to": 27.44,
      "sid": 14,
      "location": 2,
      "content": "这种方式避免了遗传",
      "music": 0.0
    },
    {
      "from": 27.44,
      "to": 30.14,
      "sid": 15,
      "location": 2,
      "content": "营养以及生活方式对研究结果的影响",
      "music": 0.0
    },
    {
      "from": 30.14,
      "to": 31.12,
      "sid": 16,
      "location": 2,
      "content": "十周后发现",
      "music": 0.0
    },
    {
      "from": 31.12,
      "to": 33.7,
      "sid": 17,
      "location": 2,
      "content": "两种方法在力量方面的增长基本相似",
      "music": 0.0
    },
    {
      "from": 33.7,
      "to": 36.18,
      "sid": 18,
      "location": 2,
      "content": "从外侧股四头肌的增长情况来看",
      "music": 0.0
    },
    {
      "from": 36.18,
      "to": 37.74,
      "sid": 19,
      "location": 2,
      "content": "肌肉增长也没有显著差异",
      "music": 0.0
    },
    {
      "from": 37.74,
      "to": 39.18,
      "sid": 20,
      "location": 2,
      "content": "有些兄弟也许会说",
      "music": 0.0
    },
    {
      "from": 39.18,
      "to": 40.82,
      "sid": 21,
      "location": 2,
      "content": "新手怎么练都会苦苦长",
      "music": 0.0
    },
    {
      "from": 40.82,
      "to": 41.64,
      "sid": 22,
      "location": 2,
      "content": "2022年",
      "music": 0.0
    },
    {
      "from": 41.64,
      "to": 43.02,
      "sid": 23,
      "location": 2,
      "content": "还有一项类似研究",
      "music": 0.0
    },
    {
      "from": 43.02,
      "to": 46.52,
      "sid": 24,
      "location": 2,
      "content": "让38名有训练经验的参与者进行下肢训练",
      "music": 0.0
    },
    {
      "from": 46.52,
      "to": 48.8,
      "sid": 25,
      "location": 2,
      "content": "一组人在训练期间不断增加重量",
      "music": 0.0
    },
    {
      "from": 48.8,
      "to": 50.96,
      "sid": 26,
      "location": 2,
      "content": "把重复次数控制在8~12次",
      "music": 0.0
    },
    {
      "from": 50.96,
      "to": 52.64,
      "sid": 27,
      "location": 2,
      "content": "另一组人则保持重量不变",
      "music": 0.0
    },
    {
      "from": 52.64,
      "to": 54.48,
      "sid": 28,
      "location": 2,
      "content": "专注于增加重复次数",
      "music": 0.0
    },
    {
      "from": 54.48,
      "to": 55.2,
      "sid": 29,
      "location": 2,
      "content": "结果发现",
      "music": 0.0
    },
    {
      "from": 55.2,
      "to": 58.56,
      "sid": 30,
      "location": 2,
      "content": "两组人的股四头肌和小腿肌肉增长情况相似四",
      "music": 0.0
    },
    {
      "from": 58.56,
      "to": 61.04,
      "sid": 31,
      "location": 2,
      "content": "所以无论是新手还是有经验的训练者",
      "music": 0.0
    },
    {
      "from": 61.04,
      "to": 62.98,
      "sid": 32,
      "location": 2,
      "content": "通过增加重量或重复次数",
      "music": 0.0
    },
    {
      "from": 62.98,
      "to": 65.26,
      "sid": 33,
      "location": 2,
      "content": "都可以实现相同的增肌目标",
      "music": 0.0
    },
    {
      "from": 65.26,
      "to": 67.9,
      "sid": 34,
      "location": 2,
      "content": "这是因为渐进性超负荷的核心原理在于",
      "music": 0.0
    },
    {
      "from": 67.9,
      "to": 69.98,
      "sid": 35,
      "location": 2,
      "content": "促使肌肉适应不断变化的刺激",
      "music": 0.0
    },
    {
      "from": 69.98,
      "to": 73.08,
      "sid": 36,
      "location": 2,
      "content": "让肌肉肉纤维募集和肌肉张力维持在较高水平",
      "music": 0.0
    },
    {
      "from": 73.08,
      "to": 75.84,
      "sid": 37,
      "location": 2,
      "content": "进而引发新的肌肉生长或力量提升",
      "music": 0.0
    },
    {
      "from": 75.84,
      "to": 78.02,
      "sid": 38,
      "location": 2,
      "content": "所以只要能够保持训练强度",
      "music": 0.0
    },
    {
      "from": 78.02,
      "to": 79.94,
      "sid": 39,
      "location": 2,
      "content": "增加重量或者重复次数",
      "music": 0.0
    },
    {
      "from": 79.94,
      "to": 81.7,
      "sid": 40,
      "location": 2,
      "content": "都能有效刺激肌肉生长",
      "music": 0.0
    },
    {
      "from": 81.7,
      "to": 83.8,
      "sid": 41,
      "location": 2,
      "content": "而增加训练组数或训练频率",
      "music": 0.0
    },
    {
      "from": 83.8,
      "to": 86.02,
      "sid": 42,
      "location": 2,
      "content": "并不一定等同于渐进性超负荷",
      "music": 0.0
    },
    {
      "from": 86.02,
      "to": 87.54,
      "sid": 43,
      "location": 2,
      "content": "一味的增加总训练容量",
      "music": 0.0
    },
    {
      "from": 87.54,
      "to": 89.7,
      "sid": 44,
      "location": 2,
      "content": "会让身体产生适应性变化",
      "music": 0.0
    },
    {
      "from": 89.7,
      "to": 91.64,
      "sid": 45,
      "location": 2,
      "content": "无法达到高强度训练的效果",
      "music": 0.0
    },
    {
      "from": 91.64,
      "to": 93.1,
      "sid": 46,
      "location": 2,
      "content": "还可能导致恢复问题",
      "music": 0.0
    },
    {
      "from": 93.1,
      "to": 93.9,
      "sid": 47,
      "location": 2,
      "content": "需要注意的是",
      "music": 0.0
    },
    {
      "from": 93.9,
      "to": 94.68,
      "sid": 48,
      "location": 2,
      "content": "研究表明",
      "music": 0.0
    },
    {
      "from": 94.68,
      "to": 97.72,
      "sid": 49,
      "location": 2,
      "content": "每组重复次数在6~35次范围内",
      "music": 0.0
    },
    {
      "from": 97.72,
      "to": 98.6,
      "sid": 50,
      "location": 2,
      "content": "做到力竭时",
      "music": 0.0
    },
    {
      "from": 98.6,
      "to": 100.34,
      "sid": 51,
      "location": 2,
      "content": "促进肌肉增长的效果相似",
      "music": 0.0
    },
    {
      "from": 100.34,
      "to": 102.82,
      "sid": 52,
      "location": 2,
      "content": "但如果重复次数少于六次",
      "music": 0.0
    },
    {
      "from": 102.82,
      "to": 105.28,
      "sid": 53,
      "location": 2,
      "content": "肌肉在高张力状态下的时间过短",
      "music": 0.0
    },
    {
      "from": 105.28,
      "to": 106.66,
      "sid": 54,
      "location": 2,
      "content": "更适合用来提升力量",
      "music": 0.0
    },
    {
      "from": 106.66,
      "to": 109.2,
      "sid": 55,
      "location": 2,
      "content": "超过35次则容易导致过度疲劳",
      "music": 0.0
    },
    {
      "from": 109.2,
      "to": 110.38,
      "sid": 56,
      "location": 2,
      "content": "所以从长远来看",
      "music": 0.0
    },
    {
      "from": 110.38,
      "to": 113.52,
      "sid": 57,
      "location": 2,
      "content": "科学的渐进方法是同时应用重量和重复次数",
      "music": 0.0
    },
    {
      "from": 113.52,
      "to": 114.6,
      "sid": 58,
      "location": 2,
      "content": "交替进行增加",
      "music": 0.0
    },
    {
      "from": 114.6,
      "to": 117.22,
      "sid": 59,
      "location": 2,
      "content": "如果你正在进行四组8~12次的训练",
      "music": 0.0
    },
    {
      "from": 117.22,
      "to": 118.48,
      "sid": 60,
      "location": 2,
      "content": "使用的当前训练重量",
      "music": 0.0
    },
    {
      "from": 118.48,
      "to": 120.2,
      "sid": 61,
      "location": 2,
      "content": "每组在八次就达到力竭状态",
      "music": 0.0
    },
    {
      "from": 120.2,
      "to": 122.38,
      "sid": 62,
      "location": 2,
      "content": "那就可以优先考虑增加重复次数",
      "music": 0.0
    },
    {
      "from": 122.38,
      "to": 124.98,
      "sid": 63,
      "location": 2,
      "content": "当每组都能轻松完成12次重复时",
      "music": 0.0
    },
    {
      "from": 124.98,
      "to": 126.18,
      "sid": 64,
      "location": 2,
      "content": "再加训练重量",
      "music": 0.0
    },
    {
      "from": 126.18,
      "to": 127.9,
      "sid": 65,
      "location": 2,
      "content": "增加重量时不要太激进",
      "music": 0.0
    },
    {
      "from": 127.9,
      "to": 130.74,
      "sid": 66,
      "location": 2,
      "content": "理想的递增范围是在上一次基础上增加",
      "music": 0.0
    },
    {
      "from": 130.74,
      "to": 131.94,
      "sid": 67,
      "location": 2,
      "content": "5%到10%",
      "music": 0.0
    },
    {
      "from": 131.94,
      "to": 132.9,
      "sid": 68,
      "location": 2,
      "content": "通过这种方式",
      "music": 0.0
    },
    {
      "from": 132.9,
      "to": 135.88,
      "sid": 69,
      "location": 2,
      "content": "既能让你保持在理想的重复次数区间",
      "music": 0.0
    },
    {
      "from": 135.88,
      "to": 138.72,
      "sid": 70,
      "location": 2,
      "content": "又能完美实现渐进性超负荷训练",
      "music": 0.0
    },
    {
      "from": 138.72,
      "to": 140.22,
      "sid": 71,
      "location": 2,
      "content": "稳步提升训练效果",
      "music": 0.0
    }
  ]
}