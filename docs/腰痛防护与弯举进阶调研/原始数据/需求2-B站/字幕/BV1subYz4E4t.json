{
  "font_size": 0.4,
  "font_color": "#FFFFFF",
  "background_alpha": 0.5,
  "background_color": "#9C27B0",
  "Stroke": "none",
  "type": "AIsubtitle",
  "lang": "zh",
  "version": "v1.7.0.4",
  "body": [
    {
      "from": 0.04,
      "to": 2.4,
      "sid": 1,
      "location": 2,
      "content": "兄弟们练二头不需要花里胡哨的动作",
      "music": 0.0
    },
    {
      "from": 2.4,
      "to": 4.1,
      "sid": 2,
      "location": 2,
      "content": "这里介绍十个练二头的动作",
      "music": 0.0
    },
    {
      "from": 4.1,
      "to": 5.16,
      "sid": 3,
      "location": 2,
      "content": "从最差到最好",
      "music": 0.0
    },
    {
      "from": 5.16,
      "to": 5.98,
      "sid": 4,
      "location": 2,
      "content": "做了一个排名",
      "music": 0.0
    },
    {
      "from": 5.98,
      "to": 8.28,
      "sid": 5,
      "location": 2,
      "content": "学会你也能拥有一对硕大的麒麟臂",
      "music": 0.0
    },
    {
      "from": 8.28,
      "to": 9.36,
      "sid": 6,
      "location": 2,
      "content": "排名第十的动作",
      "music": 0.0
    },
    {
      "from": 9.36,
      "to": 10.54,
      "sid": 7,
      "location": 2,
      "content": "正手杠杆弯举",
      "music": 0.0
    },
    {
      "from": 10.54,
      "to": 11.92,
      "sid": 8,
      "location": 2,
      "content": "这个动作虽然是弯举啊",
      "music": 0.0
    },
    {
      "from": 11.92,
      "to": 13.88,
      "sid": 9,
      "location": 2,
      "content": "但是我不建议大家用来练二头",
      "music": 0.0
    },
    {
      "from": 13.88,
      "to": 16.24,
      "sid": 10,
      "location": 2,
      "content": "要知道能精准刺激二头的弯举动作",
      "music": 0.0
    },
    {
      "from": 16.24,
      "to": 17.48,
      "sid": 11,
      "location": 2,
      "content": "有一个关键的前提",
      "music": 0.0
    },
    {
      "from": 17.48,
      "to": 19.8,
      "sid": 12,
      "location": 2,
      "content": "那就是手心朝向自己的同时呢",
      "music": 0.0
    },
    {
      "from": 19.8,
      "to": 20.98,
      "sid": 13,
      "location": 2,
      "content": "小臂朝外打开",
      "music": 0.0
    },
    {
      "from": 20.98,
      "to": 23.78,
      "sid": 14,
      "location": 2,
      "content": "这样才能让二头肌的肌纤维充分参与发力",
      "music": 0.0
    },
    {
      "from": 23.78,
      "to": 25.02,
      "sid": 15,
      "location": 2,
      "content": "而正手杠杆弯曲",
      "music": 0.0
    },
    {
      "from": 25.02,
      "to": 26.18,
      "sid": 16,
      "location": 2,
      "content": "手心是朝下的",
      "music": 0.0
    },
    {
      "from": 26.18,
      "to": 27.94,
      "sid": 17,
      "location": 2,
      "content": "发力时小臂会向内旋转",
      "music": 0.0
    },
    {
      "from": 27.94,
      "to": 30.82,
      "sid": 18,
      "location": 2,
      "content": "这样就会更偏向训练我们的攻击和肱桡肌",
      "music": 0.0
    },
    {
      "from": 30.82,
      "to": 33.34,
      "sid": 19,
      "location": 2,
      "content": "二头的收益会减少50%都不止",
      "music": 0.0
    },
    {
      "from": 33.34,
      "to": 35.7,
      "sid": 20,
      "location": 2,
      "content": "但要是想刺激攻击和肱桡肌的兄弟啊",
      "music": 0.0
    },
    {
      "from": 35.7,
      "to": 37.46,
      "sid": 21,
      "location": 2,
      "content": "这个动作反倒是个不错的选择",
      "music": 0.0
    },
    {
      "from": 37.46,
      "to": 38.56,
      "sid": 22,
      "location": 2,
      "content": "排名第九的动作",
      "music": 0.0
    },
    {
      "from": 38.56,
      "to": 39.42,
      "sid": 23,
      "location": 2,
      "content": "杠铃片弯举",
      "music": 0.0
    },
    {
      "from": 39.42,
      "to": 40.6,
      "sid": 24,
      "location": 2,
      "content": "这种鸡肋的动作",
      "music": 0.0
    },
    {
      "from": 40.6,
      "to": 42.22,
      "sid": 25,
      "location": 2,
      "content": "咱们在健身房碰都不要碰",
      "music": 0.0
    },
    {
      "from": 42.22,
      "to": 44.36,
      "sid": 26,
      "location": 2,
      "content": "因为这个动作其实是练我们攻击的",
      "music": 0.0
    },
    {
      "from": 44.36,
      "to": 45.92,
      "sid": 27,
      "location": 2,
      "content": "就是大臂侧面那块肌肉",
      "music": 0.0
    },
    {
      "from": 45.92,
      "to": 47.04,
      "sid": 28,
      "location": 2,
      "content": "对我们二头的刺激",
      "music": 0.0
    },
    {
      "from": 47.04,
      "to": 48.24,
      "sid": 29,
      "location": 2,
      "content": "那是1/3都没有",
      "music": 0.0
    },
    {
      "from": 48.24,
      "to": 49.18,
      "sid": 30,
      "location": 2,
      "content": "咱们新手练二头",
      "music": 0.0
    },
    {
      "from": 49.18,
      "to": 51.1,
      "sid": 31,
      "location": 2,
      "content": "首先要考虑的是整体的维度",
      "music": 0.0
    },
    {
      "from": 51.1,
      "to": 52.92,
      "sid": 32,
      "location": 2,
      "content": "只盯着这一小块肌肉死磕",
      "music": 0.0
    },
    {
      "from": 52.92,
      "to": 54.38,
      "sid": 33,
      "location": 2,
      "content": "就算把他练的再突出",
      "music": 0.0
    },
    {
      "from": 54.38,
      "to": 55.5,
      "sid": 34,
      "location": 2,
      "content": "你二头不饱满",
      "music": 0.0
    },
    {
      "from": 55.5,
      "to": 56.74,
      "sid": 35,
      "location": 2,
      "content": "也很难被人注意到",
      "music": 0.0
    },
    {
      "from": 56.74,
      "to": 59.36,
      "sid": 36,
      "location": 2,
      "content": "所以新手要做的首先是要把肉量堆起来",
      "music": 0.0
    },
    {
      "from": 59.36,
      "to": 62.52,
      "sid": 37,
      "location": 2,
      "content": "等你哪天能轻松用50kg的杠铃弯举做足了",
      "music": 0.0
    },
    {
      "from": 62.52,
      "to": 63.66,
      "sid": 38,
      "location": 2,
      "content": "再来练它也不迟",
      "music": 0.0
    },
    {
      "from": 63.66,
      "to": 65.88,
      "sid": 39,
      "location": 2,
      "content": "现阶段没必要在这上面浪费时间",
      "music": 0.0
    },
    {
      "from": 65.88,
      "to": 66.94,
      "sid": 40,
      "location": 2,
      "content": "排名第八的动作",
      "music": 0.0
    },
    {
      "from": 66.94,
      "to": 67.66,
      "sid": 41,
      "location": 2,
      "content": "锤式弯举",
      "music": 0.0
    },
    {
      "from": 67.66,
      "to": 69.28,
      "sid": 42,
      "location": 2,
      "content": "这个动作以练攻击为主",
      "music": 0.0
    },
    {
      "from": 69.28,
      "to": 70.88,
      "sid": 43,
      "location": 2,
      "content": "顺带也能刺激到我们二头",
      "music": 0.0
    },
    {
      "from": 70.88,
      "to": 72.42,
      "sid": 44,
      "location": 2,
      "content": "但我在健身房观察过",
      "music": 0.0
    },
    {
      "from": 72.42,
      "to": 74.42,
      "sid": 45,
      "location": 2,
      "content": "很多人做这个动作都做不标准",
      "music": 0.0
    },
    {
      "from": 74.42,
      "to": 75.78,
      "sid": 46,
      "location": 2,
      "content": "单纯就是靠小臂发力",
      "music": 0.0
    },
    {
      "from": 75.78,
      "to": 76.74,
      "sid": 47,
      "location": 2,
      "content": "把哑铃举了起来",
      "music": 0.0
    },
    {
      "from": 76.74,
      "to": 77.58,
      "sid": 48,
      "location": 2,
      "content": "别说二头了",
      "music": 0.0
    },
    {
      "from": 77.58,
      "to": 79.1,
      "sid": 49,
      "location": 2,
      "content": "连攻击都没有参与进来",
      "music": 0.0
    },
    {
      "from": 79.1,
      "to": 80.02,
      "sid": 50,
      "location": 2,
      "content": "纯纯的是瞎搞",
      "music": 0.0
    },
    {
      "from": 80.02,
      "to": 82.94,
      "sid": 51,
      "location": 2,
      "content": "所以做这个动作的正确方法是大臂要保持不动",
      "music": 0.0
    },
    {
      "from": 82.94,
      "to": 83.82,
      "sid": 52,
      "location": 2,
      "content": "抬起哑铃时",
      "music": 0.0
    },
    {
      "from": 83.82,
      "to": 85.7,
      "sid": 53,
      "location": 2,
      "content": "记得让小臂碰到二头肌弯",
      "music": 0.0
    },
    {
      "from": 85.7,
      "to": 87.28,
      "sid": 54,
      "location": 2,
      "content": "举起来时记得顶峰收缩",
      "music": 0.0
    },
    {
      "from": 87.28,
      "to": 89.1,
      "sid": 55,
      "location": 2,
      "content": "这样攻击和二头才能受力",
      "music": 0.0
    },
    {
      "from": 89.1,
      "to": 91.38,
      "sid": 56,
      "location": 2,
      "content": "但毕竟这个动作对我们的二头作用不大",
      "music": 0.0
    },
    {
      "from": 91.38,
      "to": 92.7,
      "sid": 57,
      "location": 2,
      "content": "没必要主攻这个动作",
      "music": 0.0
    },
    {
      "from": 92.7,
      "to": 95.66,
      "sid": 58,
      "location": 2,
      "content": "只建议在做哑铃弯举的最后来几下就可以了",
      "music": 0.0
    },
    {
      "from": 95.66,
      "to": 96.7,
      "sid": 59,
      "location": 2,
      "content": "排名第七的动作",
      "music": 0.0
    },
    {
      "from": 96.7,
      "to": 97.5,
      "sid": 60,
      "location": 2,
      "content": "蜘蛛弯举",
      "music": 0.0
    },
    {
      "from": 97.5,
      "to": 99.26,
      "sid": 61,
      "location": 2,
      "content": "这个动作顶峰收缩确实牛",
      "music": 0.0
    },
    {
      "from": 99.26,
      "to": 101.02,
      "sid": 62,
      "location": 2,
      "content": "但是当哑铃下放到最低点",
      "music": 0.0
    },
    {
      "from": 101.02,
      "to": 103.14,
      "sid": 63,
      "location": 2,
      "content": "二就感受不到任何的负荷重量",
      "music": 0.0
    },
    {
      "from": 103.14,
      "to": 105.26,
      "sid": 64,
      "location": 2,
      "content": "要知道咱们练二头拉伸和收缩",
      "music": 0.0
    },
    {
      "from": 105.26,
      "to": 106.38,
      "sid": 65,
      "location": 2,
      "content": "那是同等重要的",
      "music": 0.0
    },
    {
      "from": 106.38,
      "to": 107.74,
      "sid": 66,
      "location": 2,
      "content": "尤其是当我们拉伸的时候",
      "music": 0.0
    },
    {
      "from": 107.74,
      "to": 109.76,
      "sid": 67,
      "location": 2,
      "content": "那肌纤维的撕裂效率是最高的",
      "music": 0.0
    },
    {
      "from": 109.76,
      "to": 111.78,
      "sid": 68,
      "location": 2,
      "content": "这个动作光靠拉起来的收缩感啊",
      "music": 0.0
    },
    {
      "from": 111.78,
      "to": 114.76,
      "sid": 69,
      "location": 2,
      "content": "却没有了最能促进肌纤维生长的拉伸阶段",
      "music": 0.0
    },
    {
      "from": 114.76,
      "to": 116.52,
      "sid": 70,
      "location": 2,
      "content": "这样对二头的刺激不够全面",
      "music": 0.0
    },
    {
      "from": 116.52,
      "to": 118.6,
      "sid": 71,
      "location": 2,
      "content": "增肌效果自然也是大打折扣",
      "music": 0.0
    },
    {
      "from": 118.6,
      "to": 120.84,
      "sid": 72,
      "location": 2,
      "content": "所以以后要是遇到像这种拉伸环节",
      "music": 0.0
    },
    {
      "from": 120.84,
      "to": 121.84,
      "sid": 73,
      "location": 2,
      "content": "效率不高的动作",
      "music": 0.0
    },
    {
      "from": 121.84,
      "to": 123.2,
      "sid": 74,
      "location": 2,
      "content": "基本可以直接淘汰了",
      "music": 0.0
    },
    {
      "from": 123.2,
      "to": 124.28,
      "sid": 75,
      "location": 2,
      "content": "排名第六的动作",
      "music": 0.0
    },
    {
      "from": 124.28,
      "to": 125.44,
      "sid": 76,
      "location": 2,
      "content": "蹲姿的绳索弯举",
      "music": 0.0
    },
    {
      "from": 125.44,
      "to": 126.9,
      "sid": 77,
      "location": 2,
      "content": "这个动作本身是挺好的",
      "music": 0.0
    },
    {
      "from": 126.9,
      "to": 129.54,
      "sid": 78,
      "location": 2,
      "content": "毕竟绳索的持续张力能让肌肉一直受力",
      "music": 0.0
    },
    {
      "from": 129.54,
      "to": 131.38,
      "sid": 79,
      "location": 2,
      "content": "但可惜的是对新手不太友好",
      "music": 0.0
    },
    {
      "from": 131.38,
      "to": 133.26,
      "sid": 80,
      "location": 2,
      "content": "因为新手本身力量就不够",
      "music": 0.0
    },
    {
      "from": 133.26,
      "to": 134.56,
      "sid": 81,
      "location": 2,
      "content": "身体核心也稳不住",
      "music": 0.0
    },
    {
      "from": 134.56,
      "to": 135.58,
      "sid": 82,
      "location": 2,
      "content": "拉绳索的时候呢",
      "music": 0.0
    },
    {
      "from": 135.58,
      "to": 137.42,
      "sid": 83,
      "location": 2,
      "content": "精力全都用在维持平衡上了",
      "music": 0.0
    },
    {
      "from": 137.42,
      "to": 139.42,
      "sid": 84,
      "location": 2,
      "content": "注意怎么能全部集中到二头呢",
      "music": 0.0
    },
    {
      "from": 139.42,
      "to": 141.46,
      "sid": 85,
      "location": 2,
      "content": "而且这个动作一旦上点大重量了",
      "music": 0.0
    },
    {
      "from": 141.46,
      "to": 143.06,
      "sid": 86,
      "location": 2,
      "content": "就不是你主动在拉绳索了",
      "music": 0.0
    },
    {
      "from": 143.06,
      "to": 144.52,
      "sid": 87,
      "location": 2,
      "content": "反倒是绳索在拉你了",
      "music": 0.0
    },
    {
      "from": 144.52,
      "to": 146.42,
      "sid": 88,
      "location": 2,
      "content": "等后期你核心足够稳定呢",
      "music": 0.0
    },
    {
      "from": 146.42,
      "to": 149.06,
      "sid": 89,
      "location": 2,
      "content": "能将更多的注意力集中到二头肌的收缩上",
      "music": 0.0
    },
    {
      "from": 149.06,
      "to": 150.46,
      "sid": 90,
      "location": 2,
      "content": "这个动作你就放心练吧",
      "music": 0.0
    },
    {
      "from": 150.46,
      "to": 151.54,
      "sid": 91,
      "location": 2,
      "content": "排名第五的动作",
      "music": 0.0
    },
    {
      "from": 151.54,
      "to": 152.68,
      "sid": 92,
      "location": 2,
      "content": "上斜的哑铃弯举",
      "music": 0.0
    },
    {
      "from": 152.68,
      "to": 154.44,
      "sid": 93,
      "location": 2,
      "content": "这个动作跟蜘蛛弯举很像",
      "music": 0.0
    },
    {
      "from": 154.44,
      "to": 156.12,
      "sid": 94,
      "location": 2,
      "content": "对二头的拉伸效果非常好",
      "music": 0.0
    },
    {
      "from": 156.12,
      "to": 157.46,
      "sid": 95,
      "location": 2,
      "content": "哑铃弯举到顶点",
      "music": 0.0
    },
    {
      "from": 157.46,
      "to": 158.92,
      "sid": 96,
      "location": 2,
      "content": "二头肌的泵感很炸裂",
      "music": 0.0
    },
    {
      "from": 158.92,
      "to": 160.86,
      "sid": 97,
      "location": 2,
      "content": "但是哑铃慢慢放下来的过程中",
      "music": 0.0
    },
    {
      "from": 160.86,
      "to": 162.48,
      "sid": 98,
      "location": 2,
      "content": "二头的受力会逐渐减弱",
      "music": 0.0
    },
    {
      "from": 162.48,
      "to": 164.2,
      "sid": 99,
      "location": 2,
      "content": "没有收缩阶段那么明显",
      "music": 0.0
    },
    {
      "from": 164.2,
      "to": 166.06,
      "sid": 100,
      "location": 2,
      "content": "不过毕竟他的运动行程很长",
      "music": 0.0
    },
    {
      "from": 166.06,
      "to": 168.04,
      "sid": 101,
      "location": 2,
      "content": "二头有大半的时间都在发力",
      "music": 0.0
    },
    {
      "from": 168.04,
      "to": 170.64,
      "sid": 102,
      "location": 2,
      "content": "所以这个动作可以放到大重量的弯举之后做",
      "music": 0.0
    },
    {
      "from": 170.64,
      "to": 171.98,
      "sid": 103,
      "location": 2,
      "content": "用中等重量做组",
      "music": 0.0
    },
    {
      "from": 171.98,
      "to": 173.54,
      "sid": 104,
      "location": 2,
      "content": "彻底榨干二头的糖原",
      "music": 0.0
    },
    {
      "from": 173.54,
      "to": 174.62,
      "sid": 105,
      "location": 2,
      "content": "排名第四的动作",
      "music": 0.0
    },
    {
      "from": 174.62,
      "to": 175.32,
      "sid": 106,
      "location": 2,
      "content": "集中弯举",
      "music": 0.0
    },
    {
      "from": 175.32,
      "to": 176.92,
      "sid": 107,
      "location": 2,
      "content": "这是最常见的二头动作",
      "music": 0.0
